     "a:not(.chapter-thumbnail):not(.chapter-thumbnail a)@href",
     "a@href"
    ],
    "name": [
     ".tuhaf-ch-name",
     "div.grid > span",
     "a:not(.chapter-thumbnail):not(.chapter-thumbnail a)",
     "a"
    ],
    "date": [
     "img:not(.thumb)@alt",
     "span a@title",
     "span.chapter-release-date",
     "span.chapter-release-date"
    ]
   },
   "date_format": [
    "dd/MM/yyyy",
    "relative"
   ],
   "date_locale": "en",
   "request": {
    "url": "{base}{u.path}/ajax/chapters/?t={page}",
    "method": "POST",
    "headers": {
     "X-Requested-With": "XMLHttpRequest"
    },
    "form": {}
   },
   "request_by_page": {
    "1": {
     "url": "{base}{u.path}/ajax/chapters/",
     "method": "POST",
     "headers": {
      "X-Requested-With": "XMLHttpRequest"
     },
     "form": {}
    }
   },
   "paging": {
    "has_next": {
     "exists": "div.pagination span.current ~ span.page a[data-page]"
    },
    "max_pages": 200
   }
  },
  "pages": {
   "request": "{abs_url}?style=list",
   "let": {
    "kscript": [
     {
      "path": "*:has(> script#chapter-protector-data)@html",
      "regex": "<script(?=[^>]*\\bid=[\"']chapter-protector-data[\"'])[^>]*\\bsrc=[\"']data:[^,\"']*;base64,([^\"']+)[\"']",
      "decode": "base64"
     },
     {
      "path": "script#chapter-protector-data@html"
     }
    ],
    "kpw": {
     "const": "{l.kscript}",
     "regex": "wpmangaprotectornonce='([^']*)'"
    }
   },
   "inner": {
    "value": {
     "const": "{l.kscript}",
     "regex": "chapter_data='(.*?)';",
     "replace": [
      [
       "\\\\/",
       "/"
      ]
     ],
     "decode": "aes_cryptojs",
     "key": "{l.kpw}"
    },
    "format": "json",
    "items": "$",
    "image": ""
   },
   "items": [
    "div.page-break, li.blocks-gallery-item",
    "div.page-break img, li.blocks-gallery-item img, .reading-content .text-left img, div.read-content img",
    "div.reading-content img.wp-manga-chapter-img",
    ".reading-content div.text-center > p > img, .reading-content div.text-center > center > img",
    "canvas[data-page-url]",
    ".reading-content p img:not(.aligncenter):not(.content-blocked img):not(.login-required img)",
    ".reading-content div.text-center > img, .reading-content div.text-center > script"
   ],
   "image": [
    "img@img",
    "@img",
    "@data-page-url",
    {
     "path": "@html",
     "pre_decode": "packer",
     "regex": "<img src='([^']+)'"
    }
   ],
   "referer": "chapter",
   "transform": {
    "path": "@html",
    "pre_decode": "packer",
    "regex": "(?s)sovleImage=(\\[\\[.*?\\]\\]);.*?width:\\s*\"?\\s*\\+?\\s*(\\d+)\\s*\\+?\\s*\"?px;.*?height:\\s*\"?\\s*\\+?\\s*(\\d+)\\s*\\+?\\s*\"?px;",
    "template": "{\"type\":\"rects\",\"w\":{g2},\"h\":{g3},\"moves\":{g1}}"
   }
  },
  "origin": "baukasten:madara {\"apex\": \"lectortaurus.com\", \"chapter_mode\": \"ajax\", \"date_format\": \"dd/MM/yyyy\", \"date_locale\": \"en\", \"date_selector\": \"span.chapter-release-date\", \"image_origin\": \"keep\", \"image_retry\": \"no\", \"list_mode\": \"ajax\", \"manga_dir\": \"manga\", \"page_mode\": \"style_list\", \"skip_premium\": \"no\"}"
 }
