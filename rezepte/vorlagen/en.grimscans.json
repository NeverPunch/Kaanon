{
 "extension": {
  "name": "Grim Scans",
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.grimscans",
  "version": "1.6.12",
  "inhalt": "SAFE",
  "quellen": [
   {
    "id": 8588684547293952127,
    "name": "Grim Scans",
    "language": "en",
    "homeUrl": "https://grimscans.com",
    "mirrorUrls": []
   }
  ]
 },
 "baukasten": "keyoapp",
 "parameter": {
  "apex": "grimscans.com",
  "popular_mode": "home"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 3,
   "period_ms": 2000
  },
  "popular": {
   "request": "{base}/",
   "items": [
    ".series-splide .splide__slide:not(.splide__slide--clone)",
    "section.splide.series-splide a.splide__slide",
    "div:contains(Popular) + div .group.overflow-hidden.grid",
    "div:contains(Trending) + div .group.overflow-hidden.grid",
    "div:contains(Trending) + div .group"
   ],
   "skip": {
    "any": [
     {
      "path": "[data-type~=(?i)^novel$]@data-type"
     },
     {
      "path": "span:matchesOwn((?i)^novel$)"
     },
     {
      "path": [
       "a[href]@title"
      ],
      "regex": "(?i)(\\[novel\\])"
     }
    ]
   },
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "a[href]@href",
    "title": [
     "a[href]@title",
     "@title",
     "a[href]@alt",
     "@alt"
    ],
    "cover": {
     "path": "[style*=background-image]@style",
     "regex": "url\\(['\"]?([^('\")]+)",
     "replace": [
      [
       "([?&])w=\\d+(?=&|$)",
       "$1w=480"
      ]
     ]
    }
   }
  },
  "latest": {
   "request": "{base}/latest/",
   "items": "div.grid > div.group",
   "skip": {
    "any": [
     {
      "path": "[data-type~=(?i)^novel$]@data-type"
     },
     {
      "path": "span:matchesOwn((?i)^novel$)"
     },
     {
      "path": [
       "a[href]@title"
      ],
      "regex": "(?i)(\\[novel\\])"
     }
    ]
   },
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "a[href]@href",
    "title": [
     "a[href]@title",
     "@title",
     "a[href]@alt",
     "@alt"
    ],
    "cover": {
     "path": "[style*=background-image]@style",
     "regex": "url\\(['\"]?([^('\")]+)",
     "replace": [
      [
       "([?&])w=\\d+(?=&|$)",
       "$1w=480"
      ]
     ]
    }
   }
  },
  "search": {
   "request": "{base}/series?q={query}",
   "items": "#searched_series_page > button",
   "skip": {
    "any": [
     {
      "path": "[data-type~=(?i)^novel$]@data-type"
     },
     {
      "path": "span:matchesOwn((?i)^novel$)"
     },
     {
      "path": [
       "a[href]@title"
      ],
      "regex": "(?i)(\\[novel\\])"
     }
    ]
   },
   "client_filter": true,
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "a[href]@href",
    "title": [
     "a[href]@title",
     "@title",
     "a[href]@alt",
     "@alt"
    ],
    "cover": {
     "path": "[style*=background-image]@style",
     "regex": "url\\(['\"]?([^('\")]+)",
     "replace": [
      [
       "([?&])w=\\d+(?=&|$)",
       "$1w=480"
      ]
     ]
    }
   }
  },
  "details": {
   "request": "{abs_url}",
   "let": {},
   "fields": {
    "title": "div.grid > h1",
    "cover": {
     "path": [
      "div[class*=photoURL]@style",
      "div[style*=photoURL]@style"
     ],
     "regex": "url\\(['\"]?([^('\")]+)",
     "replace": [
      [
       "([?&])w=\\d+(?=&|$)",
       "$1w=480"
      ]
     ]
    },
    "description": "#expand_content p",
    "genres": "div:has(>h1) a[href*='genre=']",
    "author": [
     "div:has(span:containsOwn(Author)) ~ div",
     "div[alt=Author]"
    ],
    "artist": [
     "div:has(span:containsOwn(Artist)) ~ div",
     "div[alt=Artist]"
    ],
    "status": [
     "div:has(span:containsOwn(Status)) ~ div",
     "div[alt=Status]"
    ]
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "dropped": 5,
    "paused": 6,
    "hiatus": 6
   }
  },
  "chapters": {
   "request": "details",
   "items": "#chapters > :is(a, div)",
   "skip": {
    "any": [
     "img[alt~=Coin]@alt",
     ".text-sm span:matches(Upcoming)"
    ]
   },
   "fields": {
    "url": "a[href]@href",
    "name": ".text-sm",
    "date": [
     "a[href]@d",
     ".text-xs"
    ]
   },
   "date_format": [
    "MMM d, yyyy",
    "relative"
   ],
   "date_locale": "en"
  },
  "pages": {
   "request": "{abs_url}",
   "let": {
    "cdn": {
     "path": "script@html",
     "all": true,
     "join": "",
     "regex": "realUrl\\s*=\\s*`[^`]+//([^/]+)",
     "replace": [
      [
       "\\$\\{[^}]*\\}",
       ""
      ]
     ]
    }
   },
   "items": "#pages > img",
   "image": [
    {
     "path": "@uid",
     "template": "https://{l.cdn}/uploads/{value}"
    },
    "@img"
   ]
  },
  "origin": "baukasten:keyoapp {\"apex\": \"grimscans.com\", \"popular_mode\": \"home\"}"
 }
}