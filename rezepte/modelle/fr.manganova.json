   }
  },
  "search": {
   "request": {
    "url": "https://api.manga-nova.com/catalogue/",
    "headers": {
     "X-Requested-With": "XMLHttpRequest",
     "Authorization": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJtZW1icmVfaWQiOjAsIm1lbWJyZV91c2VybmFtZSI6bnVsbCwiaWF0IjoxNzA1NTc5MDQ1fQ.51qivLd2l3OKbDaYYzlntZJNnreRSBWO7p5Nsa2mAsA"
    }
   },
   "format": "json",
   "items": "series",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/manga/{value}"
    },
    "title": "title",
    "cover": "poster"
   },
   "has_next": {
    "const": false
   },
   "client_filter": true
  },
  "details": {
   "request": {
    "url": "https://api.manga-nova.com/mangas/{u.slug}",
    "headers": {
     "X-Requested-With": "XMLHttpRequest",
     "Authorization": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJtZW1icmVfaWQiOjAsIm1lbWJyZV91c2VybmFtZSI6bnVsbCwiaWF0IjoxNzA1NTc5MDQ1fQ.51qivLd2l3OKbDaYYzlntZJNnreRSBWO7p5Nsa2mAsA"
    }
   },
   "format": "json",
   "url_vars": {
    "slug": "/manga/([^/?#]+)"
   },
   "fields": {
    "title": "serie.title",
    "description": "serie.description",
    "cover": "serie.poster",
    "author": "serie.author",
    "artist": "serie.dessinateur",
    "genres": {
     "path": "serie.genres",
     "replace": [
      [
       "\\s*,\\s*",
       ", "
      ]
     ]
    },
    "status": "serie.running"
   },
   "status_map": {
    "0": 2,
    "1": 1
   }
  },
  "chapters": {
   "request": "details",
   "format": "json",
   "url_vars": {
    "slug": "/manga/([^/?#]+)"
   },
   "items": "serie.chapitres.*.chapitres.*",
   "skip": {
    "path": "amount",
    "regex": "^(?!0$)."
   },
   "fields": {
    "url": {
     "path": "number",
     "replace": [
      [
       "\\.0$",
       ""
      ]
     ],
     "template": "/lecture-en-ligne/{u.slug}/chapitre/{value}"
    },
    "name": {
     "path": "title",
     "template": "{value}[[ - {f.sub_title}]]"
    },
    "number": "number"
   },
   "sort": "number",
   "reverse": true
  },
  "pages": {
   "request": {
    "url": "https://api.manga-nova.com/mangas/{u.slug}/chapitres/{u.num}",
    "headers": {
     "X-Requested-With": "XMLHttpRequest",
     "Authorization": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJtZW1icmVfaWQiOjAsIm1lbWJyZV91c2VybmFtZSI6bnVsbCwiaWF0IjoxNzA1NTc5MDQ1fQ.51qivLd2l3OKbDaYYzlntZJNnreRSBWO7p5Nsa2mAsA"
    }
   },
   "format": "json",
   "url_vars": {
    "slug": "/lecture-en-ligne/([^/?#]+)/",
    "num": "/chapitre/([^/?#]+)"
   },
   "items": "images",
   "sort": "page_number",
   "image": "image"
  }
 },
 "hinweise": [
  "API api.manga-nova.com mit dem festen öffentlichen Standard-Token der Website (Bearer, wie Community DEFAULT_TOKEN; kein Login) – nur bei API-Anfragen gesendet. Ein Token aus dem Cookie 'token' (eingeloggt) wird nicht übernommen.",
  "Listen: /catalogue/ (series = Beliebt, new_series = Neueste, Suche per client_filter über series); eine Seite.",
  "Details: Community sucht die Serie im Katalog per Slug (Filter mit Platzhalter nicht belegt); hier aus /mangas/<slug> unter 'serie' mit denselben Feldnamen wie im Katalog (title, description, poster, author, dessinateur, genres, running) – ANNAHME, auf dem PC prüfen. Status: running 0 = abgeschlossen, sonst laufend.",
  "Kapitel: serie.chapitres[*].chapitres[*] (doppeltes * wie es.manhwaweb 'top.*.*'), kostenpflichtige (amount ≠ 0) übersprungen. Name 'Titel - Untertitel' ohne Kategorietitel (Elternfeld nicht zugreifbar). Datum (jetzt + available_time) weggelassen. 'sort' in chapters nicht in Vorlagen belegt – ggf. entfernen."
 ]
}
