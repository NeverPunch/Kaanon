{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "FastScan",
  "sprache": "vi",
  "base_url": "https://fastscan.org",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.vi.kaanon.fastscan",
  "quellen": [
   {
    "name": "FastScan",
    "sprache": "vi",
    "quell_id": 4353548193024198457,
    "home": "https://fastscan.org"
   }
  ]
 },
 "quelle": {
  "modul": "src/vi/fastscan",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.5",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Referer": "{base}/"
  },
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/tim-kiem-nang-cao?category=&notcategory=&status=0&minchapter=0&sort=4&page={page}",
   "items": "ul.list_grid.grid > li",
   "has_next": {
    "exists": ".page_redirect a:contains(›)"
   },
   "fields": {
    "url": ".book_avatar a, .book_name a@href",
    "title": ".book_name a",
    "cover": [
     "img@data-src",
     "img@src"
    ]
   }
  },
  "latest": {
   "request": "{base}/tim-kiem-nang-cao?category=&notcategory=&status=0&minchapter=0&sort=0&page={page}",
   "items": "ul.list_grid.grid > li",
   "has_next": {
    "exists": ".page_redirect a:contains(›)"
   },
   "fields": {
    "url": ".book_avatar a, .book_name a@href",
    "title": ".book_name a",
    "cover": [
     "img@data-src",
     "img@src"
    ]
   }
  },
  "search": {
   "request": "{base}/tim-kiem?q={query}&page={page}",
   "items": "ul.list_grid.grid > li",
   "has_next": {
    "exists": ".page_redirect a:contains(›)"
   },
   "fields": {
    "url": ".book_avatar a, .book_name a@href",
    "title": ".book_name a",
    "cover": [
     "img@data-src",
     "img@src"
    ]
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": ".book_detail .book_other h1",
    "cover": [
     ".book_info .book_avatar img@data-src",
     ".book_info .book_avatar img@src"
    ],
    "author": "p:contains(Tác giả) + p",
    "genres": {
     "path": ".book_other ul.list01 a",
     "all": true,
     "join": ", "
    },
    "description": [
     {
      "path": ".story-detail-info p",
      "all": true,
      "join": "\n\n"
     },
     ".story-detail-info"
    ],
    "status": {
     "path": "li.status p.col-xs-9",
     "regex": "(?i)(đang cập nhật|hoàn thành)",
     "group": 1
    }
   },
   "status_map": {
    "đang cập nhật": 1,
    "hoàn thành": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": ".list_chapter .works-chapter-item",
   "fields": {
    "url": ".name-chap a@href",
    "name": ".name-chap a",
    "date": ".time-chap"
   },
   "date_format": "dd/MM/yyyy"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "#chapter_content img, .page-chapter img, img.lozad",
   "image": [
    "@data-src",
    "@src"
   ],
   "exclude": "^data:"
  }
 },
 "hinweise": [
  "HTML-Website (KeiSource). Beliebt = erweiterte Suche sort=4 (Aufrufe), Neu = sort=0.",
  "Status per Teilstring (đang cập nhật/hoàn thành) wie Community; Datum dd/MM/yyyy (Community: Mitternacht Asia/Ho_Chi_Minh).",
  "Bilder: data-src vor src, data:-Platzhalter ausgeschlossen; Community entfernt zusätzlich Dubletten."
 ]
}
