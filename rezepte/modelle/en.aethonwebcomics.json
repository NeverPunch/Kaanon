{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Aethon Webcomics",
  "sprache": "en",
  "base_url": "https://aethonwebcomics.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.aethonwebcomics",
  "quellen": [
   {
    "name": "Aethon Webcomics",
    "sprache": "en",
    "quell_id": 5210693156893032326,
    "home": "https://aethonwebcomics.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/aethonwebcomics",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.0",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/wp-json/wp/v2/webcomic_series?per_page=24&_embed=wp:term&_fields=slug,title,_links,_embedded,meta&orderby=date&order=asc&page={page}",
   "format": "json",
   "items": "$",
   "page_size": 24,
   "has_next": {
    "full": true
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/webcomics/{value}/"
    },
    "title": {
     "path": "title.rendered",
     "decode": "html"
    }
   }
  },
  "search": {
   "request": "{base}/wp-json/wp/v2/webcomic_series?per_page=24&_embed=wp:term&_fields=slug,title,_links,_embedded,meta&orderby=date&order=asc&search={query}&page={page}",
   "format": "json",
   "items": "$",
   "page_size": 24,
   "has_next": {
    "full": true
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/webcomics/{value}/"
    },
    "title": {
     "path": "title.rendered",
     "decode": "html"
    }
   }
  },
  "details": {
   "request": "{base}/wp-json/wp/v2/webcomic_series?slug={u.slug}&_embed=wp:term",
   "format": "json",
   "url_vars": {
    "slug": "/webcomics/([^/?#]+)"
   },
   "let": {
    "log": "0.meta.webcomic_logline",
    "syn": {
     "path": "0.meta.webcomic_series_description",
     "decode": "html_text"
    }
   },
   "fields": {
    "title": {
     "path": "0.title.rendered",
     "decode": "html"
    },
    "author": {
     "path": "0._embedded.wp:term.*.?taxonomy=webcomic_writer.name",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "0._embedded.wp:term.*.?taxonomy=webcomic_artist.name",
     "all": true,
     "join": ", "
    },
    "genres": "0._embedded.wp:term.*.?taxonomy=webcomic_genre.name",
    "description": {
     "const": "[[{l.log}\n\n]]{l.syn}"
    },
    "status": "0.meta.webcomic_status"
   },
   "status_map": {
    "ongoing": 1,
    "complete": 2,
    "hiatus": 6,
    "between_seasons": 6
   }
  },
  "chapters": {
   "request": "{abs_url}",
   "items": "[data-webcomic-episode-page] .modfarm-webcomic-episode-card",
   "skip": ".modfarm-webcomic-episode-card-meta:contains(Premium)@class",
   "fields": {
    "url": "a@href",
    "name": ".modfarm-webcomic-episode-card-title",
    "number": {
     "path": ".modfarm-webcomic-episode-number",
     "regex": "#?\\s*([0-9.]+)"
    }
   }
  },
  "pages": {
   "request": "{abs_url}",
   "items": "[data-webcomic-reader] img[data-panel-img]",
   "image": "@src"
  }
 },
 "hinweise": [
  "WordPress-REST /wp/v2/webcomic_series (24 je Seite, Community: X-WP-TotalPages; hier 'volle Seite'). Beliebt = Community-Standard 'Oldest' (orderby=date asc).",
  "Kein Cover: Community holt die Bilder über einen zweiten Aufruf /wp/v2/media?include=<card_image_ids> – Auffächern nicht ausdrückbar.",
  "Kein Latest: Community sammelt Serien-IDs aus den letzten 100 Episoden und lädt dann diese Serien (zweistufig).",
  "Kapitel von der Serienseite (Episode-Karten); Premium-Episoden werden übersprungen (Community-Standard 'Show Premium episodes' = aus). Kapiteldatum (eigener REST-Aufruf je 100 IDs) nicht abgebildet.",
  "Beschreibung = Logline + Synopsis (HTML → Text); Altersfreigabe/Erscheinungsrhythmus nicht angehängt. Autor/Zeichner/Genres aus _embedded wp:term nach taxonomy (Pfadmuster aus id.kiryuu)."
 ]
}
