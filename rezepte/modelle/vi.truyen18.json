  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "main h1",
    "cover": {
     "path": "main img[alt][src]@src",
     "replace": [
      [
       "^.*[?&]url=([^&]+).*$",
       "$1"
      ],
      [
       "%2F",
       "/"
      ],
      [
       "%3A",
       ":"
      ],
      [
       "^/(?!/)",
       "https://truyen18.co/"
      ]
     ]
    },
    "author": "main *:has(> span:matchesOwn((?i)^Tác giả:$)) > :eq(1)",
    "status": {
     "path": "main *:has(> span:matchesOwn((?i)^Trạng thái:$)) > :eq(1)",
     "replace": [
      [
       "(?is)^.*(?:đang tiến hành|đang cập nhật).*$",
       "ongoing"
      ],
      [
       "(?is)^.*hoàn thành.*$",
       "completed"
      ]
     ]
    },
    "genres": {
     "path": "main a[href*='/category/'], main a[href*='/tag/']",
     "all": true,
     "join": ", "
    },
    "description": "main p:matches(^Nội dung cập nhật)"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "main section:has(h2:contains(Danh sách chương)) a[href*=/chapter-]",
   "fields": {
    "url": "@href",
    "name": [
     {
      "path": "@title",
      "regex": "^.* - (.+)$",
      "group": 1
     },
     "@title",
     ""
    ]
   }
  },
  "pages": {
   "request": {
    "url": "{abs_url}",
    "headers": {
     "rsc": "1"
    }
   },
   "format": "text",
   "items": "<img[^>]*?src=\\\\?\"([^\"\\\\]+)",
   "image": "",
   "exclude": "/bn\\.png$"
  }
 },
 "hinweise": [
  "HTML wie Community: Beliebt /xem-nhieu-nhat, Neueste /moi-cap-nhat, Suche /search?q= (Folgeseiten …/page/n; weiter, solange link[rel=next] da ist). Genre-Filter nicht übernommen. Listeneinträge = Links mit h3; Cover nur, wenn das Bild im selben Link steckt (Community sucht einen Nachbarlink mit gleicher URL); next/image-URLs (?url=…) werden per Ersetzung entpackt.",
  "Details: Autor/Status = zweites Kind des Elements, das ein span 'Tác giả:' bzw. 'Trạng thái:' enthält (wie Community). Beschreibung = Absatz, der mit 'Nội dung cập nhật' beginnt. Genres aus /category/- und /tag/-Links (Doppelte nicht entfernt).",
  "Kapitel: Links /chapter- im Abschnitt 'Danh sách chương'; Name = title nach dem letzten ' - '. Datum ('Đăng lúc:' in der umgebenden Zeile) NICHT übernommen – Zugriff auf Elternelemente gibt es nicht. Doppelte Links möglich (Community: distinctBy).",
  "Seiten: Community liest das Kapitelobjekt (slug + content-HTML) aus den Next.js-Flight-Daten. Hier Abruf mit rsc: 1 (wie en.drakescans) und Regex auf alle <img src=…> im Rohtext (escaped oder roh); /bn.png (Banner) ausgeschlossen. UNSICHER: setzt voraus, dass nur der Kapitelinhalt als HTML-Text mit <img> in den Flight-Daten steht – auf dem PC prüfen."
 ]
