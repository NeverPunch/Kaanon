{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Ego Toons",
  "sprache": "pt-BR",
  "base_url": "https://egotoons.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.pt-BR.kaanon.egotoons",
  "quellen": [
   {
    "name": "Ego Toons",
    "sprache": "pt-BR",
    "quell_id": 4749792168996703143,
    "home": "https://egotoons.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/pt/egotoons",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.11",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/api/obras.js?pagina={page}&limite=24&ordenarPor=populares",
   "format": "json",
   "items": "obras",
   "fields": {
    "url": {
     "path": "id",
     "template": "/obra/{value}"
    },
    "title": "nome",
    "cover": "imagem"
   },
   "has_next": {
    "exists": "pagination.hasNextPage"
   }
  },
  "latest": {
   "request": "{base}/api/obras.js?pagina={page}&limite=24&ordenarPor=recentes",
   "format": "json",
   "items": "obras",
   "fields": {
    "url": {
     "path": "id",
     "template": "/obra/{value}"
    },
    "title": "nome",
    "cover": "imagem"
   },
   "has_next": {
    "exists": "pagination.hasNextPage"
   }
  },
  "search": {
   "request": "{base}/api/obras.js?pagina={page}&limite=24&ordenarPor=recentes&busca={query}",
   "format": "json",
   "items": "obras",
   "fields": {
    "url": {
     "path": "id",
     "template": "/obra/{value}"
    },
    "title": "nome",
    "cover": "imagem"
   },
   "has_next": {
    "exists": "pagination.hasNextPage"
   }
  },
  "details": {
   "request": "{base}/api/obras/{u.id}",
   "format": "json",
   "url_vars": {
    "id": "/obra/(\\d+)"
   },
   "fields": {
    "title": "obra.nome",
    "cover": "obra.imagem",
    "description": {
     "path": "obra.descricao",
     "decode": "html_text"
    },
    "genres": {
     "path": [
      "obra.formato_nome",
      "obra.tags.*.nome"
     ],
     "union": true
    },
    "status": "obra.status_nome"
   },
   "status_map": {
    "ativo": 1,
    "em andamento": 1,
    "em-andamento": 1,
    "finalizado": 2,
    "completo": 2,
    "hiato": 6
   }
  },
  "chapters": {
   "request": "{base}/api/obras/{u.id}/capitulos.js?pagina={page}&limite=80&ordenar=desc&fields=list",
   "format": "json",
   "url_vars": {
    "id": "/obra/(\\d+)"
   },
   "items": "capitulos",
   "fields": {
    "url": {
     "path": [
      "numero_key",
      "numero"
     ],
     "replace": [
      [
       "\\.0+$",
       ""
      ]
     ],
     "template": "/obra/{u.id}/capitulo/{value}"
    },
    "name": [
     "titulo",
     "nome",
     {
      "path": [
       "numero_key",
       "numero"
      ],
      "replace": [
       [
        "\\.0+$",
        ""
       ]
      ],
      "template": "Capítulo {value}"
     }
    ],
    "number": "numero",
    "date": "criado_em"
   },
   "date_format": "iso",
   "paging": {
    "has_next": {
     "exists": "pagination.hasNextPage"
    },
    "max_pages": 50
   }
  },
  "pages": {
   "request": "{base}/api/obras/{u.mid}/capitulos/{u.num}/index.js",
   "format": "json",
   "url_vars": {
    "mid": "/obra/(\\d+)/",
    "num": "/capitulo/([^/?#]+)"
   },
   "let": {
    "cid": "capitulo.id"
   },
   "then": [
    {
     "request": {
      "url": "https://api.egotoons.com/api/leitor/capitulos/{l.cid}/manifest?offset=0&limit=500",
      "headers": {
       "Referer": "{abs_url}"
      }
     },
     "format": "json"
    }
   ],
   "items": "pages",
   "image": {
    "path": "url",
    "replace": [
     [
      "^/(?!/)",
      "https://api.egotoons.com/"
     ]
    ]
   },
   "referer": "chapter"
  }
 },
 "hinweise": [
  "API: Listen {base}/api/obras.js (24 je Seite, ordenarPor populares/recentes, busca=), Details /api/obras/<id>, Kapitel /api/obras/<id>/capitulos.js (80 je Seite, Blättern solange pagination.hasNextPage). Format-/Status-/Tag-Filter nicht übernommen.",
  "Kapitel-URL /obra/<id>/capitulo/<numero_key bzw. numero ohne .0/.00>; Name titulo → nome → 'Capítulo N'.",
  "Seiten: erst Kapitel-ID über /api/obras/<id>/capitulos/<num>/index.js, dann Manifest api.egotoons.com/api/leitor/capitulos/<cid>/manifest mit Referer = Leser-URL. Community blättert per nextOffset in 24er-Schritten; hier einmal limit=500 (Annahme, dass die API das annimmt – sonst nur die ersten Seiten; prüfen).",
  "Bild-URLs relativ zu api.egotoons.com → per replace absolut gemacht. Bild-Referer = Kapitel-URL (wie Community).",
  "Beschreibung: HTML → Text (html_text). Genres: formato_nome + Tags (union)."
 ]
}
