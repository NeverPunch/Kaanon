 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/api-search.php?text=&order=views&genres=&blacklist=&page={page}&limit=36",
   "items": "div.in-grid > a",
   "page_size": 36,
   "has_next": {
    "full": true
   },
   "fields": {
    "url": [
     {
      "path": "@href",
      "regex": "/fw\\?to=(.+)$",
      "group": 1,
      "replace": [
       [
        "%3A",
        ":"
       ],
       [
        "%2F",
        "/"
       ],
       [
        "%3F",
        "?"
       ],
       [
        "%3D",
        "="
       ],
       [
        "%26",
        "&"
       ],
       [
        "%25",
        "%"
       ]
      ]
     },
     "@href"
    ],
    "title": "h3.man-title",
    "cover": "img.read-cover@src"
   }
  },
  "latest": {
   "request": "{base}/api-search.php?text=&order=uploaded&genres=&blacklist=&page={page}&limit=36",
