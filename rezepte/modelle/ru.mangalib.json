{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "MangaLib",
  "sprache": "ru",
  "base_url": "https://mangalib.me",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.ru.kaanon.mangalib",
  "quellen": [
   {
    "name": "MangaLib",
    "sprache": "ru",
    "quell_id": 6111047689498497237,
    "home": "https://mangalib.me"
   }
  ]
 },
 "quelle": {
  "modul": "src/ru/mangalib",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "libgroup"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Accept": "text/html,application/json,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8",
   "Site-Id": "1"
  },
  "image_headers": {
   "Accept": "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8"
  },
  "rate_limit": {
   "permits": 1,
   "period_ms": 1000
  },
  "popular": {
   "request": "https://api.cdnlibs.org/api/manga?site_id[]=1&page={page}",
   "format": "json",
   "items": "data",
   "has_next": {
    "exists": "meta.has_next_page"
   },
   "fields": {
    "url": {
     "path": "slug_url",
     "template": "/{value}"
    },
    "title": [
     "eng_name",
     "name"
    ],
    "cover": "cover.default"
   }
  },
  "latest": {
   "request": "https://api.cdnlibs.org/api/latest-updates?page={page}",
   "format": "json",
   "items": "data",
   "has_next": {
    "exists": "meta.has_next_page"
   },
   "fields": {
    "url": {
     "path": "slug_url",
     "template": "/{value}"
    },
    "title": [
     "eng_name",
     "name"
    ],
    "cover": "cover.default"
   }
  },
  "search": {
   "request": "https://api.cdnlibs.org/api/manga?page={page}&site_id[]=1&q={query}",
   "format": "json",
   "items": "data",
   "has_next": {
    "exists": "meta.has_next_page"
   },
   "fields": {
    "url": {
     "path": "slug_url",
     "template": "/{value}"
    },
    "title": [
     "eng_name",
     "name"
    ],
    "cover": "cover.default"
   }
  },
  "details": {
   "request": "https://api.cdnlibs.org/api/manga/{u.slug}?fields[]=eng_name&fields[]=otherNames&fields[]=summary&fields[]=rate&fields[]=genres&fields[]=tags&fields[]=teams&fields[]=authors&fields[]=publisher&fields[]=userRating&fields[]=manga_status_id&fields[]=status_id&fields[]=artists",
   "format": "json",
   "url_vars": {
    "slug": "^/([^/?#]+)"
   },
   "fields": {
    "title": [
     "data.eng_name",
     "data.name"
    ],
    "cover": "data.cover.default",
    "author": {
     "path": "data.authors.*.name",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "data.artists.*.name",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": [
      "data.type.label",
      "data.ageRestriction.label",
      "data.genres.*.name",
      "data.tags.*.name"
     ],
     "union": true
    },
    "description": [
     {
      "path": "data.summary.content.*.content.*.text",
      "all": true,
      "join": "\n"
     },
     "data.summary"
    ],
    "status": [
     "data.scanlateStatus.label",
     "data.status.label"
    ]
   },
   "status_map": {
    "продолжается": 1,
    "выходит": 1,
    "онгоинг": 1,
    "анонс": 1,
    "завершён": 2,
    "вышло": 4,
    "заморожен": 6,
    "заброшен": 6,
    "приостановлен": 6,
    "выпуск прекращён": 5
   }
  },
  "chapters": {
   "request": "https://api.cdnlibs.org/api/manga/{u.slug}/chapters",
   "format": "json",
   "items": "data",
   "reverse": true,
   "locked": {
    "path": "branches.0.restricted_view.is_open",
    "equals": "false"
   },
   "fields": {
    "url": {
     "path": "number",
     "template": "/{u.slug}/chapter?volume={f.volume}&number={value}[[&branch_id={f.branches.0.branch_id}]]"
    },
    "name": {
     "path": "number",
     "template": "Том {f.volume}. Глава {value}[[ - {f.name}]]"
    },
    "number": "number",
    "scanlator": "branches.0.teams.0.name",
    "date": "branches.0.created_at"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "https://api.cdnlibs.org/api/constants?fields[]=imageServers",
   "format": "json",
   "url_vars": {
    "slug": "^/([^/?#]+)/chapter",
    "q": "chapter\\?(.*)$"
   },
   "let": {
    "srv": "data.imageServers.?id=compress.url"
   },
   "then": [
    {
     "request": "https://api.cdnlibs.org/api/manga/{u.slug}/chapter?{u.q}",
     "format": "json"
    }
   ],
   "items": "data.pages",
   "image": {
    "path": "url",
    "template": "{l.srv}{value}"
   }
  }
 },
 "hinweise": [
  "Theme LibGroup: JSON-API api.cdnlibs.org (Standard-API-Domain der Community-Einstellung) mit Header Site-Id: 1; Rate-Limit 1/s für API und Website.",
  "Titel: Community-Standard 'eng' → eng_name, sonst name. Beschreibung: summary ist Text oder ProseMirror-JSON (doc → paragraph → text); Rezept liest content.*.content.*.text, sonst summary als Text. Bewertung/Alternativtitel nicht angehängt.",
  "Status: zuerst Übersetzungsstatus (scanlateStatus), sonst Titelstatus; Kombinationsregeln der Community (Завершён + Приостановлен → pausiert, is_licensed → lizenziert) vereinfacht.",
  "Kapitel: Community wählt bei mehreren Übersetzer-Zweigen den Standardzweig (/api/branches/<id>) oder listet alle; Rezept nimmt immer branches.0. Kapitel mit restricted_view.is_open=false (bezahlt) werden per locked ausgelassen. Kapitel-URL '/<slug>/chapter?volume=…&number=…[&branch_id=…]' (Reihenfolge der Parameter anders als Community, API-gleich).",
  "Bilder: Server-URL aus /api/constants (imageServers, id 'compress' = Community-Standard). Community filtert zusätzlich nach site_ids enthält 1 – nicht abbildbar; Rezept nimmt den ersten 'compress'-Eintrag. Auf dem PC prüfen.",
  "Login (Bearer-Token aus WebView/localStorage) für 18+-Titel nicht abgebildet; ohne Login liefert die API für solche Titel 404."
 ]
}
