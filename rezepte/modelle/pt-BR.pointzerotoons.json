{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Point Zero Toons",
  "sprache": "pt-BR",
  "base_url": "https://kitsuneyako.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.pt-BR.kaanon.pointzerotoons",
  "quellen": [
   {
    "name": "Point Zero Toons",
    "sprache": "pt-BR",
    "quell_id": 2210021497257492329,
    "home": "https://kitsuneyako.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/pt/pointzerotoons",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.4",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/manga/page/{page}/?order=popular",
   "request_by_page": {
    "1": "{base}/manga/?order=popular"
   },
   "items": "article.inkra-catalog-card",
   "skip": {
    "path": "h3 a",
    "regex": "(?i)\\(NOVEL\\)"
   },
   "has_next": {
    "exists": "a.next.page-numbers"
   },
   "fields": {
    "url": "a.inkra-catalog-card__media@href",
    "title": "h3 a",
    "cover": "img@src"
   }
  },
  "latest": {
   "request": "{base}/manga/page/{page}/?order=updated",
   "request_by_page": {
    "1": "{base}/manga/?order=updated"
   },
   "items": "article.inkra-catalog-card",
   "skip": {
    "path": "h3 a",
    "regex": "(?i)\\(NOVEL\\)"
   },
   "has_next": {
    "exists": "a.next.page-numbers"
   },
   "fields": {
    "url": "a.inkra-catalog-card__media@href",
    "title": "h3 a",
    "cover": "img@src"
   }
  },
  "search": {
   "request": "{base}/manga/page/{page}/?order=popular&s={query}",
   "request_by_page": {
    "1": "{base}/manga/?order=popular&s={query}"
   },
   "items": "article.inkra-catalog-card",
   "skip": {
    "path": "h3 a",
    "regex": "(?i)\\(NOVEL\\)"
   },
   "has_next": {
    "exists": "a.next.page-numbers"
   },
   "fields": {
    "url": "a.inkra-catalog-card__media@href",
    "title": "h3 a",
    "cover": "img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1.inkra-page-title",
    "cover": ".inkra-series-cover img@src",
    "description": ".inkra-series-synopsis",
    "author": "dl.inkra-series-detail-list dt:contains(Autor) + *",
    "genres": "dl.inkra-series-detail-list dt:contains(Tipo) + *",
    "status": "dl.inkra-series-detail-list dt:contains(Status) + *"
   },
   "status_map": {
    "ongoing": 1,
    "on-going": 1,
    "completed": 2,
    "hiatus": 6,
    "dropped": 5,
    "canceled": 5
   }
  },
  "chapters": {
   "request": "details",
   "items": "article.inkra-chapter-item",
   "fields": {
    "url": "a.inkra-chapter-item__link@href",
    "name": ".inkra-chapter-item__label",
    "number": "@data-number"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "figure.inkra-reader-page img",
   "image": "@src"
  }
 },
 "hinweise": [
  "Katalog /manga/(page/N/)?order=popular|updated wie Community; Suche mit s= und Standard-Sortierung popular. Status-/Typ-/Gênero-Filter nicht übernommen.",
  "Novels werden wie in der Community über die Markierung „(NOVEL)“ im Titel übersprungen.",
  "Gênero = Feld „Tipo“ der Detailliste (Community: nur das, erster Buchstabe groß). Kapitel ohne Datum."
 ]
}
