{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Shiro Doujin",
  "sprache": "id",
  "base_url": "https://shirodoujin.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.id.kaanon.shirodoujin",
  "quellen": [
   {
    "name": "Shiro Doujin",
    "sprache": "id",
    "quell_id": 8468586261171749665,
    "home": "https://shirodoujin.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/id/shirodoujin",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.7",
  "theme": "zmanga"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/advanced-search/page/{page}/?order=popular",
   "request_by_page": {
    "1": "{base}/advanced-search/?order=popular"
   },
   "items": "div.flexbox2-item",
   "has_next": {
    "exists": "div.pagination .next"
   },
   "fields": {
    "url": "div.flexbox2-content a@href",
    "title": "div.flexbox2-title > span",
    "cover": "img@src"
   }
  },
  "latest": {
   "request": "{base}/advanced-search/page/{page}/?order=update",
   "request_by_page": {
    "1": "{base}/advanced-search/?order=update"
   },
   "items": "div.flexbox2-item",
   "has_next": {
    "exists": "div.pagination .next"
   },
   "fields": {
    "url": "div.flexbox2-content a@href",
    "title": "div.flexbox2-title > span",
    "cover": "img@src"
   }
  },
  "search": {
   "request": "{base}/advanced-search/page/{page}/?title={query}",
   "request_by_page": {
    "1": "{base}/advanced-search/?title={query}"
   },
   "items": "div.flexbox2-item",
   "has_next": {
    "exists": "div.pagination .next"
   },
   "fields": {
    "url": "div.flexbox2-content a@href",
    "title": "div.flexbox2-title > span",
    "cover": "img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": [
     "div.series-title h2",
     ".series-title"
    ],
    "cover": [
     "div.series-thumb img@data-lazy-src",
     "div.series-thumb img@src"
    ],
    "author": {
     "path": ".series-infolist li:contains(Author) span",
     "all": true,
     "join": " "
    },
    "artist": {
     "path": ".series-infolist li:contains(Artist) span",
     "all": true,
     "join": " "
    },
    "description": "div.series-synops",
    "genres": {
     "path": [
      "div.series-genres a",
      "div.block span.type@ownText"
     ],
     "union": true,
     "all": true,
     "join": ", "
    },
    "status": {
     "path": ".series-infoz .status@ownText",
     "regex": "(?i)(ongoing|completed)",
     "group": 1
    }
   },
   "status_map": {
    "ongoing": 1,
    "Ongoing": 1,
    "completed": 2,
    "Completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "ul.series-chapterlist div.flexch-infoz a",
   "fields": {
    "url": "@href",
    "name": "span@ownText",
    "date": "span.date"
   },
   "date_format": "MMM d, yyyy",
   "date_locale": "id"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div.reader-area img:not(noscript img)",
   "image": [
    {
     "path": "@data-lazy-src",
     "replace": [
      [
       "\\\\",
       ""
      ]
     ]
    },
    {
     "path": "@src",
     "replace": [
      [
       "\\\\",
       ""
      ]
     ]
    }
   ]
  }
 },
 "hinweise": [
  "Theme ZManga. Listen über /advanced-search/[page/N/]?order=popular|update (Seite 1 ohne page/1/), Suche ?title=…; nächste Seite über div.pagination .next.",
  "Titel steht im Code nicht (aus der Liste übernommen); hier Ausweich-Selektor div.series-title h2 / .series-title – auf dem PC prüfen.",
  "Status: ownText von .series-infoz .status, enthält 'ongoing'/'completed' (Code prüft per contains).",
  "Genres + Serientyp (div.block span.type); Alternativname nicht an die Beschreibung angehängt.",
  "Datum 'MMM d, yyyy' mit indonesischem Locale (wie im Modul überschrieben).",
  "Projektliste (/project-list) als Filter nicht nachgebaut."
 ]
}