{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Lmtos",
  "sprache": "es",
  "base_url": "https://lmtos.net",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.es.kaanon.lmtos",
  "quellen": [
   {
    "name": "Lmtos",
    "sprache": "es",
    "quell_id": 7732736838916328250,
    "home": "https://lmtos.net"
   }
  ]
 },
 "quelle": {
  "modul": "src/es/lmtoonline",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.3",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "popular": {
   "request": {
    "url": "{base}/series?page={page}&sort=rating",
    "headers": {
     "rsc": "1"
    }
   },
   "format": "text",
   "items": "\\{(?=[^{}]*\"slug\":\"[^\"]+\")(?=[^{}]*\"title\":\")(?=[^{}]*\"coverImage\":)[^{}]*\\}",
   "fields": {
    "url": {
     "path": "",
     "regex": "\"slug\":\"([^\"]+)\"",
     "group": 1,
     "template": "/manga/{value}"
    },
    "title": {
     "path": "",
     "regex": "\"title\":(\"(?:[^\"\\\\]|\\\\.)*\")",
     "group": 1,
     "decode": "json"
    },
    "cover": {
     "path": "",
     "regex": "\"coverImage\":\"([^\"]+)\"",
     "group": 1
    }
   },
   "page_size": 20,
   "has_next": {
    "full": true
   }
  },
  "latest": {
   "request": {
    "url": "{base}/series?page={page}&sort=recent",
    "headers": {
     "rsc": "1"
    }
   },
   "format": "text",
   "items": "\\{(?=[^{}]*\"slug\":\"[^\"]+\")(?=[^{}]*\"title\":\")(?=[^{}]*\"coverImage\":)[^{}]*\\}",
   "fields": {
    "url": {
     "path": "",
     "regex": "\"slug\":\"([^\"]+)\"",
     "group": 1,
     "template": "/manga/{value}"
    },
    "title": {
     "path": "",
     "regex": "\"title\":(\"(?:[^\"\\\\]|\\\\.)*\")",
     "group": 1,
     "decode": "json"
    },
    "cover": {
     "path": "",
     "regex": "\"coverImage\":\"([^\"]+)\"",
     "group": 1
    }
   },
   "page_size": 20,
   "has_next": {
    "full": true
   }
  },
  "search": {
   "request": {
    "url": "{base}/series?page={page}&sort=title&q={query}",
    "headers": {
     "rsc": "1"
    }
   },
   "format": "text",
   "items": "\\{(?=[^{}]*\"slug\":\"[^\"]+\")(?=[^{}]*\"title\":\")(?=[^{}]*\"coverImage\":)[^{}]*\\}",
   "fields": {
    "url": {
     "path": "",
     "regex": "\"slug\":\"([^\"]+)\"",
     "group": 1,
     "template": "/manga/{value}"
    },
    "title": {
     "path": "",
     "regex": "\"title\":(\"(?:[^\"\\\\]|\\\\.)*\")",
     "group": 1,
     "decode": "json"
    },
    "cover": {
     "path": "",
     "regex": "\"coverImage\":\"([^\"]+)\"",
     "group": 1
    }
   },
   "page_size": 20,
   "has_next": {
    "full": true
   }
  },
  "details": {
   "request": {
    "url": "{abs_url}",
    "headers": {
     "rsc": "1"
    }
   },
   "format": "text",
   "let": {
    "desc": {
     "path": "",
     "regex": "\"manga\":\\{[^{}]*?\"description\":(\"(?:[^\"\\\\]|\\\\.)*\")",
     "group": 1,
     "decode": "json"
    },
    "alt_block": {
     "path": "",
     "regex": "\"manga\":\\{[^{}]*?\"alternativeTitles\":\\[([^\\]]*)\\]",
     "group": 1
    },
    "alt": {
     "const": "{l.alt_block}",
     "regex": "(\"(?:[^\"\\\\]|\\\\.)*\")",
     "group": 1,
     "regex_all": true,
     "decode": "json",
     "join": ", "
    },
    "type": {
     "path": "",
     "regex": "\"manga\":\\{[^{}]*?\"type\":\"([^\"]+)\"",
     "group": 1
    },
    "genre_block": {
     "path": "",
     "regex": "\"manga\":\\{[^{}]*?\"genres\":\\[([^\\]]*)\\]",
     "group": 1
    },
    "genre_names": {
     "const": "{l.genre_block}",
     "regex": "(\"(?:[^\"\\\\]|\\\\.)*\")",
     "group": 1,
     "regex_all": true,
     "decode": "json",
     "join": ", "
    }
   },
   "fields": {
    "title": {
     "path": "",
     "regex": "\"manga\":\\{[^{}]*?\"title\":(\"(?:[^\"\\\\]|\\\\.)*\")",
     "group": 1,
     "decode": "json"
    },
    "cover": {
     "path": "",
     "regex": "\"manga\":\\{[^{}]*?\"coverImage\":\"([^\"]+)\"",
     "group": 1
    },
    "author": {
     "path": "",
     "regex": "\"manga\":\\{[^{}]*?\"author\":(\"(?:[^\"\\\\]|\\\\.)*\")",
     "group": 1,
     "decode": "json"
    },
    "artist": {
     "path": "",
     "regex": "\"manga\":\\{[^{}]*?\"artist\":(\"(?:[^\"\\\\]|\\\\.)*\")",
     "group": 1,
     "decode": "json"
    },
    "status": {
     "path": "",
     "regex": "\"manga\":\\{[^{}]*?\"status\":\"([^\"]+)\"",
     "group": 1
    },
    "description": {
     "const": "[[{l.desc}]]\n\n[[Nombres alternativos: {l.alt}]]",
     "replace": [
      [
       "^\\n+|\\n+$",
       ""
      ]
     ]
    },
    "genres": {
     "const": "[[{l.type}, ]]{l.genre_names}",
     "replace": [
      [
       ", $",
       ""
      ]
     ]
    }
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "paused": 6
   }
  },
  "chapters": {
   "request": "details",
   "format": "text",
   "items": "\\{(?=[^{}]*\"number\":[0-9.]+)(?=[^{}]*\"createdAt\":\")(?=[^{}]*\"slug\":\"[^\"]+\")[^{}]*\\}",
   "fields": {
    "url": {
     "path": "",
     "regex": "\"slug\":\"([^\"]+)\"",
     "group": 1,
     "template": "{url}/{value}"
    },
    "name": {
     "path": "",
     "regex": "\"number\":([0-9]+(?:\\.[0-9]*[1-9])?)",
     "group": 1,
     "template": "Cap. {value}"
    },
    "number": {
     "path": "",
     "regex": "\"number\":([0-9.]+)",
     "group": 1
    },
    "date": {
     "path": "",
     "regex": "\"createdAt\":\"([^\"]+)\"",
     "group": 1
    }
   },
   "date_format": "iso"
  },
  "pages": {
   "request": {
    "url": "{abs_url}",
    "headers": {
     "rsc": "1"
    }
   },
   "format": "text",
   "block_regex": "\"pages\":\\[([^\\]]*)\\]",
   "items": "\"(https?://[^\"]+)\"",
   "image": ""
  }
 },
 "hinweise": [
  "Community liest alle Daten mit extractNextJs aus den Next.js-Flight-Daten; hier wie en.drakescans per Abruf mit Header rsc: 1 und Regex über den Text. Schlüsselreihenfolge unbekannt → Lookaheads; verschachtelte Objekte in einem Manga-/Kapitelobjekt würden die Regexe brechen (auf dem PC prüfen).",
  "Listen: /series?page=N&sort=rating|recent|title[&q=]. Community: weiter solange page*pageSize < total; hier 'full' mit angenommener Seitengröße 20 (UNSICHER).",
  "Eintrags-URL /manga/<slug>, Kapitel-URL /manga/<slug>/<kapitel-slug> (Community speichert ohne /manga/ – nicht kompatibel).",
  "Details aus dem Objekt \"manga\":{…}; Genres = Typ + Genres (Community: Typ mit großem Anfangsbuchstaben); Beschreibung + 'Nombres alternativos'.",
  "Kapitelname 'Cap. <Nummer ohne .0>'. Seiten = Liste chapter.pages (erste \"pages\":[…] im Strom).",
  "Filter (Genre, Status, Demografie, Typ, +18, Sortierung) nicht nachgebaut."
 ]
}
