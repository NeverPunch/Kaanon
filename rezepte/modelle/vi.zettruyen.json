{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "ZetTruyen",
  "sprache": "vi",
  "base_url": "https://www.zettruyen5.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.vi.kaanon.zettruyen",
  "quellen": [
   {
    "name": "ZetTruyen",
    "sprache": "vi",
    "quell_id": 893747327087652119,
    "home": "https://www.zettruyen5.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/vi/zettruyen",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.17",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/tim-kiem-nang-cao?page={page}&sort=rating",
   "items": "div.grid a[href*=/truyen-tranh/]",
   "fields": {
    "url": "@href",
    "title": "span.line-clamp-2",
    "cover": "img@src"
   },
   "page_size": 1,
   "has_next": {
    "full": true
   }
  },
  "latest": {
   "request": "{base}/tim-kiem-nang-cao?page={page}&sort=latest",
   "items": "div.grid a[href*=/truyen-tranh/]",
   "fields": {
    "url": "@href",
    "title": "span.line-clamp-2",
    "cover": "img@src"
   },
   "page_size": 1,
   "has_next": {
    "full": true
   }
  },
  "search": {
   "request": "{base}/tim-kiem-nang-cao?name={query}&page={page}&sort=latest",
   "items": "div.grid a[href*=/truyen-tranh/]",
   "fields": {
    "url": "@href",
    "title": "span.line-clamp-2",
    "cover": "img@src"
   },
   "page_size": 1,
   "has_next": {
    "full": true
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1",
    "cover": "img[src*=/thumb/]@src",
    "author": "div:not(header div):matchesOwn(^Tác giả$) + *, span:not(header span):matchesOwn(^Tác giả$) + *, p:not(header p):matchesOwn(^Tác giả$) + *",
    "status": {
     "path": "div:not(header div):matchesOwn(^Trạng thái$) + *, span:not(header span):matchesOwn(^Trạng thái$) + *, p:not(header p):matchesOwn(^Trạng thái$) + *",
     "regex": "(?i)(đang tiến hành|hoàn thành)",
     "group": 1
    },
    "genres": {
     "path": "div:not(header div):matchesOwn(^Thể loại$) + * a, span:not(header span):matchesOwn(^Thể loại$) + * a",
     "all": true,
     "join": ", "
    },
    "description": "p.comic-content"
   },
   "status_map": {
    "đang tiến hành": 1,
    "hoàn thành": 2
   }
  },
  "chapters": {
   "request": {
    "url": "{base}/api/comics/{u.slug}/chapters?page={page}&per_page=100&order=desc",
    "headers": {
     "Accept": "application/json"
    }
   },
   "format": "json",
   "url_vars": {
    "slug": "/truyen-tranh/([^/?#]+)"
   },
   "items": "data.chapters",
   "fields": {
    "url": {
     "path": "chapter_slug",
     "replace": [
      [
       "chapter-",
       "chuong-"
      ]
     ],
     "template": "/truyen-tranh/{u.slug}/{value}"
    },
    "name": "chapter_name",
    "date": {
     "path": "updated_at",
     "regex": "^([^.]+)",
     "group": 1
    }
   },
   "date_format": "yyyy-MM-dd'T'HH:mm:ss",
   "paging": {
    "has_next": {
     "lt": [
      "data.current_page",
      "data.last_page"
     ]
    },
    "max_pages": 50
   }
  },
  "pages": {
   "request": "{abs_url}",
   "items": [
    "div.center img",
    "div.w-full.mx-auto.center img"
   ],
   "image": "@src"
  }
 },
 "hinweise": [
  "Alle Listen über /tim-kiem-nang-cao?page=N&sort=… (Beliebt rating, Neueste latest, Suche name=…) wie Community; nächste Seite, solange Einträge kommen (Community: Liste nicht leer). Status/Typ/Genre-Filter nicht übernommen.",
  "Details: Autor/Status = Element nach dem Beschriftungselement ('Tác giả'/'Trạng thái', eigener Text), Genres nach 'Thể loại' außerhalb von header – per :matchesOwn nachgebaut, prüfen.",
  "Kapitel über /api/comics/<slug>/chapters (100 je Seite, data.current_page < data.last_page); Kapitel-URL /truyen-tranh/<slug>/<chapter_slug mit chapter- → chuong->.",
  "Datum updated_at ohne Sekundenbruchteile (Community-Zeitzone Asia/Ho_Chi_Minh)."
 ]
}
