{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Hentai Tokyo",
  "sprache": "pt-BR",
  "base_url": "https://hentaitokyo.net",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.pt-BR.kaanon.hentaitokyo",
  "quellen": [
   {
    "name": "Hentai Tokyo",
    "sprache": "pt-BR",
    "quell_id": 7059984733794571635,
    "home": "https://hentaitokyo.net"
   }
  ]
 },
 "quelle": {
  "modul": "src/pt/hentaitokyo",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "gattsu"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Accept-Language": "pt-BR,pt;q=0.9,en-US;q=0.8,en;q=0.7,es;q=0.6,gl;q=0.5"
  },
  "rate_limit": {
   "permits": 1,
   "period_ms": 2000
  },
  "popular": {
   "request": "{base}/page/{page}",
   "request_by_page": {
    "1": "{base}/"
   },
   "items": "div.meio div.lista ul li a[href^='https://hentaitokyo.net']",
   "has_next": {
    "exists": "ul.paginacao li.next > a"
   },
   "fields": {
    "url": "@href",
    "title": "span.thumb-titulo",
    "cover": "span.thumb-imagem img.wp-post-image@src"
   }
  },
  "search": {
   "request": "{base}/page/{page}/?s={query}&post_type=post",
   "items": "div.meio div.lista ul li a[href^='https://hentaitokyo.net']",
   "has_next": {
    "exists": "ul.paginacao li.next > a"
   },
   "fields": {
    "url": "@href",
    "title": "span.thumb-titulo",
    "cover": "span.thumb-imagem img.wp-post-image@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "div.meio div.post-box h1.post-titulo",
    "cover": {
     "path": "div.meio div.post-box div.post-capa > img.wp-post-image@src",
     "replace": [
      [
       "-\\d+x\\d+\\.",
       "."
      ]
     ]
    },
    "description": {
     "path": "div.meio div.post-box div.post-texto p",
     "all": true,
     "join": "\n\n",
     "replace": [
      [
       "Sinopse :",
       ""
      ],
      [
       "^\\s+|\\s+$",
       ""
      ]
     ]
    },
    "author": "div.meio div.post-box ul.post-itens li:contains(Artista) a",
    "genres": {
     "path": "div.meio div.post-box ul.post-itens li:contains(Tags) a",
     "all": true,
     "join": ", "
    },
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "div.meio:has(ul.post-fotos li a > img, div.post-box.listaImagens div.galeriaHtml img) div.post-box:has(h1.post-titulo)",
   "let": {
    "pub": "meta[property=article:published_time]@content"
   },
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "const": "Capítulo único"
    },
    "scanlator": "ul.post-itens li:contains(Tradutor) a",
    "date": {
     "const": "{l.pub}",
     "regex": "^(\\d{4}-\\d{2}-\\d{2})"
    }
   },
   "date_format": "yyyy-MM-dd"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div.meio div.post-box ul.post-fotos li a > img, div.meio div.post-box.listaImagens div.galeriaHtml img",
   "image": [
    {
     "path": "@data-src",
     "replace": [
      [
       "-\\d+x\\d+\\.",
       "."
      ]
     ]
    },
    {
     "path": "@src",
     "replace": [
      [
       "-\\d+x\\d+\\.",
       "."
      ]
     ]
    }
   ],
   "referer": "chapter"
  }
 },
 "hinweise": [
  "Gattsu-Theme ohne eigene Overrides (nur Rate-Limit 1 Anfrage/2 s).",
  "Kein 'Neueste' (Theme: supportsLatest=false); 'Beliebt' ist die Startseite/Neuigkeitenliste: Seite 1 = {base}/, sonst {base}/page/N.",
  "Ein Kapitel je Werk ('Capítulo único', URL = Werk-URL). Theme liefert keine Kapitel, wenn die Seite keine Bilder hat – nachgebildet über ':has(...)' an div.meio (setzt :has mit Selektorliste in der Engine voraus).",
  "Datum aus meta article:published_time (nur yyyy-MM-dd) über chapters.let (wie Vorlage fr.scanvf); Status immer abgeschlossen.",
  "Bild- und Cover-URLs: Größenzusatz '-123x456.' wird entfernt; Bild-Referer = Kapitel-URL."
 ]
}
