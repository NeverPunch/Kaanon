{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "KingComiX",
  "sprache": "en",
  "base_url": "https://kingcomix.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.kingcomix",
  "quellen": [
   {
    "name": "KingComiX",
    "sprache": "en",
    "quell_id": 8953466777316975228,
    "home": "https://kingcomix.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/kingcomix",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.3",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/page/{page}/",
   "request_by_page": {
    "1": "{base}/"
   },
   "items": "div.entry, article.thumb-block",
   "fields": {
    "url": [
     "h2.information a@href",
     "a[title]@href"
    ],
    "title": [
     "h2.information a",
     "a[title]@title"
    ],
    "cover": "img@img"
   },
   "has_next": {
    "exists": ".pagination .current + a, .pagination a.next"
   }
  },
  "search": {
   "request": "{base}/page/{page}/?s={query}",
   "request_by_page": {
    "1": "{base}/?s={query}"
   },
   "items": "div.entry, article.thumb-block",
   "fields": {
    "url": [
     "h2.information a@href",
     "a[title]@href"
    ],
    "title": [
     "h2.information a",
     "a[title]@title"
    ],
    "cover": "img@img"
   },
   "has_next": {
    "exists": ".pagination .current + a, .pagination a.next"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1.singleTitle-h1, h1.widget-title",
    "author": "meta[name=author]@content",
    "genres": {
     "path": ".caTotal .tagsPost a.taxLink",
     "all": true,
     "join": ", "
    },
    "cover": [
     "meta[property=og:image]@content",
     ".entry-content img@img"
    ],
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "const": "Chapter"
    },
    "date": "meta[property=article:published_time]@content"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".entry-content img",
   "image": "@img"
  }
 },
 "hinweise": [
  "WordPress-Galerie: ein Eintrag = ein Kapitel ('Chapter', Datum aus article:published_time).",
  "Nächste Seite: Community prüft, ob ein Zahlenlink > aktuelle Seite in .pagination steht; hier '.current + a' bzw. a.next angenommen (auf dem PC prüfen).",
  "Kategorie-/Tag-Filter nicht übernommen; keine Neueste-Liste (Community auch nicht)."
 ]
}
