 "extension": {
  "name": "TruyenHentaivn",
  "sprache": "vi",
  "base_url": "https://truyenhentaivn.store",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.vi.kaanon.truyenhentaivn",
  "quellen": [
   {
    "name": "TruyenHentaivn",
    "sprache": "vi",
    "quell_id": 2450247754585878955,
    "home": "https://truyenhentaivn.store"
   }
  ]
 },
 "quelle": {
  "modul": "src/vi/truyenhentaivn",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.7",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/top-de-cu?page={page}",
   "items": "div.entry.text-center",
   "fields": {
    "url": "a.name@href",
    "title": [
     "a.name@title",
     "a.name"
    ],
    "cover": "a.s-thumb img@src"
   },
   "has_next": {
    "exists": ".z-pagination a.page-numbers[title=Next]"
   }
  },
  "latest": {
   "request": "{base}/danh-sach?page={page}",
   "items": "div.entry.text-center",
   "fields": {
    "url": "a.name@href",
    "title": [
     "a.name@title",
     "a.name"
    ],
    "cover": "a.s-thumb img@src"
   },
   "has_next": {
    "exists": ".z-pagination a.page-numbers[title=Next]"
   }
  },
  "search": {
   "request": "{base}/tim-kiem-truyen/?q={query}&page={page}",
   "items": "div.entry.text-center",
   "fields": {
    "url": "a.name@href",
    "title": [
     "a.name@title",
     "a.name"
    ],
    "cover": "a.s-thumb img@src"
   },
   "has_next": {
    "exists": ".z-pagination a.page-numbers[title=Next]"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": ".comic-info .info h1.name",
    "author": ".meta-data .author i",
    "genres": {
     "path": ".meta-data .genre a",
     "all": true,
     "join": ", "
    },
    "description": ".comic-description .inner",
    "status": {
     "path": ".tsinfo .imptdt:contains(Tình trạng) i",
     "regex": "(?i)(hoàn thành|đang tiến hành|đang cập nhật|tạm ngưng|tạm dừng|hiatus)",
     "group": 1
    },
    "cover": ".comic-info .book img@src"
   },
   "status_map": {
    "hoàn thành": 2,
    "đang tiến hành": 1,
    "đang cập nhật": 1,
    "tạm ngưng": 6,
    "tạm dừng": 6,
    "hiatus": 6
   }
  },
  "chapters": {
   "request": "details",
   "items": ".chap-list a.d-flex.justify-content-between",
   "fields": {
    "url": "@href",
    "name": "span.name",
    "date": [
     "span.name ~ span",
     "span:nth-of-type(2)"
    ]
   },
   "date_format": "dd-MM-yyyy"
  },
  "pages": {
   "request": "{abs_url}",
   "items": [
    ".chapter-content img",
    ".content-text img"
   ],
   "image": [
    {
     "path": "@data-src",
     "regex": "^((?!data:).+)$",
     "group": 1
    },
    {
     "path": "@src",
     "regex": "^((?!data:).+)$",
     "group": 1
    }
   ]
  }
 },
 "hinweise": [
  "Beliebt /top-de-cu, Neueste /danh-sach, Suche /tim-kiem-truyen/?q=… (jeweils ?page=N) wie Community; Genre-Filter nicht übernommen.",
  "Kapiteldatum: Community nimmt das 2. span im Link (dd-MM-yyyy); hier das auf span.name folgende span (Ausweich: span:nth-of-type(2)) – prüfen.",
  "Seiten: data-src, sonst src; data:-Platzhalter ignoriert. Doppelte (Community distinct) nicht entfernt."
 ]
}
