{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Colorized Mangas",
  "sprache": "en",
  "base_url": "https://colorizedmangas.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.colorizedmangas",
  "quellen": [
   {
    "name": "Colorized Mangas",
    "sprache": "en",
    "quell_id": 2348696469980851942,
    "home": "https://colorizedmangas.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/colorizedmangas",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/",
   "items": "div.lib-color-view a[href]:has(h3), div.lib-bw-view a[href]:has(h3)",
   "has_next": {
    "const": false
   },
   "fields": {
    "url": {
     "path": "@href",
     "regex": "([^/]+)/*$",
     "group": 1,
     "template": "/{value}"
    },
    "title": "h3",
    "cover": "img@src"
   }
  },
  "search": {
   "request": "{base}/",
   "items": "div.lib-color-view a[href]:has(h3), div.lib-bw-view a[href]:has(h3)",
   "has_next": {
    "const": false
   },
   "fields": {
    "url": {
     "path": "@href",
     "regex": "([^/]+)/*$",
     "group": 1,
     "template": "/{value}"
    },
    "title": "h3",
    "cover": "img@src"
   },
   "client_filter": true
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": {
     "path": "aside h1",
     "replace": [
      [
       "^\\s*Colorized\\s*",
       ""
      ]
     ]
    },
    "cover": "aside img@src",
    "author": "aside dl > div dt:contains(Author) + dd",
    "genres": {
     "path": "aside p.text-\\[11px\\]",
     "replace": [
      [
       "\\s*·\\s*",
       ", "
      ],
      [
       "^(, )+|(, )+$",
       ""
      ]
     ]
    },
    "description": "aside p.border-t"
   }
  },
  "chapters": {
   "request": "details",
   "items": "div.space-y-4 section div.space-y-2 > a:has(span.font-bold, div.truncate)",
   "fields": {
    "url": "@href",
    "name": {
     "path": "span.font-bold, div.truncate",
     "all": true,
     "join": " - "
    },
    "number": {
     "path": [
      "span.font-bold",
      "div.truncate"
     ],
     "regex": "(\\d+(?:\\.\\d+)?)",
     "group": 1
    }
   }
  },
  "pages": {
   "request": "{abs_url}",
   "items": "main img[src*=pages]",
   "image": "@src"
  }
 },
 "hinweise": [
  "Alle Titel stehen auf der Startseite (Farb- und S/W-Ansicht); Community entfernt doppelte Slugs – das Modell nicht, Doppelte möglich. Suche filtert lokal.",
  "Kapitelname = Nummer und Titel mit ' - ' verbunden (Community lässt den Titel weg, wenn er der Nummer gleicht). Community sortiert nach Kapitelnummer absteigend; hier Reihenfolge der Seite.",
  "Keine Neuheiten (Community liefert dort dieselbe Liste)."
 ]
}
