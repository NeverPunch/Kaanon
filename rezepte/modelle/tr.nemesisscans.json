{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Nemesis scans",
  "sprache": "tr",
  "base_url": "https://nemesisscans.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.tr.kaanon.nemesisscans",
  "quellen": [
   {
    "name": "Nemesisscans",
    "sprache": "tr",
    "quell_id": 4325951682189741537,
    "home": "https://nemesisscans.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/tr/nemesisscans",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "https://yahsirou.xyz/series/browse?sort=newest&page={page}",
   "format": "json",
   "items": "data",
   "fields": {
    "url": {
     "path": "_id",
     "template": "/series/{value}"
    },
    "title": [
     "title.english",
     "title.romaji"
    ],
    "cover": "poster"
   },
   "has_next": {
    "lt": [
     "pagination.page",
     "pagination.pages"
    ]
   }
  },
  "latest": {
   "request": "https://yahsirou.xyz/latestepisodes?limit=50",
   "format": "json",
   "items": "data",
   "fields": {
    "url": {
     "path": "series._id",
     "template": "/series/{value}"
    },
    "title": [
     "series.title.english",
     "series.title.romaji"
    ],
    "cover": "series.poster"
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": "https://yahsirou.xyz/series/search?q={query}&page={page}",
   "format": "json",
   "items": "data",
   "fields": {
    "url": {
     "path": "_id",
     "template": "/series/{value}"
    },
    "title": [
     "title.english",
     "title.romaji"
    ],
    "cover": "poster"
   },
   "has_next": {
    "lt": [
     "pagination.page",
     "pagination.pages"
    ]
   }
  },
  "details": {
   "request": "https://yahsirou.xyz/series/{u.id}",
   "format": "json",
   "url_vars": {
    "id": "/series/(\\d+)"
   },
   "let": {
    "fin": "series.isFinished",
    "st": "series.status"
   },
   "fields": {
    "title": [
     "series.title.english",
     "series.title.romaji"
    ],
    "cover": "series.poster",
    "description": {
     "path": "series.description",
     "replace": [
      [
       "\\n",
       ""
      ]
     ],
     "decode": "html_text"
    },
    "genres": {
     "path": "series.genres.*",
     "all": true,
     "join": ", "
    },
    "status": {
     "const": "{l.fin}|{l.st}",
     "replace": [
      [
       "^true\\|.*$",
       "finished"
      ],
      [
       "^[^|]*\\|",
       ""
      ]
     ]
    }
   },
   "status_map": {
    "finished": 2,
    "releasing": 1,
    "hiatus": 6,
    "cancelled": 5
   }
  },
  "chapters": {
   "request": "details",
   "format": "json",
   "url_vars": {
    "id": "/series/(\\d+)"
   },
   "items": "episodes",
   "fields": {
    "url": {
     "path": "episodeNumber",
     "replace": [
      [
       "\\.0+$",
       ""
      ]
     ],
     "template": "/series/{u.id}/episode/{value}"
    },
    "name": {
     "const": "Bölüm {f.episodeNumber}[[ - {f.episodeName}]]",
     "replace": [
      [
       "^(Bölüm \\d+)\\.0+(?=\\D|$)",
       "$1"
      ]
     ]
    },
    "number": "episodeNumber",
    "date": "createdAt"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "https://yahsirou.xyz/series/{u.id}/episodes/{u.ep}",
   "format": "json",
   "url_vars": {
    "id": "/series/(\\d+)/",
    "ep": "/episode/([^/?#]+)"
   },
   "items": "episode.images",
   "sort": "order",
   "image": "url"
  }
 },
 "hinweise": [
  "JSON-API yahsirou.xyz wie Community: Beliebt /series/browse?sort=newest (Community-Standard, keine echte Beliebtheitssortierung), Suche /series/search?q=, Neueste /latestepisodes?limit=50 (eine Seite; doppelte Serien werden nicht entfernt, Community: distinctBy). Genre-Filter/Sortierung nicht übernommen.",
  "Eintrags-URL /series/<id>, Kapitel-URL /series/<id>/episode/<nummer> (Web-URLs wie Community; Community speichert '<id>' bzw. '<id>/<nummer>').",
  "Status: isFinished=true → abgeschlossen, sonst status (RELEASING/FINISHED/HIATUS/CANCELLED). Beschreibung HTML → Text.",
  "Kapitel in API-Reihenfolge (Community sortiert absteigend nach Nummer). Seiten nach order sortiert."
 ]
}
