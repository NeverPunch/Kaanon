{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Yomu Mangás",
  "sprache": "pt-BR",
  "base_url": "https://yomumangas.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.pt-BR.kaanon.yomumangas",
  "quellen": [
   {
    "name": "Yomu Mangás",
    "sprache": "pt-BR",
    "quell_id": 1636954121036022614,
    "home": "https://yomumangas.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/pt/yomumangas",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "https://api.yomumangas.com/search/medias?page={page}",
   "format": "json",
   "items": "mangas",
   "fields": {
    "url": {
     "path": "id",
     "template": "/mangas/{value}/{f.slug}"
    },
    "title": "title",
    "cover": {
     "path": "cover",
     "replace": [
      [
       "^b2://",
       "https://b2.yomumangas.com/"
      ]
     ]
    }
   },
   "has_next": {
    "exists": "mangas.0"
   }
  },
  "latest": {
   "request": "https://api.yomumangas.com/home/updates?page={page}",
   "format": "json",
   "items": "medias",
   "fields": {
    "url": {
     "path": "id",
     "template": "/mangas/{value}/{f.slug}"
    },
    "title": "title",
    "cover": {
     "path": "cover",
     "replace": [
      [
       "^b2://",
       "https://b2.yomumangas.com/"
      ]
     ]
    }
   },
   "has_next": {
    "exists": "medias.0"
   }
  },
  "search": {
   "request": "https://api.yomumangas.com/search/medias?page={page}&q={query}",
   "format": "json",
   "items": "mangas",
   "fields": {
    "url": {
     "path": "id",
     "template": "/mangas/{value}/{f.slug}"
    },
    "title": "title",
    "cover": {
     "path": "cover",
     "replace": [
      [
       "^b2://",
       "https://b2.yomumangas.com/"
      ]
     ]
    }
   },
   "has_next": {
    "exists": "mangas.0"
   }
  },
  "details": {
   "request": "https://api.yomumangas.com/mangas/{u.id}",
   "format": "json",
   "url_vars": {
    "id": "/mangas/(\\d+)",
    "slug": "/mangas/\\d+/([^/?#]+)"
   },
   "fields": {
    "title": "manga.title",
    "cover": {
     "path": "manga.cover",
     "replace": [
      [
       "^b2://",
       "https://b2.yomumangas.com/"
      ]
     ]
    },
    "author": {
     "path": "manga.authors",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "manga.artists",
     "all": true,
     "join": ", "
    },
    "description": "manga.description",
    "genres": {
     "path": [
      "manga.genres.*.name",
      "manga.tags.*.name"
     ],
     "union": true
    },
    "status": "manga.status"
   },
   "status_map": {
    "ONGOING": 1,
    "COMPLETE": 2,
    "HIATUS": 6,
    "CANCELLED": 5,
    "ongoing": 1,
    "complete": 2,
    "hiatus": 6,
    "cancelled": 5
   }
  },
  "chapters": {
   "request": "https://api.yomumangas.com/mangas/{u.id}/chapters",
   "format": "json",
   "url_vars": {
    "id": "/mangas/(\\d+)",
    "slug": "/mangas/\\d+/([^/?#]+)"
   },
   "items": "chapters",
   "fields": {
    "url": {
     "path": "chapter",
     "template": "/mangas/{u.id}/{u.slug}/{value}"
    },
    "name": {
     "path": "chapter",
     "template": "Capítulo {value}[[ - {f.title}]]"
    },
    "number": "chapter",
    "date": "uploaded_at"
   },
   "date_format": "iso",
   "reverse": true
  },
  "pages": {
   "request": "{abs_url}",
   "format": "text",
   "items": "(b2://chapters/[^\"\\\\]+)",
   "image": {
    "path": "",
    "replace": [
     [
      "^b2://",
      "https://b2.yomumangas.com/"
     ]
    ]
   }
  }
 },
 "hinweise": [
  "API api.yomumangas.com: Beliebt = /search/medias ohne Filter, Neueste /home/updates, Details /mangas/<id>, Kapitel /mangas/<id>/chapters. Typ-/Status-/NSFW-/Genre-/Tag-Filter nicht übernommen.",
  "Nächste Seite: Community vergleicht mit 'pages' (Suche) bzw. fest bis Seite 20 (Neueste); die aktuelle Seitennummer steht nicht im JSON → hier 'solange die Seite nicht leer ist' (exists auf erstes Element; eine leere Zusatzseite am Ende).",
  "Manga-URL /mangas/<id>/<slug> (Website-Pfad; Community speichert '<id>#<slug>'). b2://-Adressen → https://b2.yomumangas.com/.",
  "Kapitelname 'Capítulo N - Titel' (Community entfernt zusätzlich ein führendes '-' im Titel). Seiten: alle b2://chapters/…-Treffer im HTML der Leseseite."
 ]
}