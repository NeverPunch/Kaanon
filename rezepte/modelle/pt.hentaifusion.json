{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Hentai Fusion",
  "sprache": "pt",
  "base_url": "https://hentaifusion.me",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.pt.kaanon.hentaifusion",
  "quellen": [
   {
    "name": "Hentai Fusion",
    "sprache": "pt",
    "quell_id": 5510466202623942394,
    "home": "https://hentaifusion.me"
   }
  ]
 },
 "quelle": {
  "modul": "src/pt/hentaifusion",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/page/{page}",
   "request_by_page": {
    "1": "{base}/"
   },
   "items": "div.lista > ul > li:has(div.thumb-conteudo > a)",
   "skip": {
    "path": "div.thumb-conteudo > a@href",
    "regex": "^https?://(?![^/]*hentaifusion\\.me)"
   },
   "fields": {
    "url": "div.thumb-conteudo > a@href",
    "title": [
     "div.thumb-conteudo > a@title",
     "span.thumb-titulo"
    ],
    "cover": "div.thumb-conteudo > a img@src"
   },
   "has_next": {
    "exists": "a:contains(Próxima página)"
   }
  },
  "search": {
   "request": "{base}/?s={query}&paged={page}",
   "request_by_page": {
    "1": "{base}/?s={query}"
   },
   "items": "div.lista > ul > li:has(div.thumb-conteudo > a)",
   "skip": {
    "path": "div.thumb-conteudo > a@href",
    "regex": "^https?://(?![^/]*hentaifusion\\.me)"
   },
   "fields": {
    "url": "div.thumb-conteudo > a@href",
    "title": [
     "div.thumb-conteudo > a@title",
     "span.thumb-titulo"
    ],
    "cover": "div.thumb-conteudo > a img@src"
   },
   "has_next": {
    "exists": "a:contains(Próxima página)"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1.post-titulo",
    "cover": "div.post-capa img@src",
    "description": "div.post-texto p",
    "genres": "ul.post-itens a[href*='/category/'], ul.post-itens a[href*='/tag/']"
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "let": {
    "pub": "meta[property='article:published_time']@content"
   },
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "const": "Oneshot"
    },
    "date": {
     "const": "{l.pub}"
    }
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "ul.post-fotos > li > img",
   "image": [
    "@data-src",
    "@src"
   ]
  }
 },
 "hinweise": [
  "Beliebt = Startseite /[page/N], Suche /?s=…[&paged=N]; Werbeeintrag mit fremdem Host wird übersprungen. Keine Neueste-Liste (wie Community); Kategorie-Filter nicht nachgebaut.",
  "Jeder Beitrag = ein Oneshot-Kapitel (Datum aus article:published_time).",
  "Beschreibung nur Synopse; Community hängt die Zeilen aus ul.post-itens an."
 ]
}
