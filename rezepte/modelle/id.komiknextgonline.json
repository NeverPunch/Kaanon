{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Komik Next G Online",
  "sprache": "id",
  "base_url": "https://komiknextgonline.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.id.kaanon.komiknextgonline",
  "quellen": [
   {
    "name": "Komik Next G Online",
    "sprache": "id",
    "quell_id": 5850393134813310906,
    "home": "https://komiknextgonline.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/id/komiknextgonline",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/comic/page/{page}/",
   "items": "span.comic-thumbnail-wrapper:has(a):has(img)",
   "fields": {
    "url": "a@href",
    "title": {
     "path": "img@alt",
     "replace": [
      [
       "(?i)\\s+cover$",
       ""
      ]
     ]
    },
    "cover": "img@src"
   },
   "has_next": {
    "exists": ".nav-previous a"
   }
  },
  "search": {
   "request": "{base}/page/{page}/?s={query}",
   "request_by_page": {
    "1": "{base}/?s={query}"
   },
   "items": "#left-content ul#comic-list li.comic, #left-content article.comic",
   "fields": {
    "url": "a@href",
    "title": {
     "path": ".comic-title, .entry-title",
     "replace": [
      [
       "^#\\d+\\.\\s*",
       ""
      ]
     ]
    },
    "cover": "img@src"
   },
   "has_next": {
    "exists": "a.next.page-numbers"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": {
     "path": "meta[property=og:title]@content",
     "replace": [
      [
       " - .*$",
       ""
      ]
     ]
    },
    "description": "meta[property=og:description]@content",
    "cover": "meta[property=og:image]@content",
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": [
     "meta[property=og:url]@content",
     {
      "const": "{url}"
     }
    ],
    "name": {
     "const": "Chapter 1"
    },
    "date": "meta[property=article:published_time]@content"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div#spliced-comic img",
   "image": "@src"
  }
 },
 "hinweise": [
  "Einzelne Comics (ein Kapitel 'Chapter 1' = die Comic-Seite selbst, URL aus og:url). Beliebt = Archiv /comic/page/N/ (nur Cover, Titel aus alt ohne ' cover'); 'Weiter' ist dort .nav-previous (wie Community).",
  "Suche: /?s=… bzw. /page/N/?s=…; Kategorie-Filter nicht übernommen. Titel = og:title bis ' - '."
 ]
}
