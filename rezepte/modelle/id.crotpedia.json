{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "CrotPedia",
  "sprache": "id",
  "base_url": "https://crotpedia.net",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.id.kaanon.crotpedia",
  "quellen": [
   {
    "name": "CrotPedia",
    "sprache": "id",
    "quell_id": 4023890583976163058,
    "home": "https://crotpedia.net"
   }
  ]
 },
 "quelle": {
  "modul": "src/id/crotpedia",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.6",
  "theme": "zmanga"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/advanced-search/page/{page}/?order=popular",
   "request_by_page": {
    "1": "{base}/advanced-search/?order=popular"
   },
   "items": "div.flexbox2-item",
   "has_next": {
    "exists": "div.pagination .next"
   },
   "fields": {
    "url": "div.flexbox2-content a@href",
    "title": "div.flexbox2-title > span",
    "cover": "img@src"
   }
  },
  "latest": {
   "request": "{base}/advanced-search/page/{page}/?order=update",
   "request_by_page": {
    "1": "{base}/advanced-search/?order=update"
   },
   "items": "div.flexbox2-item",
   "has_next": {
    "exists": "div.pagination .next"
   },
   "fields": {
    "url": "div.flexbox2-content a@href",
    "title": "div.flexbox2-title > span",
    "cover": "img@src"
   }
  },
  "search": {
   "request": "{base}/advanced-search/page/{page}/?title={query}",
   "request_by_page": {
    "1": "{base}/advanced-search/?title={query}"
   },
   "items": "div.flexbox2-item",
   "has_next": {
    "exists": "div.pagination .next"
   },
   "fields": {
    "url": "div.flexbox2-content a@href",
    "title": "div.flexbox2-title > span",
    "cover": "img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "let": {
    "alt": ".series-title span@ownText"
   },
   "fields": {
    "cover": "div.series-thumb img@img",
    "author": ".series-infolist li:contains(Author) span",
    "artist": ".series-infolist li:contains(Artist) span",
    "status": ".series-infoz .status@ownText",
    "description": {
     "path": "div.series-synops",
     "template": "{value}[[\n\nAlternative Name: {l.alt}]]"
    },
    "genres": {
     "path": [
      "div.series-genres a",
      "div.block span.type@ownText"
     ],
     "union": true
    }
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "ul.series-chapterlist div.flexch-infoz a",
   "fields": {
    "url": "@href",
    "name": "span@ownText",
    "date": "span.date"
   },
   "date_format": "MMMM dd, yyyy",
   "date_locale": "id"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div.reader-area img:not(noscript img)",
   "image": {
    "path": "@img",
    "replace": [
     [
      "\\\\",
      ""
     ]
    ]
   }
  }
 },
 "hinweise": [
  "Theme ZManga: Listen über /advanced-search/[page/N/]?order=popular|update bzw. ?title=<text>; Seite 1 ohne page-Segment (request_by_page).",
  "Typ (div.block span.type) wird wie in der Community an die Genres angehängt (Community nur, wenn nicht schon enthalten und nicht '-').",
  "Bilder: data-lazy-src oder src, Backslashes entfernt.",
  "Filter (Autor/Jahr/Status/Typ/Genre) nicht abgebildet.",
  "Datum 'MMMM dd, yyyy' mit Locale id (indonesische Monatsnamen); date_locale 'id' kommt in keiner Vorlage vor – prüfen."
 ]
}