{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "TruyenQQ VN",
  "sprache": "vi",
  "base_url": "https://truyenqq.com.vn",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.vi.kaanon.truyenqqvn",
  "quellen": [
   {
    "name": "TruyenQQ VN",
    "sprache": "vi",
    "quell_id": 5606661657341898331,
    "home": "https://truyenqq.com.vn"
   }
  ]
 },
 "quelle": {
  "modul": "src/vi/truyenqqvn",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.3",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Referer": "{base}/"
  },
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/truyen-hot?page={page}",
   "request_by_page": {
    "1": "{base}/truyen-hot"
   },
   "items": ".inner .item",
   "has_next": {
    "min": 1
   },
   "fields": {
    "url": ".info h3 a@href",
    "title": ".info h3 a",
    "cover": ".cover img@src"
   }
  },
  "latest": {
   "request": "{base}/truyen-moi?page={page}",
   "request_by_page": {
    "1": "{base}/truyen-moi"
   },
   "items": ".inner .item",
   "has_next": {
    "min": 1
   },
   "fields": {
    "url": ".info h3 a@href",
    "title": ".info h3 a",
    "cover": ".cover img@src"
   }
  },
  "search": {
   "request": "{base}/tim-kiem?s={query}&page={page}",
   "request_by_page": {
    "1": "{base}/tim-kiem?s={query}"
   },
   "items": ".inner .item",
   "has_next": {
    "min": 1
   },
   "fields": {
    "url": ".info h3 a@href",
    "title": ".info h3 a",
    "cover": ".cover img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1[itemprop=name]",
    "cover": ".book-info .poster img@src",
    "description": "[itemprop=description]",
    "author": {
     "path": ".book-meta .line:has(.title:contains(Tác giả)) .result",
     "replace": [
      [
       "^Đang cập nhật$",
       ""
      ]
     ]
    },
    "genres": {
     "path": ".book-meta a[href*=/the-loai/]",
     "all": true,
     "join": ", "
    },
    "status": ".label-status"
   },
   "status_map": {
    "đang ra": 1,
    "hoàn thành": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": ".reading-list .item",
   "fields": {
    "url": "a@href",
    "name": "a",
    "date": ".item-time"
   },
   "date_format": [
    "relative",
    "dd/MM/yyyy"
   ],
   "date_locale": "vi"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "img.lazy[data-src]",
   "image": "@data-src"
  }
 },
 "hinweise": [
  "Beliebt /truyen-hot, Neueste /truyen-moi, Suche /tim-kiem?s=… (Seite über ?page=n, Seite 1 ohne). Genre-/Listenfilter nicht übernommen.",
  "has_next: Community sucht einen Pagination-Link mit page=<n+1> (Seite+1 nicht ausdrückbar) – hier 'min: 1' (weiter, solange Einträge kommen).",
  "Datum: relativ ('… giờ trước', vi) oder dd/MM/yyyy; 'hôm qua' (gestern) wird evtl. nicht erkannt.",
  "Manche Serien verlangen zum Lesen eine Google-Anmeldung (Community: Hinweis auf WebView-Login); diese Kapitel liefern hier keine Bilder – kein Login im Rezept (Regel 0014)."
 ]
}
