{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "FoxTruyen",
  "sprache": "vi",
  "base_url": "https://foxtruyen2.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.vi.kaanon.foxtruyen",
  "quellen": [
   {
    "name": "FoxTruyen",
    "sprache": "vi",
    "quell_id": 1458993267006200127,
    "home": "https://foxtruyen2.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/vi/truyengg",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.14",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 1,
   "period_ms": 2000
  },
  "popular": {
   "request": "{base}/top-binh-chon/trang-{page}.html",
   "request_by_page": {
    "1": "{base}/top-binh-chon"
   },
   "items": ".list_item_home .item_home",
   "fields": {
    "url": "a.book_name@href",
    "title": "a.book_name",
    "cover": ".image-cover img@data-src"
   },
   "has_next": {
    "exists": ".pagination a.active + a"
   }
  },
  "latest": {
   "request": "{base}/truyen-moi-cap-nhat/trang-{page}.html",
   "request_by_page": {
    "1": "{base}/truyen-moi-cap-nhat"
   },
   "items": ".list_item_home .item_home",
   "fields": {
    "url": "a.book_name@href",
    "title": "a.book_name",
    "cover": ".image-cover img@data-src"
   },
   "has_next": {
    "exists": ".pagination a.active + a"
   }
  },
  "search": {
   "request": "{base}/tim-kiem/trang-{page}.html?q={query}",
   "request_by_page": {
    "1": "{base}/tim-kiem?q={query}"
   },
   "items": ".list_item_home .item_home",
   "fields": {
    "url": "a.book_name@href",
    "title": "a.book_name",
    "cover": ".image-cover img@data-src"
   },
   "has_next": {
    "exists": ".pagination a.active + a"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1[itemprop=name]",
    "author": "span:contains(Tác Giả) + span",
    "genres": {
     "path": ".fx-genres a",
     "all": true,
     "join": ", "
    },
    "description": "div.fx-synopsis div",
    "cover": ".fx-cover img@src",
    "status": {
     "path": ".fx-status",
     "regex": "(?i)(đang cập nhật|đang tiến hành|còn tiếp|đang ra|đã hoàn thành|hoàn thành|hoàn|tạm ngưng|tạm hoãn|bị drop)",
     "group": 1
    }
   },
   "status_map": {
    "đang cập nhật": 1,
    "đang tiến hành": 1,
    "còn tiếp": 1,
    "đang ra": 1,
    "đã hoàn thành": 2,
    "hoàn thành": 2,
    "hoàn": 2,
    "tạm ngưng": 6,
    "tạm hoãn": 6,
    "bị drop": 6
   }
  },
  "chapters": {
   "request": "details",
   "items": "ul.fx-chap-list li.fx-chap-item",
   "fields": {
    "url": "a@href",
    "name": "a",
    "date": "span.fx-chap-item__date"
   },
   "date_format": "dd/MM/yyyy"
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".content_detail img",
   "image": "@src"
  }
 },
 "hinweise": [
  "Website heißt inzwischen FoxTruyen (foxtruyen2.com), Modul truyengg. Listen /top-binh-chon, /truyen-moi-cap-nhat, Suche /tim-kiem?q=… jeweils /trang-N.html ab Seite 2 wie Community; erweiterte Filter nicht übernommen.",
  "Rate-Limit 1 Anfrage je 2 s (Community: nur für den Website-Host, hier global).",
  "Status: Community prüft 'enthält' mehrerer Wörter; hier per Regex auf diese Wörter abgebildet."
 ]
}
