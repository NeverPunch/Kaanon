{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "MomonGA",
  "sprache": "ja",
  "base_url": "https://momon-ga.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.ja.kaanon.momonga",
  "quellen": [
   {
    "name": "momon:GA",
    "sprache": "ja",
    "quell_id": 5332628982027198645,
    "home": "https://momon-ga.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/ja/momonga",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/popularity/page/{page}/",
   "request_by_page": {
    "1": "{base}/popularity/"
   },
   "items": "div.post-list > a",
   "fields": {
    "url": "@href",
    "title": "span",
    "cover": "div.post-list-image > img@src"
   },
   "has_next": {
    "exists": "div.wp-pagenavi > a.nextpostslink"
   }
  },
  "search": {
   "request": "{base}/page/{page}/?s={query}",
   "request_by_page": {
    "1": "{base}/?s={query}"
   },
   "items": "div.post-list > a",
   "fields": {
    "url": "@href",
    "title": "span",
    "cover": "div.post-list-image > img@src"
   },
   "has_next": {
    "exists": "div.wp-pagenavi > a.nextpostslink"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "#post-data > h1",
    "cover": "#post-hentai > img@src",
    "artist": {
     "path": "#post-tag > div.post-tag-table:has(div.post-tag-title:matchesOwn(^サークル$)) div.post-tags > a",
     "all": true,
     "join": ", "
    },
    "author": {
     "path": "#post-tag > div.post-tag-table:has(div.post-tag-title:matchesOwn(^作者$)) div.post-tags > a",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": "#post-tag > div.post-tag-table:has(div.post-tag-title:matchesOwn(^内容$)) div.post-tags > a",
     "all": true,
     "join": ", "
    },
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "const": "単一章"
    },
    "number": {
     "const": "1"
    },
    "date": "#post-time"
   },
   "date_format": "yyyy年M月d日H時"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "#post-hentai > img",
   "image": "@src"
  }
 },
 "hinweise": [
  "Galerie-Website: ein Kapitel '単一章' mit der Eintrags-URL (Community: Pfad nach Weiterleitung), Datum aus #post-time (yyyy年M月d日H時).",
  "Beliebt: /popularity/ mit WordPress-Seiten /popularity/page/N/ (Community lädt immer nur /popularity/ – Seitenmuster angenommen). Suche ?s=… bzw. /page/N/?s=….",
  "Kategorie-Filter (fanzine/magazine/trend/rated) nicht übernommen. Status immer abgeschlossen."
 ]
}
