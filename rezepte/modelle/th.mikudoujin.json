{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "MikuDoujin",
  "sprache": "th",
  "base_url": "https://miku-doujin.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.th.kaanon.mikudoujin",
  "quellen": [
   {
    "name": "MikuDoujin",
    "sprache": "th",
    "quell_id": 3142948916822290453,
    "home": "https://miku-doujin.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/th/mikudoujin",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.9",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/?page={page}",
   "items": "div.col-6.inz-col",
   "fields": {
    "url": "a@href",
    "title": "a div.inz-title",
    "cover": "a img@src"
   },
   "has_next": {
    "exists": "button.btn-secondary:contains(Older):not([disabled])"
   }
  },
  "search": {
   "request": {
    "url": "{base}/controller/search/general/",
    "method": "POST",
    "form": {
     "keysearch": "{query_raw}"
    }
   },
   "items": "div.col-6.inz-col",
   "fields": {
    "url": "a@href",
    "title": "a div.inz-title",
    "cover": "a img@src"
   },
   "has_next": {
    "const": false
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "title",
    "cover": "div.sr-card-body div.col-md-4 img@src",
    "author": {
     "path": "div.sr-card-body div.col-md-8 p a.badge-secondary@ownText",
     "all": true,
     "join": "|",
     "regex": "^[^|]*\\|[^|]*\\|([^|]+)",
     "group": 1
    },
    "artist": {
     "path": "div.sr-card-body div.col-md-8 p a.badge-secondary@ownText",
     "all": true,
     "join": "|",
     "regex": "^[^|]*\\|[^|]*\\|([^|]+)",
     "group": 1
    },
    "genres": {
     "path": "div.sr-card-body div.col-md-8 div.tags a",
     "all": true,
     "join": ", "
    },
    "description": "div.sr-card-body div.col-md-8@ownText",
    "status": {
     "path": "table.table-episode tr td a",
     "all": true,
     "join": "|",
     "default": "completed",
     "replace": [
      [
       "(?s)^.*\\sจบ\\s*(\\||$).*$",
       "completed"
      ],
      [
       "(?s)^(?!completed$).*$",
       "unknown"
      ]
     ]
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": [
    "table.table-episode tr:has(td a)",
    "html"
   ],
   "fields": {
    "url": [
     "td a@href",
     {
      "const": "{url}"
     }
    ],
    "name": [
     "td a",
     {
      "const": "Chapter 1"
     }
    ],
    "number": [
     {
      "path": "td a",
      "regex": "(\\d+(?:\\.\\d+)?)\\s*$",
      "group": 1
     },
     {
      "const": "1"
     }
    ]
   }
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div#v-pills-tabContent img.lazy, div#v-pills-tabContent img.page-img",
   "image": [
    "@data-src",
    "@src"
   ]
  }
 },
 "hinweise": [
  "HTML wie Community: Liste /?page=n (weiter, solange 'Older' nicht deaktiviert ist), Suche per POST /controller/search/general/ mit keysearch (eine Seite, Filter werden bei Textsuche ignoriert – wie Community). Genre-Filter nicht übernommen. Keine Neueste-Liste (Community: supportsLatest=false).",
  "Kapitel: Zeilen der table.table-episode; gibt es keine, ein Kapitel 'Chapter 1' = Eintragsseite (Ausweichkette items ['…tr', 'html'] wie zazamanga-Vorlagen; Felder mit const-Ausweichwert). Nummer = letzte Zahl im Namen (Community: sonst laufender Index).",
  "Status: keine Episodentabelle → abgeschlossen (default), sonst abgeschlossen nur wenn ein Kapitelname auf 'จบ' endet, sonst unbekannt (wie Community).",
  "Autor = Künstler = drittes a.badge-secondary in div.col-md-8 p (per Regex aus der |‑Verkettung).",
  "Seiten: img.lazy/img.page-img in #v-pills-tabContent, data-src vor src. Community setzt Timeouts auf 1 Minute (nicht übernehmbar)."
 ]
}
