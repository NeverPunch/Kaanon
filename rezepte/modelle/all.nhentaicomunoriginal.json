 "quelle": {
  "modul": "src/all/nhentaicom",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.3",
  "theme": "hentaihand"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Accept": "application/json, text/plain, */*",
   "X-Requested-With": "XMLHttpRequest"
  },
  "popular": {
   "request": "{base}/api/comics?page={page}&sort=popularity&order=desc&duration=all",
   "format": "json",
   "items": "data",
   "has_next": {
    "exists": "next_page_url"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/en/comic/{value}"
    },
    "title": "title",
    "cover": "image_url"
   }
  },
  "latest": {
   "request": "{base}/api/comics?page={page}&sort=uploaded_at&order=desc&duration=all",
   "format": "json",
   "items": "data",
   "has_next": {
    "exists": "next_page_url"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/en/comic/{value}"
    },
    "title": "title",
    "cover": "image_url"
   }
  },
  "search": {
   "request": "{base}/api/comics?page={page}&q={query}",
   "format": "json",
   "items": "data",
   "has_next": {
    "exists": "next_page_url"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/en/comic/{value}"
    },
    "title": "title",
    "cover": "image_url"
   }
  },
  "details": {
   "request": "{base}/api/comics/{u.slug}",
   "format": "json",
   "url_vars": {
    "slug": "/comic/([^/?#]+)"
   },
   "fields": {
    "title": "title",
    "cover": "image_url",
    "artist": {
     "path": "artists.*.name",
     "all": true,
     "join": ", "
    },
    "author": [
     {
      "path": "authors.*.name",
      "all": true,
      "join": ", "
     },
     {
      "path": "artists.*.name",
      "all": true,
      "join": ", "
     }
    ],
    "genres": {
     "path": [
      "tags.*.name",
      "relationships.*.name"
     ],
     "union": true
    },
    "description": "description",
    "status": "status"
   },
   "status_map": {
    "ongoing": 1,
    "onhold": 1,
    "complete": 2,
    "canceled": 2
   }
  },
  "chapters": {
   "request": "details",
   "format": "json",
   "items": "$",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/en/comic/{value}"
    },
    "name": {
     "const": "Chapter"
    },
    "date": "updated_at"
   },
   "date_format": [
    "yyyy-MM-dd",
    "relative"
   ]
  },
  "pages": {
   "request": "{base}/api/comics/{u.slug}/images",
   "format": "json",
   "url_vars": {
    "slug": "/comic/([^/?#]+)"
   },
   "items": "images",
   "image": "source_url"
  }
 },
 "hinweise": [
  "Gleiches Theme wie all.hentaihand (Modell übernommen): JSON-API /api/comics, chapters=false → ein Kapitel aus /api/comics/{slug} (items '$' = Wurzelobjekt, wie Vorlage en.dynastyscans). Datum aus updated_at (yyyy-MM-dd oder 'N days ago').",
  "Die Community hat 19 Sprachquellen, die sich nur im Filter languages[-1]=ID unterscheiden; ein Rezept hat ein Modell und folgt der 'all'-Quelle (kein Sprachfilter). Die übrigen Quell-IDs stehen trotzdem in 'quellen' (gleiche Inhalte, ungefiltert) – ggf. auf 'all' kürzen.",
  "Suche nur per q=…; die Community löst den Suchtext vorher als Tag/Künstler/Figur-ID auf, weil reines q auf manchen Seiten HTTP 500 liefert – nicht nachgebildet.",
  "has_next über 'next_page_url' (null auf der letzten Seite); Annahme: exists wertet null als nicht vorhanden.",
  "Status wie im Code (onhold → laufend, canceled → abgeschlossen). Beschreibung nur 'description' (Community hängt Gruppen, Seitenzahl, Kategorie, Sprache, Parodien, Figuren an). Optionaler Login (Bearer-Token) nicht nachgebildet."
 ]
}
