{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "MangaNow",
  "sprache": "en",
  "base_url": "https://manganow.to",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.manganow",
  "quellen": [
   {
    "name": "MangaNow",
    "sprache": "en",
    "quell_id": 855054225815309342,
    "home": "https://manganow.to"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/manganow",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.6",
  "theme": "mangareader"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/filter/?sort=most-viewed&page={page}",
   "items": ".manga_list-sbs .manga-poster",
   "has_next": {
    "exists": "ul.pagination > li.active + li"
   },
   "fields": {
    "url": "@href",
    "title": "img@alt",
    "cover": "img@img"
   }
  },
  "latest": {
   "request": "{base}/filter/?sort=latest-updated&page={page}",
   "items": ".manga_list-sbs .manga-poster",
   "has_next": {
    "exists": "ul.pagination > li.active + li"
   },
   "fields": {
    "url": "@href",
    "title": "img@alt",
    "cover": "img@img"
   }
  },
  "search": {
   "request": "{base}/search?keyword={query}&page={page}",
   "items": ".manga_list-sbs .manga-poster",
   "has_next": {
    "exists": "ul.pagination > li.active + li"
   },
   "fields": {
    "url": "@href",
    "title": "img@alt",
    "cover": "img@img"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "#ani_detail .manga-name@ownText",
    "cover": "#ani_detail img@img",
    "description": "#ani_detail .description@ownText",
    "genres": {
     "path": "#ani_detail .genres > a@ownText",
     "all": true,
     "join": ", "
    },
    "author": {
     "path": "#ani_detail .anisc-info > .item:has(.item-head:containsOwn(Authors:)) a@ownText",
     "all": true,
     "join": ", ",
     "replace": [
      [
       ",\\s*,",
       ","
      ]
     ]
    },
    "status": "#ani_detail .anisc-info > .item:has(.item-head:containsOwn(Status:)) .name"
   },
   "status_map": {
    "ongoing": 1,
    "publishing": 1,
    "releasing": 1,
    "completed": 2,
    "finished": 2,
    "on-hold": 6,
    "on_hiatus": 6,
    "canceled": 5,
    "discontinued": 5
   }
  },
  "chapters": {
   "request": "details",
   "items": "#en-chapters > li.chapter-item",
   "fields": {
    "url": "a@href",
    "name": [
     "a .name",
     "a"
    ]
   }
  },
  "pages": {
   "request": "{abs_url}",
   "let": {
    "rid": "div[data-reading-id]@data-reading-id"
   },
   "then": [
    {
     "request": {
      "url": "{base}/ajax/image/list/{l.rid}?mode=vertical",
      "headers": {
       "Accept": "application/json, text/javascript, */*; q=0.01",
       "X-Requested-With": "XMLHttpRequest",
       "Referer": "{abs_url}"
      }
     },
     "format": "json_html",
     "html_path": "html"
    }
   ],
   "items": ".container-reader-chapter > .iv-card:not([data-url$=manganow.jpg])",
   "image": [
    "@data-lazy-src",
    "@data-src",
    "@data-url",
    "@src",
    "img@img"
   ]
  }
 },
 "hinweise": [
  "MangaReader-Theme (HTML). Beliebt/Neu über /filter/?sort=most-viewed|latest-updated&page=N, Suche /search?keyword=…&page=N.",
  "Community hängt die Kapitel-ID (li@data-id) als '#id' an die Kapitel-URL; hier wird stattdessen – wie der Ausweichweg der Community – die Kapitelseite geladen und die ID aus div[data-reading-id] gelesen, danach GET /ajax/image/list/<id>?mode=vertical (JSON mit HTML in 'html').",
  "Bilder: .iv-card ohne Platzhalter manganow.jpg, Bild-URL aus data-lazy-src/data-src/data-url/src. Die Community schickt als Bild-Referer die Bild-URL selbst; hier nicht nachgebildet.",
  "Autoren: Community trennt Zeichner anhand '(Art)' hinter dem Link; hier alle Namen als Autor."
 ]
}