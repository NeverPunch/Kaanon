{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "HentaiZone (Beta)",
  "sprache": "fr",
  "base_url": "https://beta.hentaizone.xyz",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.fr.kaanon.hentaizonebeta",
  "quellen": [
   {
    "name": "HentaiZone (Beta)",
    "sprache": "fr",
    "quell_id": 7049266890592812453,
    "home": "https://beta.hentaizone.xyz"
   }
  ]
 },
 "quelle": {
  "modul": "src/fr/hentaizonebeta",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/api/v1/manga/search?limit=24&orderby=views",
   "format": "json",
   "items": "manga",
   "fields": {
    "url": [
     {
      "path": "permalink",
      "regex": "([^/]+)/?$",
      "group": 1,
      "template": "/manga/{value}"
     },
     {
      "path": "id",
      "template": "/manga/{value}"
     }
    ],
    "title": "title",
    "cover": "thumbnail"
   },
   "has_next": {
    "const": false
   }
  },
  "latest": {
   "request": "{base}/api/v1/manga/search?limit=24&orderby=latest&order=desc",
   "format": "json",
   "items": "manga",
   "fields": {
    "url": [
     {
      "path": "permalink",
      "regex": "([^/]+)/?$",
      "group": 1,
      "template": "/manga/{value}"
     },
     {
      "path": "id",
      "template": "/manga/{value}"
     }
    ],
    "title": "title",
    "cover": "thumbnail"
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": "{base}/api/v1/manga/search?limit=24&search={query}",
   "format": "json",
   "items": "manga",
   "fields": {
    "url": [
     {
      "path": "permalink",
      "regex": "([^/]+)/?$",
      "group": 1,
      "template": "/manga/{value}"
     },
     {
      "path": "id",
      "template": "/manga/{value}"
     }
    ],
    "title": "title",
    "cover": "thumbnail"
   },
   "has_next": {
    "const": false
   }
  },
  "details": {
   "request": "{base}/api/v1/manga/single/{u.slug}",
   "format": "json",
   "url_vars": {
    "slug": "/manga/([^/?#]+)"
   },
   "fields": {
    "title": "title",
    "cover": [
     "cover_image",
     "banner_image"
    ],
    "description": {
     "path": "content",
     "decode": "html_text"
    },
    "author": {
     "path": "authors.*.name",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "artists.*.name",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": [
      "genres.*.name",
      "tags.*.name"
     ],
     "union": true
    },
    "status": "status"
   },
   "status_map": {
    "end": 2,
    "completed": 2,
    "terminé": 2,
    "Terminé": 2,
    "ongoing": 1,
    "en cours": 1,
    "En cours": 1
   }
  },
  "chapters": {
   "request": "details",
   "format": "json",
   "items": "chapters",
   "fields": {
    "url": {
     "path": "chapter_slug",
     "template": "/manga/{u.slug}/{value}"
    },
    "name": "name",
    "number": [
     {
      "path": "chapter_number"
     },
     {
      "path": "name",
      "regex": "(?i)(?:chapitre|ch[.]?)\\s*(\\d+(?:[.]\\d+)?)",
      "group": 1
     }
    ],
    "date": [
     "upload_time",
     "date"
    ]
   },
   "date_format": "epoch_s"
  },
  "pages": {
   "request": "{base}/api/v1/chapters/{u.ms}/{u.cs}",
   "format": "json",
   "url_vars": {
    "ms": "/manga/([^/]+)/[^/?#]+",
    "cs": "/manga/[^/]+/([^/?#]+)"
   },
   "items": "images",
   "image": "url"
  }
 },
 "hinweise": [
  "Listen blättern per Cursor (next_cursor der vorigen Antwort) – nicht ausdrückbar, daher nur die erste Seite (24 Einträge). Typ-/Genre-Filter nicht übernommen.",
  "Manga-URL /manga/<letzter Teil des permalink> (sonst ID), Details und Kapitel aus /api/v1/manga/single/<slug>; Seiten aus /api/v1/chapters/<manga>/<kapitel>."
 ]
}
