{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Bbato",
  "sprache": "en",
  "base_url": "https://bato1.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.bbato",
  "quellen": [
   {
    "name": "Bbato",
    "sprache": "en",
    "quell_id": 1678128543826757763,
    "home": "https://bato1.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/bbato",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.3",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/filter?sort=views&page={page}",
   "items": ".original.card-lg .unit:has(a.poster)",
   "has_next": {
    "exists": ".pagination a[rel=next]"
   },
   "fields": {
    "url": "a.poster@href",
    "title": ".info > a",
    "cover": "a.poster img@img"
   }
  },
  "latest": {
   "request": "{base}/updated/page/{page}",
   "items": ".original.card-lg .unit:has(a.poster)",
   "has_next": {
    "exists": ".pagination a[rel=next]"
   },
   "fields": {
    "url": "a.poster@href",
    "title": ".info > a",
    "cover": "a.poster img@img"
   },
   "request_by_page": {
    "1": "{base}/updated"
   }
  },
  "search": {
   "request": "{base}/filter?keyword={query}&page={page}",
   "items": ".original.card-lg .unit:has(a.poster)",
   "has_next": {
    "exists": ".pagination a[rel=next]"
   },
   "fields": {
    "url": "a.poster@href",
    "title": ".info > a",
    "cover": "a.poster img@img"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1[itemprop=name]",
    "author": {
     "path": ".meta div:has(span:contains(Author)) a",
     "all": true,
     "join": ", "
    },
    "description": ".description",
    "genres": {
     "path": ".meta div:has(span:contains(Genres)) a",
     "all": true,
     "join": ", "
    },
    "status": ".info > p",
    "cover": ".poster img@img"
   },
   "status_map": {
    "ongoing": 1,
    "releasing": 1,
    "completed": 2,
    "on hiatus": 6,
    "on_hiatus": 6,
    "discontinued": 5,
    "cancelled": 5
   }
  },
  "chapters": {
   "request": {
    "url": "{base}/get-chapter-list?slug={u.slug}",
    "headers": {
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "url_vars": {
    "slug": "/manga/([^/?#]+)"
   },
   "items": "data",
   "fields": {
    "url": {
     "path": "chapter_slug",
     "template": "/read/{u.slug}/{value}"
    },
    "name": "chapter_name",
    "date": "updated_at"
   },
   "date_format": "yyyy-MM-dd HH:mm:ss"
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".pages .page:not(.notice-page) img",
   "image": "@img"
  }
 },
 "hinweise": [
  "HTML-Website bato1.com (Community-Standard, base_url dort änderbar); Kapitelliste als JSON von /get-chapter-list?slug=… mit X-Requested-With. Rate-Limit 2/s.",
  "Latest Seite 1 = /updated (request_by_page wie tr.korelimanga), danach /updated/page/N. Popular/Suche mit page=1 auch auf Seite 1 (Community lässt den Parameter dort weg)."
 ]
}
