{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Colorcito Scan",
  "sprache": "es",
  "base_url": "https://coloresito.site",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.es.kaanon.colorcitoscan",
  "quellen": [
   {
    "name": "Colorcito Scan",
    "sprache": "es",
    "quell_id": 1261665235729689526,
    "home": "https://coloresito.site"
   },
   {
    "name": "Colorcito Toons",
    "sprache": "es",
    "quell_id": 4591173925927777888,
    "home": "https://colorcitotoons.site"
   }
  ]
 },
 "quelle": {
  "modul": "src/es/colorcitoscan",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.3",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/api/comics",
   "format": "json",
   "items": "response",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/ver/{value}"
    },
    "title": "name",
    "cover": "urlImg"
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": "{base}/api/comics",
   "format": "json",
   "items": "response",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/ver/{value}"
    },
    "title": "name",
    "cover": "urlImg"
   },
   "has_next": {
    "const": false
   },
   "client_filter": true
  },
  "details": {
   "request": "{base}/api/showProject/{u.slug}",
   "format": "json",
   "url_vars": {
    "slug": "/ver/([^/?#]+)"
   },
   "fields": {
    "title": "response.name",
    "cover": "response.urlImg",
    "description": "response.sinopsis",
    "author": {
     "path": "response.autors.*.name",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "response.artists.*.name",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": [
      "response.origins.*.origin.name",
      "response.genders.*.gender.name"
     ],
     "union": true
    },
    "status": "response.state.estado"
   },
   "status_map": {
    "en emision": 1,
    "en emisión": 1,
    "finalizado": 2,
    "en pausa": 6,
    "cancelado": 5,
    "abandonado": 5
   }
  },
  "chapters": {
   "request": "details",
   "format": "json",
   "url_vars": {
    "slug": "/ver/([^/?#]+)"
   },
   "items": "response.lastChapters",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/ver/{u.slug}/{value}"
    },
    "name": [
     {
      "path": "num",
      "template": "Capítulo {value}"
     },
     "slug"
    ],
    "number": "num",
    "scanlator": "name",
    "date": "created_at"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "img[src*=/serie/], img[src*=%2Fserie%2F]",
   "image": {
    "path": "@src",
    "replace": [
     [
      "^.*[?&]url=([^&]+).*$",
      "$1"
     ],
     [
      "%2F",
      "/"
     ],
     [
      "%3A",
      ":"
     ]
    ]
   }
  }
 },
 "hinweise": [
  "Zwei Quellen (Colorcito Scan, Colorcito Toons) mit gleicher API, unterschiedlicher base_url – ein Modell für beide.",
  "Katalog: /api/comics liefert alle Werke auf einmal. Community sortiert clientseitig (populär nach trending.visitas, neueste nach actualizacionCap) – Sortieren von Listen gibt es nicht, daher Reihenfolge der API und kein latest-Teil.",
  "Suche clientseitig über die Katalogliste (Community auch über alternativeName); Status/Typ/Genre/Sortier-Filter nicht nachgebaut.",
  "Kapitel aus response.lastChapters (wie Community); Name 'Capítulo <num>', sonst Slug; Scanlator = Kapitelname.",
  "Seiten: img mit /serie/ im src; bei Next-Image-URLs wird der url-Parameter per Regex herausgelöst und %2F/%3A zurückgewandelt (Community: queryParameter). Doppelte Bilder entfernt die Community (distinct) – hier nicht möglich."
 ]
}
