   "items": ".items .item",
   "has_next": {
    "exists": "ul.pagination li:last-child:not(.disabled) a"
   },
   "fields": {
    "url": [
     "h3 a@href",
     "a.jtip@href",
     ".image a@href"
    ],
    "title": [
     "h3 a@title",
     "h3 a",
     "a.jtip@title",
     ".image a@title"
    ],
    "cover": [
