     "img@data-src",
     "img@src"
    ]
   }
  },
  "latest": {
   "request": "{base}/?page={page}",
   "items": ".items .item",
   "has_next": {
    "exists": "ul.pagination li:last-child:not(.disabled) a"
   },
   "fields": {
    "url": [
     "h3 a@href",
     "a.jtip@href",
     ".image a@href"
    ],
    "title": [
     "h3 a@title",
     "h3 a",
     "a.jtip@title",
     ".image a@title"
    ],
    "cover": [
     "img@data-original",
     "img@data-src",
     "img@src"
    ]
   }
  },
  "search": {
   "request": "{base}/tim-truyen?keyword={query}&page={page}",
   "items": ".items .item",
   "has_next": {
    "exists": "ul.pagination li:last-child:not(.disabled) a"
   },
   "fields": {
    "url": [
     "h3 a@href",
     "a.jtip@href",
     ".image a@href"
    ],
    "title": [
     "h3 a@title",
     "h3 a",
     "a.jtip@title",
     ".image a@title"
    ],
    "cover": [
     "img@data-original",
     "img@data-src",
     "img@src"
    ]
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1.title-detail",
    "cover": [
     ".detail-info .col-image img@data-original",
     ".detail-info .col-image img@data-src",
     ".detail-info .col-image img@src"
    ],
    "author": "li.author .col-xs-8",
    "description": {
     "path": ".detail-content",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": "li.kind .col-xs-8 a",
     "all": true,
     "join": ", "
    },
    "status": {
     "path": "li.status .col-xs-8",
     "regex": "(?i)(đang tiến hành|hoàn thành)",
     "group": 1
    }
   },
   "status_map": {
    "đang tiến hành": 1,
    "hoàn thành": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "#nt_listchapter.list-chapter ul li.row",
   "fields": {
    "url": "div.chapter a@href",
    "name": "div.chapter a",
    "date": {
     "path": "div.col-xs-4",
     "replace": [
      [
       "(?i)^\\D*?(\\d+)\\s*giờ.*trước.*$",
       "$1 hours ago"
      ],
      [
       "(?i)^\\D*?(\\d+)\\s*ngày.*trước.*$",
       "$1 days ago"
      ],
      [
       "(?i)^\\D*?(\\d+)\\s*tuần.*trước.*$",
       "$1 weeks ago"
      ],
      [
       "(?i)^\\D*?(\\d+)\\s*tháng.*trước.*$",
       "$1 months ago"
      ],
      [
       "(?i)^\\D*?(\\d+)\\s*năm.*trước.*$",
       "$1 years ago"
      ],
      [
       "(?i)^\\D*?(\\d+)\\s*phút.*trước.*$",
       "$1 minutes ago"
      ],
      [
       "(?i)^\\D*?(\\d+)\\s*giây.*trước.*$",
       "$1 seconds ago"
      ]
     ]
    }
   },
   "date_format": "relative",
   "date_locale": "en"
  },
  "pages": {
   "request": "{abs_url}",
   "items": [
    ".reading-detail img, .page-chapter img",
    ".chapter-content img"
   ],
   "image": [
    "@data-original",
    "@data-src",
    "@src"
   ]
  }
 },
