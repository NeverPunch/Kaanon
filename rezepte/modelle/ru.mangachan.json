{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "MangaChan",
  "sprache": "ru",
  "base_url": "https://im.manga-chan.me",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.ru.kaanon.mangachan",
  "quellen": [
   {
    "name": "MangaChan",
    "sprache": "ru",
    "quell_id": 7,
    "home": "https://im.manga-chan.me"
   }
  ]
 },
 "quelle": {
  "modul": "src/ru/mangachan",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "multichan"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/mostfavorites?offset={offset}",
   "items": "div.content_row",
   "page_size": 20,
   "has_next": {
    "exists": "a:contains(Вперед)"
   },
   "fields": {
    "url": "h2 > a@href",
    "title": [
     "@title",
     "h2 > a"
    ],
    "cover": "img@src"
   }
  },
  "latest": {
   "request": "{base}/manga/new?offset={offset}",
   "items": "div.content_row",
   "page_size": 20,
   "has_next": {
    "exists": "a:contains(Вперед)"
   },
   "fields": {
    "url": "h2 > a@href",
    "title": [
     "@title",
     "h2 > a"
    ],
    "cover": "img@src"
   }
  },
  "search": {
   "request": "{base}/?do=search&subaction=search&story={query}&search_start={page}",
   "items": "div.content_row",
   "page_size": 20,
   "has_next": {
    "exists": "a:contains(Далее), a:contains(Вперед)"
   },
   "fields": {
    "url": "h2 > a@href",
    "title": [
     "@title",
     "h2 > a"
    ],
    "cover": "img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": {
     "path": "title",
     "replace": [
      [
       " ».*$",
       ""
      ]
     ]
    },
    "cover": "img#cover@src",
    "author": "#info_wrap tr:contains(Автор) .item2, #info_wrap > div:contains(Автор) .item2",
    "genres": {
     "path": "#info_wrap tr:contains(Тип) a, #info_wrap > div:contains(Тип) a, .sidetags ul a:last-child",
     "all": true,
     "join": ", "
    },
    "description": "div#description@ownText",
    "status": {
     "path": "#info_wrap tr:contains(Загружено), #info_wrap > div:contains(Загружено)",
     "regex": "(перевод завершен|перевод продолжается)",
     "group": 1
    }
   },
   "status_map": {
    "перевод завершен": 2,
    "перевод продолжается": 1
   }
  },
  "chapters": {
   "request": "details",
   "items": "table.table_cha tr:gt(1)",
   "fields": {
    "url": "a@href",
    "name": "a",
    "date": "div.date",
    "number": {
     "path": "a",
     "regex": "(?i)(глава\\s|часть\\s)([0-9]+\\.?[0-9]*)",
     "group": 2
    }
   },
   "date_format": "yyyy-MM-dd"
  },
  "pages": {
   "request": "{abs_url}",
   "format": "text",
   "block_regex": "(?s)fullimg\":\\[(.*?),\\]",
   "items": "\"([^\"]+)\"",
   "image": ""
  }
 },
 "hinweise": [
  "Theme MultiChan. Listen mit offset=20*(Seite-1) (page_size 20), nächste Seite über Link 'Вперед'; Suche über DLE-Suche (?do=search&subaction=search&story=…&search_start=N), nächste Seite 'Далее'.",
  "Titel = <title> bis ' »'. Genres: Typ (Тип) + letzte Links der .sidetags-Liste (Code: Typ kleingeschrieben).",
  "Status nur über die Texte 'перевод завершен'/'перевод продолжается' in der Zeile 'Загружено'.",
  "Kapitel aus der Detailseite, Selektor 'table.table_cha tr:gt(1)' (jsoup-Syntax wie im Code), Datum yyyy-MM-dd; Reihenfolge wie auf der Seite (Code dreht nicht um).",
  "Seiten: Rohtext-Block fullimg\":[ … ,] wie im Code; Bild-URLs in Anführungszeichen."
 ]
}