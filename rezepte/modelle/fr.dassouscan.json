{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Dassou Scan",
  "sprache": "fr",
  "base_url": "https://dassouscan.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.fr.kaanon.dassouscan",
  "quellen": [
   {
    "name": "Dassou Scan",
    "sprache": "fr",
    "quell_id": 7036720639283559699,
    "home": "https://dassouscan.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/fr/dassouscan",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/catalogue?tri=popular&page={page}",
   "request_by_page": {
    "1": "{base}/catalogue?tri=popular"
   },
   "items": "article.dsc-cat-card",
   "fields": {
    "url": [
     "a.dsc-cat-card__cover-link@href",
     ".dsc-cat-card__title a@href",
     "a.dsc-cat-card__open@href"
    ],
    "title": [
     "@data-title",
     ".dsc-cat-card__title a"
    ],
    "cover": ".dsc-cat-card__cover img@src"
   },
   "has_next": {
    "exists": "a.dsc-cat__pager-btn[href]:contains(Suivant)"
   }
  },
  "latest": {
   "request": "{base}/catalogue?tri=latest&page={page}",
   "request_by_page": {
    "1": "{base}/catalogue?tri=latest"
   },
   "items": "article.dsc-cat-card",
   "fields": {
    "url": [
     "a.dsc-cat-card__cover-link@href",
     ".dsc-cat-card__title a@href",
     "a.dsc-cat-card__open@href"
    ],
    "title": [
     "@data-title",
     ".dsc-cat-card__title a"
    ],
    "cover": ".dsc-cat-card__cover img@src"
   },
   "has_next": {
    "exists": "a.dsc-cat__pager-btn[href]:contains(Suivant)"
   }
  },
  "search": {
   "request": "{base}/catalogue?q={query}&page={page}",
   "request_by_page": {
    "1": "{base}/catalogue?q={query}"
   },
   "items": "article.dsc-cat-card",
   "fields": {
    "url": [
     "a.dsc-cat-card__cover-link@href",
     ".dsc-cat-card__title a@href",
     "a.dsc-cat-card__open@href"
    ],
    "title": [
     "@data-title",
     ".dsc-cat-card__title a"
    ],
    "cover": ".dsc-cat-card__cover img@src"
   },
   "has_next": {
    "exists": "a.dsc-cat__pager-btn[href]:contains(Suivant)"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1",
    "description": ".dsc-mf__synopsis-text",
    "genres": {
     "path": ".dsc-mf__tags a.dsc-mf__tag",
     "all": true,
     "join": ", "
    },
    "cover": ".dsc-mf__cover img@src"
   }
  },
  "chapters": {
   "request": "details",
   "items": "div.dsc-manga-chapter-block:not(:has(a[href*=/inscription/]))",
   "skip": {
    "any": [
     {
      "path": "@class",
      "regex": "(chapter--locked)"
     },
     ".dsc-ch-hl__access--premium@class",
     "a.is-locked@class"
    ]
   },
   "fields": {
    "url": "a.dsc-manga-chapter-block__title-link@href",
    "name": [
     ".chapter-title@ownText",
     "a.dsc-manga-chapter-block__title-link"
    ],
    "date": ".chapter-info"
   },
   "date_format": [
    "d MMMM yyyy 'à' HH:mm",
    "dd/MM/yyyy"
   ],
   "date_locale": "fr",
   "reverse": true
  },
  "pages": {
   "request": "{abs_url}",
   "items": "#dsc-chapter-reader-content .dsc-chapter-strip-img",
   "image": [
    "@data-src",
    "@src"
   ]
  }
 },
 "hinweise": [
  "HTML-Katalog /catalogue (tri=popular|latest, Suche q=…; Seite 1 ohne page-Parameter wie Community).",
  "Premium-Kapitel (Klasse chapter--locked, .dsc-ch-hl__access--premium, a.is-locked) werden ausgelassen (Regel 0014; entspricht der Community-Voreinstellung 'Masquer les chapitres premium'). Blöcke mit Anmelde-Link entfallen wie in der Community.",
  "Datum 'd MMMM yyyy à HH:mm' oder 'dd/MM/yyyy' (fr), Zeitzone Europe/Paris der Community nicht angegeben. Kapitelliste umgedreht wie Community."
 ]
}
