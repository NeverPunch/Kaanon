{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Arc-Relight",
  "sprache": "en",
  "base_url": "https://arc-relight.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.arcrelight",
  "quellen": [
   {
    "name": "Arc-Relight",
    "sprache": "en",
    "quell_id": 6809555026902049727,
    "home": "https://arc-relight.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/arcrelight",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "mangadventure"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "User-Agent": "Mozilla/5.0 (Android 14; Mobile) Tachiyomi/1.6"
  },
  "popular": {
   "request": "{base}/api/v2/series?page={page}&sort=-views",
   "format": "json",
   "items": "results",
   "has_next": {
    "total": "total"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/reader/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "latest": {
   "request": "{base}/api/v2/series?page={page}&sort=-latest_upload",
   "format": "json",
   "items": "results",
   "has_next": {
    "total": "total"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/reader/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "search": {
   "request": "{base}/api/v2/series?page={page}&title={query}",
   "format": "json",
   "items": "results",
   "has_next": {
    "total": "total"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/reader/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "details": {
   "request": "{base}/api/v2/series/{u.slug}",
   "format": "json",
   "url_vars": {
    "slug": "/reader/([^/?#]+)"
   },
   "fields": {
    "title": "title",
    "cover": "cover",
    "description": "description",
    "author": {
     "path": "authors.*",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "artists.*",
     "all": true,
     "join": ", "
    },
    "genres": "categories.*",
    "status": "status"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "hiatus": 6,
    "canceled": 5
   }
  },
  "chapters": {
   "request": "{base}/api/v2/series/{u.slug}/chapters?date_format=timestamp",
   "format": "json",
   "items": "results",
   "fields": {
    "url": {
     "path": "id",
     "template": "/api/v2/chapters/{value}/read"
    },
    "name": "full_title",
    "number": "number",
    "scanlator": {
     "path": "groups.*",
     "all": true,
     "join": ", "
    },
    "date": "published"
   },
   "date_format": "epoch_ms"
  },
  "pages": {
   "request": "{base}/api/v2/chapters/{u.cid}/pages?track=true",
   "format": "json",
   "url_vars": {
    "cid": "/chapters/(\\d+)"
   },
   "items": "results",
   "image": "image"
  }
 },
 "hinweise": [
  "Theme MangAdventure: JSON-API {base}/api/v2. Manga-URL /reader/<slug>, Kapitel-URL /api/v2/chapters/<id>/read (wie getChapterUrl der Community).",
  "has_next: Community nutzt 'last' (true = letzte Seite) – Negation gibt es in keiner Vorlage; Rezept nutzt das Feld 'total' der Paginierung (MangAdventure liefert total/last/results) – auf dem PC prüfen.",
  "User-Agent der Community: 'Mozilla/5.0 (Android <Version>; Mobile) Tachiyomi/<App-Version>' – Rezept mit festen Werten.",
  "Datum: published mit date_format=timestamp, Community übernimmt es direkt als Millisekunden → epoch_ms.",
  "'[END]' bei finalen Kapiteln, Alternativtitel in der Beschreibung und Status 'lizenziert' (licensed=true) nicht abgebildet. Filter (Autor, Zeichner, Status, Kategorien) nicht abgebildet."
 ]
}
