{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Revistas e Quadrinhos",
  "sprache": "pt",
  "base_url": "https://revistasequadrinhos.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.pt.kaanon.revistasequadrinhos",
  "quellen": [
   {
    "name": "Revistas e Quadrinhos",
    "sprache": "pt",
    "quell_id": 1455091782657313638,
    "home": "https://revistasequadrinhos.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/pt/revistasequadrinhos",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/category/popular-comics/page/{page}",
   "request_by_page": {
    "1": "{base}/category/popular-comics"
   },
   "items": "ul.videos > li:has(a.titulo)",
   "fields": {
    "url": "a.titulo@href",
    "title": "a.titulo",
    "cover": "div.thumb-conteudo img@src"
   },
   "has_next": {
    "exists": ".paginacao li.next"
   }
  },
  "latest": {
   "request": "{base}/page/{page}",
   "request_by_page": {
    "1": "{base}/"
   },
   "items": "ul.videos > li:has(a.titulo)",
   "fields": {
    "url": "a.titulo@href",
    "title": "a.titulo",
    "cover": "div.thumb-conteudo img@src"
   },
   "has_next": {
    "exists": ".paginacao li.next"
   }
  },
  "search": {
   "request": "{base}/page/{page}?s={query}",
   "request_by_page": {
    "1": "{base}/?s={query}"
   },
   "items": "ul.videos > li:has(a.titulo)",
   "fields": {
    "url": "a.titulo@href",
    "title": "a.titulo",
    "cover": "div.thumb-conteudo img@src"
   },
   "has_next": {
    "exists": ".paginacao li.next"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": ".post-conteudo h1",
    "description": {
     "path": ".post-texto p",
     "all": true,
     "join": "\n"
    },
    "genres": {
     "path": ".post-tags a",
     "all": true,
     "join": ", "
    },
    "cover": "meta[property=og:image]@content",
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "const": "Capítulo Único"
    },
    "date": "meta[property=article:published_time]@content"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": [
    "div.dgwt-jg-gallery figure.dgwt-jg-item a",
    ".post-texto img"
   ],
   "image": [
    "@href",
    {
     "path": "@src",
     "regex": "^(?!data:)(.+)$",
     "group": 1
    },
    "@data-lazy-src"
   ]
  }
 },
 "hinweise": [
  "WordPress-Seite: jeder Beitrag = ein Werk mit einem Kapitel 'Capítulo Único' (URL = Beitrags-URL; Community nimmt die URL nach Weiterleitung). Status abgeschlossen wie in der Community.",
  "Beliebt = Kategorie popular-comics, Neueste = Startseite, Seite 1 jeweils ohne /page/1. Kategorie-/Tag-Filter nicht übernommen.",
  "Seiten: zuerst Galerie-Links (dgwt-jg), sonst Bilder in .post-texto (src, sonst data-lazy-src)."
 ]
}
