{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "ThienThaiTruyen",
  "sprache": "vi",
  "base_url": "https://thienthaitruyen16.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.vi.kaanon.thienthaitruyen",
  "quellen": [
   {
    "name": "ThienThaiTruyen",
    "sprache": "vi",
    "quell_id": 4424472966200672277,
    "home": "https://thienthaitruyen16.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/vi/thienthaitruyen",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.11",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Referer": "{base}/"
  },
  "rate_limit": {
   "permits": 5,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/tim-kiem-nang-cao?status=all&sort=rating&page={page}",
   "items": [
    ":has(> form#filters-container) + * a[href*=/truyen-tranh/]:has(span.line-clamp-2)",
    "a[href*=/truyen-tranh/]:has(span.line-clamp-2):has(img[src])"
   ],
   "has_next": {
    "exists": "a[href*=page=]:contains(Sau)"
   },
   "fields": {
    "url": "@href",
    "title": "span.line-clamp-2",
    "cover": "img[src]@src"
   }
  },
  "latest": {
   "request": "{base}/tim-kiem-nang-cao?status=all&sort=latest&page={page}",
   "items": [
    ":has(> form#filters-container) + * a[href*=/truyen-tranh/]:has(span.line-clamp-2)",
    "a[href*=/truyen-tranh/]:has(span.line-clamp-2):has(img[src])"
   ],
   "has_next": {
    "exists": "a[href*=page=]:contains(Sau)"
   },
   "fields": {
    "url": "@href",
    "title": "span.line-clamp-2",
    "cover": "img[src]@src"
   }
  },
  "search": {
   "request": "{base}/tim-kiem-nang-cao?name={query}&status=all&sort=latest&page={page}",
   "items": [
    ":has(> form#filters-container) + * a[href*=/truyen-tranh/]:has(span.line-clamp-2)",
    "a[href*=/truyen-tranh/]:has(span.line-clamp-2):has(img[src])"
   ],
   "has_next": {
    "exists": "a[href*=page=]:contains(Sau)"
   },
   "fields": {
    "url": "@href",
    "title": "span.line-clamp-2",
    "cover": "img[src]@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1",
    "author": "p:containsOwn(Tác giả) + *, h3:containsOwn(Tác giả) + *",
    "genres": {
     "path": "h3:containsOwn(Thể loại) + div a[href*=/the-loai/]",
     "all": true,
     "join": ", "
    },
    "status": "p:containsOwn(Trạng thái) + *, h3:containsOwn(Trạng thái) + *",
    "description": "p.comic-content.desk, p.comic-content.mobile, p.comic-content",
    "cover": "img[alt=poster]@src"
   },
   "status_map": {
    "đang ra": 1,
    "hoàn thành": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "div.chapter-items > a.flex.justify-between.items-center.w-full",
   "fields": {
    "url": "@href",
    "name": [
     "p.text-sm.text-white.font-medium",
     ""
    ],
    "date": "p.text-xs span"
   },
   "date_format": [
    "relative",
    "yyyy-MM-dd"
   ],
   "date_locale": "vi"
  },
  "pages": {
   "request": "{abs_url}",
   "items": [
    "div.w-full.mx-auto.center img:not([title=banner])",
    "div.center img:not([title=banner])"
   ],
   "image": "@src",
   "exclude": "/banner/"
  }
 },
 "hinweise": [
  "Alle Listen über /tim-kiem-nang-cao (Beliebt sort=rating, Neueste sort=latest, Suche name=…). Community nimmt die Links im Geschwisterelement nach dem Filterformular, sonst alle Manga-Links mit Titel und Bild – als Ausweichkette nachgebildet (:has(> form…) + *).",
  "Autor/Status: Community sucht p/h3 mit genau diesem Text und nimmt das Folgeelement; hier :containsOwn(...) + * (Näherung). Status per status_map (Community: 'enthält').",
  "Datum relativ (vi) oder yyyy-MM-dd. Genre-Filter nicht übernommen; Dubletten der Genres nicht entfernt.",
  "Seiten: Banner-Bilder per :not([title=banner]) und exclude '/banner/' ausgeschlossen."
 ]
}
