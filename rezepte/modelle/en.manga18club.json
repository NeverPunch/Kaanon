{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Manga18.Club",
  "sprache": "en",
  "base_url": "https://manga18.club",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.manga18club",
  "quellen": [
   {
    "name": "Manga18.Club",
    "sprache": "en",
    "quell_id": 3436561761894030433,
    "home": "https://manga18.club"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/manga18club",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "manga18"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/list-manga/{page}?order_by=views",
   "items": "div.story_item",
   "has_next": {
    "exists": ".pagination > li:last-child:not(.active)"
   },
   "fields": {
    "url": "a@href",
    "title": "div.mg_info > div.mg_name a",
    "cover": "img@src"
   }
  },
  "latest": {
   "request": "{base}/list-manga/{page}",
   "items": "div.story_item",
   "has_next": {
    "exists": ".pagination > li:last-child:not(.active)"
   },
   "fields": {
    "url": "a@href",
    "title": "div.mg_info > div.mg_name a",
    "cover": "img@src"
   }
  },
  "search": {
   "request": "{base}/list-manga/{page}?search={query}",
   "items": "div.story_item",
   "has_next": {
    "exists": ".pagination > li:last-child:not(.active)"
   },
   "fields": {
    "url": "a@href",
    "title": "div.mg_info > div.mg_name a",
    "cover": "img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "div.detail_name > h1",
    "cover": "div.detail_avatar > img@src",
    "description": {
     "path": "div.detail_reviewContent",
     "all": true,
     "join": "\n\n"
    },
    "status": "div.detail_listInfo div.item:contains(Status) div.info_value",
    "author": {
     "path": [
      "div.detail_listInfo div.info_label:contains(author) + div.info_value",
      "div.detail_listInfo div.info_label:contains(autor) + div.info_value"
     ],
     "replace": [
      [
       "^Updating$",
       ""
      ]
     ]
    },
    "artist": {
     "path": "div.detail_listInfo div.info_label:contains(artist) + div.info_value",
     "replace": [
      [
       "^Updating$",
       ""
      ]
     ]
    },
    "genres": {
     "path": "div.detail_listInfo div.info_value > a[href*=/manga-list/]",
     "all": true,
     "join": ", "
    }
   },
   "status_map": {
    "on going": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "div.chapter_box .item",
   "fields": {
    "url": "a@href",
    "name": "a",
    "date": "p"
   },
   "date_format": "dd-MM-yyyy",
   "date_locale": "en"
  },
  "pages": {
   "request": "{abs_url}",
   "format": "text",
   "block_regex": "(?s)slides_p_path\\s*=\\s*\\[(.*?)\\]",
   "items": "\"[^\"]+\"",
   "image": {
    "path": "",
    "regex": "\"([^\"]+)\"",
    "group": 1,
    "decode": "base64"
   }
  }
 },
 "hinweise": [
  "Manga18-Theme (HTML). Beliebt /list-manga/N?order_by=views, Neu /list-manga/N, Suche /list-manga/N?search=….",
  "Seiten: Bildliste in Skript 'slides_p_path = [\"<base64>\", …,]', jede URL Base64-kodiert; relative Pfade (/…) gelten zur Basis-URL.",
  "Kapiteldatum 'dd-MM-yyyy' aus dem p-Element der Kapitelzeile. Alternative Namen (Other name) hängt die Community an die Beschreibung an; hier weggelassen.",
  "Status: Community kennt nur 'On Going' und 'Completed'."
 ]
}