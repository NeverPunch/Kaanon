{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Nude-Moon",
  "sprache": "ru",
  "base_url": "https://nude-moon.org",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.ru.kaanon.nudemoon",
  "quellen": [
   {
    "name": "Nude-Moon",
    "sprache": "ru",
    "quell_id": 6384784374922886076,
    "home": "https://nude-moon.org"
   }
  ]
 },
 "quelle": {
  "modul": "src/ru/nudemoon",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.33",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "cookies": {
   "NMfYa": "1",
   "nm_mobile": "1"
  },
  "popular": {
   "request": "{base}/all_manga?views&rowstart={offset}",
   "items": "table.news_pic2",
   "fields": {
    "url": "a:has(h2)@href",
    "title": {
     "path": "a:has(h2)",
     "replace": [
      [
       "\\s+/\\s.*$",
       ""
      ]
     ]
    },
    "cover": "a img@src"
   },
   "page_size": 30,
   "has_next": {
    "exists": "a.small:contains(>)"
   }
  },
  "latest": {
   "request": "{base}/all_manga?date&rowstart={offset}",
   "items": "table.news_pic2",
   "fields": {
    "url": "a:has(h2)@href",
    "title": {
     "path": "a:has(h2)",
     "replace": [
      [
       "\\s+/\\s.*$",
       ""
      ]
     ]
    },
    "cover": "a img@src"
   },
   "page_size": 30,
   "has_next": {
    "exists": "a.small:contains(>)"
   }
  },
  "search": {
   "request": "{base}/search?stext={query}&rowstart={offset}",
   "items": "table.news_pic2",
   "fields": {
    "url": "a:has(h2)@href",
    "title": {
     "path": "a:has(h2)",
     "replace": [
      [
       "\\s+/\\s.*$",
       ""
      ]
     ]
    },
    "cover": "a img@src"
   },
   "page_size": 30,
   "has_next": {
    "exists": "a.small:contains(>)"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": {
     "path": "h1",
     "replace": [
      [
       "\\s+/\\s.*$",
       ""
      ]
     ]
    },
    "cover": "meta[property=og:image]@content",
    "author": "table.news_pic2 a[href*=mangaka]",
    "genres": {
     "path": "table.news_pic2 div.tag-links a",
     "all": true,
     "join": ", "
    },
    "description": ".description"
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "path": [
      "table td.bg_style1 h1",
      "h1"
     ],
     "template": "Сингл {value}"
    },
    "number": {
     "path": "h1",
     "regex": "№\\s*(\\d+(?:[.-]\\d+)?)",
     "group": 1,
     "replace": [
      [
       "-",
       "."
      ]
     ]
    },
    "scanlator": "table.news_pic2 a[href*=perevod]",
    "date": {
     "path": "td:has(img[src*=time]) span.small2",
     "regex": "\\b(\\d{1,2}\\s+[А-Яа-яЁё]+\\s+(?:19|20)\\d{2})\\b",
     "group": 1
    }
   },
   "date_format": [
    "d MMMM yyyy",
    "dd MMMM yyyy"
   ],
   "date_locale": "ru"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "img[title~=.+][loading=\"lazy\"]",
   "image": "@data-src"
  }
 },
 "hinweise": [
  "HTML wie Community, Cookies NMfYa=1 und nm_mobile=1. Listen /all_manga?views bzw. ?date mit rowstart=(Seite-1)*30. Suche /search?stext=… funktioniert laut Community nur angemeldet (sonst 404) – Login wird nicht nachgebaut. Tag-Filter/Sortierung nicht übernommen.",
  "VEREINFACHT: Jeder Katalogeintrag ist auf der Website selbst ein lesbares Kapitel. Die Community sammelt bei Serien über 'Все главы' (eigene, geblätterte Liste) alle Kapitel der Serie; das ist hier nicht nachgebaut – jeder Eintrag hat genau ein Kapitel = die Eintragsseite. Deshalb wird im Titel nur der Teil nach ' / ' entfernt, die Nummer (№) bleibt erhalten (Community schneidet sie ab).",
  "Kapitelname 'Сингл <h1>' (Community: Teil nach '/'), Nummer aus '№N' (sonst leer), Datum aus span.small2 neben dem Uhr-Symbol (russischer Monatsname; Community kennt zusätzlich Nominativformen wie 'январь' – hier nur Locale ru).",
  "Seiten: img[title][loading=lazy]@data-src. Ohne Anmeldung kann die Liste leer sein (Community-Hinweis) – nicht umgangen."
 ]
}
