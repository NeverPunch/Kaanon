{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Assorted Scans",
  "sprache": "en",
  "base_url": "https://assortedscans.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.assortedscans",
  "quellen": [
   {
    "name": "Assorted Scans",
    "sprache": "en",
    "quell_id": 8088090686762347480,
    "home": "https://assortedscans.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/assortedscans",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "mangadventure"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/api/v2/series?page={page}&sort=-views",
   "format": "json",
   "items": "results",
   "has_next": {
    "full": true
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/reader/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "latest": {
   "request": "{base}/api/v2/series?page={page}&sort=-latest_upload",
   "format": "json",
   "items": "results",
   "has_next": {
    "full": true
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/reader/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "search": {
   "request": "{base}/api/v2/series?page={page}&title={query}",
   "format": "json",
   "items": "results",
   "has_next": {
    "full": true
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/reader/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "details": {
   "request": "{base}/api/v2/series/{u.slug}",
   "format": "json",
   "url_vars": {
    "slug": "/reader/([^/?#]+)"
   },
   "fields": {
    "title": "title",
    "cover": "cover",
    "description": "description",
    "author": {
     "path": "authors.*",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "artists.*",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": "categories.*",
     "all": true,
     "join": ", "
    },
    "status": [
     {
      "path": "licensed",
      "regex": "^(true)$",
      "template": "licensed"
     },
     "status"
    ]
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "licensed": 3,
    "canceled": 5,
    "hiatus": 6
   }
  },
  "chapters": {
   "request": "{base}/api/v2/series/{u.slug}/chapters?date_format=timestamp",
   "format": "json",
   "url_vars": {
    "slug": "/reader/([^/?#]+)"
   },
   "items": "results",
   "fields": {
    "url": {
     "path": "id",
     "template": "/api/v2/chapters/{value}/read"
    },
    "name": "full_title",
    "number": "number",
    "date": "published",
    "scanlator": {
     "path": "groups.*",
     "all": true,
     "join": ", "
    }
   },
   "date_format": "epoch_ms"
  },
  "pages": {
   "request": "{base}/api/v2/chapters/{u.id}/pages?track=true",
   "format": "json",
   "url_vars": {
    "id": "/chapters/(\\d+)"
   },
   "items": "results",
   "image": "image"
  }
 },
 "hinweise": [
  "Theme MangAdventure (JSON-API /api/v2). Listen: series?page=N&sort=-views bzw. -latest_upload, Suche title=….",
  "Nächste Seite: die API meldet 'last': true auf der letzten Seite; eine Negation gibt es in der Rezeptsprache nicht, daher 'full' (volle Seite = weitere Seite). Seitengröße der API unbekannt (page_size nicht gesetzt) – auf dem PC prüfen.",
  "User-Agent: Community schickt 'Mozilla/5.0 (Android <Version>; Mobile) Tachiyomi/<App-Version>' (Laufzeitwerte); hier kein eigener User-Agent gesetzt, um keine Werte zu erfinden.",
  "Manga-URL /reader/{slug} wie getMangaUrl; Kapitel-URL /api/v2/chapters/{id}/read wie getChapterUrl. Kapitelname = full_title (Community hängt bei final ' [END]' an – weggelassen).",
  "Datum mit date_format=timestamp angefordert; Community nimmt den Wert direkt als Millisekunden (epoch_ms).",
  "Status: licensed=true → lizenziert, sonst status (completed/ongoing/hiatus/canceled). Alternative Titel nicht an die Beschreibung angehängt.",
  "authors/artists/categories sind String-Listen; Pfad 'x.*' über Listen wie in den Vorlagen."
 ]
}