  "latest": {
   "request": "{base}/",
   "items": "#MattsRecentComicsBar > ul > div",
   "fields": {
    "url": ".comicarchiveframe > a@href",
    "title": {
     "path": ".comicthumbdate",
     "regex": "^(.*?)(?: by .*)?$",
     "group": 1
    },
    "cover": ".comicarchiveframe > a img@src"
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": "{base}/?s={query}",
   "items": "h2.post-title",
   "fields": {
    "url": "a@href",
    "title": {
     "path": "a",
     "regex": "^(.*?)(?: by .*)?$",
     "group": 1
    }
   },
   "has_next": {
    "const": false
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": {
     "path": "meta[property=og:title]@content",
