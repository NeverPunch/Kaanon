     "regex": " by (.+)$",
     "group": 1
    },
    "description": {
     "path": "meta[property=og:description]@content",
     "regex": "(?s)^(.*?)(?:\\s{6,}|$)",
     "group": 1
    },
    "genres": {
     "path": "meta[property=article:section]:not(:first-of-type)@content",
     "all": true,
     "join": ", "
    },
    "cover": "meta[property=og:image]@content",
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
