{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "TmoManhwa",
  "sprache": "es",
  "base_url": "https://tmomanhwa.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.es.kaanon.tmomanhwa",
  "quellen": [
   {
    "name": "TmoManhwa",
    "sprache": "es",
    "quell_id": 6910135245684799124,
    "home": "https://tmomanhwa.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/es/tmomanhwa",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "yiimanga"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/page/{page}/",
   "items": ".latest-list .latest-item, .list .list-item",
   "has_next": {
    "exists": "#pagination li.next a"
   },
   "fields": {
    "url": [
     ".latest-right a:has(h3, h4)@href",
     ".item-title a@href"
    ],
    "title": [
     ".latest-right a:has(h3, h4)",
     ".item-title a"
    ],
    "cover": [
     ".latest-left img@src",
     ".item-img img@src"
    ]
   }
  },
  "search": {
   "request": "{base}/search/?s={query}&page={page}",
   "items": ".latest-list .latest-item, .list .list-item",
   "has_next": {
    "exists": "#pagination li.next a"
   },
   "fields": {
    "url": [
     ".latest-right a:has(h3, h4)@href",
     ".item-title a@href"
    ],
    "title": [
     ".latest-right a:has(h3, h4)",
     ".item-title a"
    ],
    "cover": [
     ".latest-left img@src",
     ".item-img img@src"
    ]
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": [
     "h1.main-info-title",
     ".post-title h1",
     ".manga-detail .info h1"
    ],
    "cover": [
     "img.img-cover@src",
     ".summary_image img@src",
     ".manga-detail .poster img@src"
    ],
    "author": {
     "path": [
      ".main-info-list li:has(> h5:contains(Autor)) > :not(h5) a@ownText",
      ".post-content_item:has(.summary-heading > h5:contains(Autor)) > :not(.summary-heading) a@ownText",
      ".info-item:has(> span.sh:contains(Autor)) > :not(.sh) a@ownText",
      ".main-info-list li:has(> h5:contains(Autor)) > :not(h5)",
      ".post-content_item:has(.summary-heading > h5:contains(Autor)) > :not(.summary-heading)",
      ".info-item:has(> span.sh:contains(Autor)) > :not(.sh)"
     ],
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": [
      ".main-info-list li:has(> h5:contains(Artista)) > :not(h5) a@ownText",
      ".post-content_item:has(.summary-heading > h5:contains(Artista)) > :not(.summary-heading) a@ownText",
      ".info-item:has(> span.sh:contains(Artista)) > :not(.sh) a@ownText",
      ".main-info-list li:has(> h5:contains(Artista)) > :not(h5)",
      ".post-content_item:has(.summary-heading > h5:contains(Artista)) > :not(.summary-heading)",
      ".info-item:has(> span.sh:contains(Artista)) > :not(.sh)"
     ],
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": [
      ".main-info-list li:has(> h5:contains(Género)) > :not(h5) a@ownText",
      ".post-content_item:has(.summary-heading > h5:contains(Género)) > :not(.summary-heading) a@ownText",
      ".info-item:has(> span.sh:contains(Género)) > :not(.sh) a@ownText",
      ".main-info-list li:has(> h5:contains(Género)) > :not(h5)",
      ".post-content_item:has(.summary-heading > h5:contains(Género)) > :not(.summary-heading)",
      ".info-item:has(> span.sh:contains(Género)) > :not(.sh)"
     ],
     "all": true,
     "join": ", "
    },
    "status": [
     ".main-info-list li:has(> h5:contains(Estado)) > :not(h5)",
     ".post-content_item:has(.summary-heading > h5:contains(Estado)) > :not(.summary-heading)",
     ".info-item:has(> span.sh:contains(Estado)) > :not(.sh)",
     ".manga-detail .info p.type"
    ],
    "description": {
     "path": [
      ".short-desc-content p, .short-desc-content li",
      ".dsct p, .dsct li",
      ".description-summary p, .description-summary li",
      ".short-desc-content",
      ".dsct",
      ".description-summary"
     ],
     "all": true,
     "join": "\n\n"
    }
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "ul.chapter-list li, ul.row-content-chapter li, .list-items li.item",
   "fields": {
    "url": "a[href]@href",
    "name": [
     ".chapter-name",
     "a > span:first-child"
    ],
    "date": [
     ".ct-update",
     ".chapter-time",
     "a > span:nth-child(2)"
    ]
   },
   "date_format": [
    "dd MMM yyyy",
    "dd MMM yy",
    "MMM yy"
   ],
   "date_locale": "en"
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".reading-content img, .read-content img",
   "image": "@src"
  }
 },
 "hinweise": [
  "Aufgebaut wie en.hentai20unoriginal (gleiches Theme), Info-Beschriftungen spanisch (Autores, Artistas, Géneros, Estado).",
  "Theme Yiimanga ohne popularPath: Beliebt = Neueste-Liste /page/N/ (Code bietet keine eigene Neueste), Suche /search/?s=…&page=N; Genre-Filter (/genero/…) nicht nachgebaut.",
  "Status nur 'ongoing'/'completed' wie im Code (spanische Werte bleiben unbekannt).",
  "Datum wie im Code mit englischem Monatsformat (dd MMM yyyy / dd MMM yy / MMM yy).",
  "Info-Zeilen über :has()/:contains() auf die Überschrift (h5 bzw. span.sh) nachgebildet; Code vergleicht exakt."
 ]
}