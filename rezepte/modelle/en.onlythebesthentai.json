{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Only The Best Hentai",
  "sprache": "en",
  "base_url": "https://onlythebesthentai.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.onlythebesthentai",
  "quellen": [
   {
    "name": "Only The Best Hentai",
    "sprache": "en",
    "quell_id": 5862792365006156918,
    "home": "https://onlythebesthentai.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/onlythebesthentai",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/page/{page}/",
   "request_by_page": {
    "1": "{base}/"
   },
   "items": "article.post:has(.blog-entry-title a, .entry-title a)",
   "fields": {
    "url": [
     ".blog-entry-title a@href",
     ".entry-title a@href"
    ],
    "title": {
     "path": [
      ".blog-entry-title a",
      ".entry-title a"
     ],
     "replace": [
      [
       "\\s*\\[\\d+]\\s*$",
       ""
      ]
     ]
    },
    "cover": ".nv-post-thumbnail-wrap img@img"
   },
   "has_next": {
    "exists": "a.next.page-numbers"
   }
  },
  "search": {
   "request": "{base}/?s={query}&paged={page}",
   "items": "article.post:has(.blog-entry-title a, .entry-title a)",
   "fields": {
    "url": [
     ".blog-entry-title a@href",
     ".entry-title a@href"
    ],
    "title": {
     "path": [
      ".blog-entry-title a",
      ".entry-title a"
     ],
     "replace": [
      [
       "\\s*\\[\\d+]\\s*$",
       ""
      ]
     ]
    },
    "cover": ".nv-post-thumbnail-wrap img@img"
   },
   "has_next": {
    "exists": "a.next.page-numbers"
   }
  },
  "details": {
   "request": "{abs_url}",
   "let": {
    "par": {
     "path": ".manga-tags-container:has(.manga-tags-label:containsOwn(Parody)) .tag-button",
     "all": true,
     "join": ", "
    },
    "chr": {
     "path": ".manga-tags-container:has(.manga-tags-label:containsOwn(Characters)) .tag-button",
     "all": true,
     "join": ", "
    },
    "pg": {
     "path": ".manga-tags-container:has(.manga-tags-label:containsOwn(Pages))",
     "regex": "(\\d+)",
     "group": 1
    },
    "body": {
     "path": ".manga-info p",
     "replace": [
      [
       "^\\s*Description:\\s*",
       ""
      ]
     ]
    }
   },
   "fields": {
    "title": "h1.manga-title",
    "cover": ".manga-box .manga-img img@img",
    "genres": {
     "path": ".manga-tags-container:has(.manga-tags-label:containsOwn(Tags)) .tag-button",
     "all": true,
     "join": ", "
    },
    "author": {
     "path": ".manga-tags-container:has(.manga-tags-label:containsOwn(Artist)) .tag-button",
     "all": true,
     "join": ", "
    },
    "description": {
     "const": "[[Parody: {l.par}\n]][[Characters: {l.chr}\n]][[Pages: {l.pg}\n]]\n[[{l.body}]]"
    },
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": [
     {
      "path": ".manga-tags-container:has(.manga-tags-label:containsOwn(Pages))",
      "regex": "(\\d+)",
      "group": 1,
      "template": "Chapter [{value} pages]"
     },
     {
      "const": "Chapter"
     }
    ],
    "date": "meta[property=article:published_time]@content"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".manga-gallery-wrapper figure.wp-block-image img",
   "image": "@img"
  }
 },
 "hinweise": [
  "WordPress-HTML. Website zeigt zeitweise eine Bot-Prüfseite ('One moment, please'/wsidchk); Community verweist dann auf WebView – hier nicht gelöst (Regel 0014).",
  "Ein Kapitel je Galerie = die Detailseite selbst; Name 'Chapter [N pages]', Datum aus article:published_time.",
  "Bild: bestes srcset-Bild über @img (Community wählt größte w-Angabe).",
  "Suche ?s=&paged=; Taxonomie-Filter (Tag/Parody/Character/Artist) nicht nachgebaut. Status fest abgeschlossen wie Community."
 ]
}
