{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "INKRUSH",
  "sprache": "all",
  "base_url": "https://inkrush.site",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.all.kaanon.inkrush",
  "quellen": [
   {
    "name": "INKRUSH",
    "sprache": "en",
    "quell_id": 8266025984012516367,
    "home": "https://inkrush.site"
   },
   {
    "name": "INKRUSH",
    "sprache": "id",
    "quell_id": 4051674970574307340,
    "home": "https://inkrush.site"
   }
  ]
 },
 "quelle": {
  "modul": "src/all/inkrush",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/api/library?action=catalog&q=&language=en&category=popular&page={page}",
   "format": "json",
   "items": "comics",
   "has_next": {
    "exists": "hasNextPage"
   },
   "fields": {
    "url": {
     "path": "id",
     "template": "/#title/{value}"
    },
    "title": "title",
    "cover": {
     "path": "cover",
     "template": "{base}{value}"
    }
   }
  },
  "latest": {
   "request": "{base}/api/library?action=catalog&q=&language=en&category=latest&page={page}",
   "format": "json",
   "items": "comics",
   "has_next": {
    "exists": "hasNextPage"
   },
   "fields": {
    "url": {
     "path": "id",
     "template": "/#title/{value}"
    },
    "title": "title",
    "cover": {
     "path": "cover",
     "template": "{base}{value}"
    }
   }
  },
  "search": {
   "request": "{base}/api/library?action=catalog&q={query}&language=en&category=trending&page={page}",
   "format": "json",
   "items": "comics",
   "has_next": {
    "exists": "hasNextPage"
   },
   "fields": {
    "url": {
     "path": "id",
     "template": "/#title/{value}"
    },
    "title": "title",
    "cover": {
     "path": "cover",
     "template": "{base}{value}"
    }
   }
  },
  "details": {
   "request": "{base}/api/library?action=detail&id={u.id}&language=en&compact=1",
   "format": "json",
   "url_vars": {
    "id": "#title/([^/]+)$"
   },
   "fields": {
    "title": "title",
    "cover": {
     "path": "cover",
     "template": "{base}{value}"
    },
    "author": "author",
    "description": "description",
    "genres": {
     "path": [
      "format",
      "genre",
      "themes"
     ],
     "union": true,
     "all": true,
     "join": ", "
    },
    "status": "status"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "hiatus": 6,
    "cancelled": 5
   }
  },
  "chapters": {
   "request": "details",
   "format": "json",
   "url_vars": {
    "id": "#title/([^/]+)$"
   },
   "items": "chapters",
   "reverse": true,
   "fields": {
    "url": {
     "path": "id",
     "template": "/#read/{u.id}/{value}"
    },
    "name": "name",
    "number": "chapterNumber",
    "date": "releaseDate"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{base}/api/library?action=pages&id={u.cid}",
   "format": "json",
   "url_vars": {
    "cid": "#read/[^/]+/([^/]+)$"
   },
   "items": "pages",
   "image": {
    "path": "src",
    "template": "{base}{value}"
   }
  }
 },
 "hinweise": [
  "API {base}/api/library?action=catalog|detail|pages. Zwei Community-Quellen (en, id) unterscheiden sich nur im Parameter language; das Modell folgt der en-Quelle.",
  "Manga-URL /#title/{id}, Kapitel-URL /#read/{mangaId}/{kapitelId} wie die Web-Adressen im Code.",
  "Suche mit Kategorie 'trending' (Filter-Standard im Code). Alternativtitel nicht an die Beschreibung angehängt.",
  "Seiten ohne release-Parameter (Standardgruppe der Website) wie im Code."
 ]
}