{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Kiryuu",
  "sprache": "id",
  "base_url": "https://v7.kiryuu.to",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.id.kaanon.kiryuu",
  "quellen": [
   {
    "name": "Kiryuu",
    "sprache": "id",
    "quell_id": 3639673976007021338,
    "home": "https://v7.kiryuu.to"
   }
  ]
 },
 "quelle": {
  "modul": "src/id/kiryuu",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.61",
  "theme": "natsuid"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 4,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/wp-json/wp/v2/manga?per_page=20&page={page}&_embed",
   "format": "json",
   "items": "$",
   "page_size": 20,
   "has_next": {
    "full": true
   },
   "skip": {
    "path": "_embedded.wp:term.*.?taxonomy=type.name",
    "regex": "^Novel$"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/manga/{value}/#{f.id}"
    },
    "title": {
     "path": "title.rendered",
     "decode": "html"
    },
    "cover": [
     "_embedded.wp:featuredmedia.0.source_url",
     "yoast_head_json.og_image.0.url"
    ]
   }
  },
  "latest": {
   "request": "{base}/wp-json/wp/v2/manga?per_page=20&page={page}&_embed&orderby=modified&order=desc",
   "format": "json",
   "items": "$",
   "page_size": 20,
   "has_next": {
    "full": true
   },
   "skip": {
    "path": "_embedded.wp:term.*.?taxonomy=type.name",
    "regex": "^Novel$"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/manga/{value}/#{f.id}"
    },
    "title": {
     "path": "title.rendered",
     "decode": "html"
    },
    "cover": [
     "_embedded.wp:featuredmedia.0.source_url",
     "yoast_head_json.og_image.0.url"
    ]
   }
  },
  "search": {
   "request": "{base}/wp-json/wp/v2/manga?per_page=20&page={page}&_embed&search={query}",
   "format": "json",
   "items": "$",
   "page_size": 20,
   "has_next": {
    "full": true
   },
   "skip": {
    "path": "_embedded.wp:term.*.?taxonomy=type.name",
    "regex": "^Novel$"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/manga/{value}/#{f.id}"
    },
    "title": {
     "path": "title.rendered",
     "decode": "html"
    },
    "cover": [
     "_embedded.wp:featuredmedia.0.source_url",
     "yoast_head_json.og_image.0.url"
    ]
   }
  },
  "details": {
   "request": "{base}/wp-json/wp/v2/manga/{u.id}?_embed",
   "format": "json",
   "url_vars": {
    "id": "#(\\d+)$"
   },
   "fields": {
    "title": {
     "path": "title.rendered",
     "decode": "html"
    },
    "cover": [
     "_embedded.wp:featuredmedia.0.source_url",
     "yoast_head_json.og_image.0.url"
    ],
    "description": {
     "path": "content.rendered",
     "decode": "html_text",
     "template": "{value}[[\n\nAlternative Names: {f.meta.meta.alternative_title}]][[\n\nAlternative Names: {f.metadata.meta.alternative_title}]]"
    },
    "author": {
     "path": "_embedded.wp:term.*.?taxonomy=series-author.name",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "_embedded.wp:term.*.?taxonomy=artist.name",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": [
      "_embedded.wp:term.*.?taxonomy=genre.name",
      "_embedded.wp:term.*.?taxonomy=type.name"
     ],
     "union": true
    },
    "status": "_embedded.wp:term.*.?taxonomy=status.name"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "cancelled": 5,
    "on hiatus": 6
   }
  },
  "chapters": {
   "request": "{base}/wp-admin/admin-ajax.php?manga_id={u.id}&page=1&action=chapter_list",
   "format": "html",
   "url_vars": {
    "id": "#(\\d+)$"
   },
   "items": "div a:has(time)",
   "fields": {
    "url": "@href",
    "name": "span@ownText",
    "date": "time@datetime"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "format": "html",
   "items": "section[data-image-data] img",
   "image": "@src",
   "referer": "chapter"
  }
 },
 "hinweise": [
  "Theme NatsuId: Community sucht über admin-ajax.php?action=advanced_search (multipart, mit nonce aus get_nonce) und lädt danach die Treffer per wp-json nach – zweistufige Listen + multipart nicht abbildbar.",
  "Ersatz: Listen direkt aus der WordPress-REST-API /wp-json/wp/v2/manga (_embed), die die Community für Details ohnehin nutzt. Beliebt = Standardreihenfolge der API (Datum), da REST keine Aufrufzahlen kennt; Neueste = orderby=modified; Suche = search=.",
  "Manga-URL /manga/<slug>/#<id> (Muster wie en.roliascan); id für Details (wp/v2/manga/<id>) und Kapitel (admin-ajax.php?action=chapter_list).",
  "Novels über Taxonomie type=Novel ausgeblendet. Genres = genre + type. Alternativtitel aus meta.meta.alternative_title (bzw. metadata) roh angehängt.",
  "Datum: time@datetime als ISO; Community probiert zuerst ggf. ein eigenes dateFormat.",
  "Kiryuu: Kapitelliste mit page=1 (Override), Rate-Limit 4/s."
 ]
}