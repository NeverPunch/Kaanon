{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Manga Mukai",
  "sprache": "es",
  "base_url": "https://mangamukai.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.es.kaanon.mangamukai",
  "quellen": [
   {
    "name": "Manga Mukai",
    "sprache": "es",
    "quell_id": 711368877221654433,
    "home": "https://mangamukai.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/es/mangashiina",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.3",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/wp-json/mangamukai/v1/catalog",
   "format": "json",
   "items": "mangas",
   "has_next": {
    "const": false
   },
   "fields": {
    "url": {
     "path": "id",
     "template": "/manga/{value}"
    },
    "title": "titulo",
    "cover": "portada"
   },
   "sort": {
    "path": "totalViews",
    "order": "desc",
    "limit": 2000
   }
  },
  "latest": {
   "request": "{base}/wp-json/mangamukai/v1/catalog",
   "format": "json",
   "items": "mangas",
   "has_next": {
    "const": false
   },
   "fields": {
    "url": {
     "path": "id",
     "template": "/manga/{value}"
    },
    "title": "titulo",
    "cover": "portada"
   },
   "sort": {
    "path": "latest_update_at",
    "order": "desc",
    "limit": 2000
   }
  },
  "search": {
   "request": "{base}/wp-json/mangamukai/v1/catalog",
   "format": "json",
   "items": "mangas",
   "has_next": {
    "const": false
   },
   "fields": {
    "url": {
     "path": "id",
     "template": "/manga/{value}"
    },
    "title": "titulo",
    "cover": "portada"
   },
   "client_filter": true
  },
  "details": {
   "request": "{base}/wp-json/mangamukai/v1/manga/{u.id}",
   "format": "json",
   "url_vars": {
    "id": "/manga/(\\d+)"
   },
   "let": {
    "syn": {
     "path": "descripcion",
     "replace": [
      [
       "\\r\\n",
       "\n"
      ]
     ]
    }
   },
   "fields": {
    "title": "titulo",
    "cover": "portada",
    "genres": {
     "path": [
      "tipo",
      "genres.*"
     ],
     "union": true
    },
    "description": {
     "const": "[[{l.syn}]][[\n\nTítulo original: {f.titulo_original}]]",
     "replace": [
      [
       "^\\n+",
       ""
      ]
     ]
    },
    "status": "status"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "hiatus": 6
   }
  },
  "chapters": {
   "request": "{base}/wp-json/mangamukai/v1/series/{u.id}/chapters",
   "format": "json",
   "url_vars": {
    "id": "/manga/(\\d+)"
   },
   "items": "chapters",
   "skip": "is_paid",
   "reverse": true,
   "fields": {
    "url": {
     "path": "id",
     "template": "/read/{value}"
    },
    "name": "title",
    "number": "chapter_number",
    "date": "created_at"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{base}/wp-json/mangamukai/v1/chapters/content?id={u.id}",
   "format": "json",
   "url_vars": {
    "id": "/read/(\\d+)"
   },
   "items": "images",
   "image": ""
  }
 },
 "hinweise": [
  "WP-REST-Erweiterung /wp-json/mangamukai/v1 wie Community. Beliebt/Neueste/Suche aus dem Gesamtkatalog (/catalog): Beliebt nach totalViews, Neueste nach latest_update_at absteigend sortiert (sort mit limit 2000), Suche lokal per client_filter (Community: alle Wörter im normalisierten Titel). Typ-/Genre-Filter nicht übernommen.",
  "Manga-URL /manga/<id>, Kapitel-URL /read/<id> (Community speichert die IDs, Web-URLs identisch). Alte MangaThemesia-URLs (/manga/<slug>/) werden nicht aufgelöst.",
  "Bezahlkapitel (is_paid) ausgelassen (Regel 0014; Community zeigt sie mit Schloss, Seiten liefern 401). Kapitelliste umgedreht wie Community (asReversed).",
  "Beschreibung: Community entfernt den am Anfang wiederholten Titel aus descripcion – hier nicht (Präfix-Entfernung mit Feldwert nicht belegt)."
 ]
}
