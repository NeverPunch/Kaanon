{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Gangan Online",
  "sprache": "ja",
  "base_url": "https://www.ganganonline.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.ja.kaanon.ganganonline",
  "quellen": [
   {
    "name": "Gangan Online",
    "sprache": "ja",
    "quell_id": 1467355738916791140,
    "home": "https://www.ganganonline.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/ja/ganganonline",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/rensai",
   "format": "next_data",
   "items": "props.pageProps.data.titleSections.*.titles.*",
   "skip": {
    "path": "isNovel",
    "equals": "true"
   },
   "fields": {
    "url": {
     "path": "titleId",
     "template": "/title/{value}"
    },
    "title": [
     "title",
     "header",
     "name"
    ],
    "cover": {
     "path": "imageUrl",
     "template": "{base}{value}"
    }
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": "{base}/search/result?keyword={query}",
   "format": "next_data",
   "items": "props.pageProps.data.sections.*.titleLinks.*",
   "skip": {
    "path": "isNovel",
    "equals": "true"
   },
   "fields": {
    "url": {
     "path": "titleId",
     "template": "/title/{value}"
    },
    "title": [
     "title",
     "header",
     "name"
    ],
    "cover": {
     "path": "imageUrl",
     "template": "{base}{value}"
    }
   },
   "has_next": {
    "const": false
   }
  },
  "details": {
   "request": "{abs_url}",
   "format": "next_data",
   "fields": {
    "title": "props.pageProps.data.default.titleName",
    "author": "props.pageProps.data.default.author",
    "description": "props.pageProps.data.default.description",
    "cover": {
     "path": "props.pageProps.data.default.imageUrl",
     "template": "{base}{value}"
    }
   }
  },
  "chapters": {
   "request": "details",
   "format": "next_data",
   "url_vars": {
    "id": "/title/(\\d+)"
   },
   "items": "props.pageProps.data.default.chapters",
   "skip": {
    "path": "status",
    "regex": "^[0-3]$"
   },
   "fields": {
    "url": {
     "path": "id",
     "template": "/title/{u.id}/chapter/{value}"
    },
    "name": {
     "path": "mainText",
     "template": "{value}[[ - {f.subText}]]"
    },
    "date": {
     "path": "publishingPeriod",
     "regex": "^\\s*([0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,2})",
     "group": 1
    }
   },
   "date_format": "yyyy.M.d"
  },
  "pages": {
   "request": "{abs_url}",
   "format": "next_data",
   "items": "props.pageProps.data.pages",
   "image": [
    {
     "path": "image.imageUrl",
     "template": "{base}{value}"
    },
    {
     "path": "linkImage.imageUrl",
     "template": "{base}{value}"
    }
   ]
  }
 },
 "hinweise": [
  "Alle Daten aus __NEXT_DATA__ (props.pageProps.data). Beliebt = /rensai (titleSections[*].titles[*], doppeltes * wie es.manhwaweb), Suche /search/result?keyword=… (sections[*].titleLinks[*]); Novels übersprungen. Kategorien /finish, /pixiv, /ga (Filter) nicht nachgebaut; kein 'Neueste'.",
  "Kapitel: nur status leer oder ≥ 4 (wie Community; niedrigere Status = nicht lesbar). Datum = Anfang von publishingPeriod (yyyy.M.d).",
  "Seiten: image.imageUrl, sonst linkImage.imageUrl, jeweils mit Basis-URL davor. Die Kapitel-URL /title/<id>/chapter/<cid> wie Community (Community nimmt den Pfad nach einer Weiterleitung)."
 ]
}
