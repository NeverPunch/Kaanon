{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "ZettaHQ",
  "sprache": "pt-BR",
  "base_url": "https://zettahq.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.pt-BR.kaanon.zettahq",
  "quellen": [
   {
    "name": "ZettaHQ",
    "sprache": "pt-BR",
    "quell_id": 4655858297496198897,
    "home": "https://zettahq.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/pt/zettahq",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/page/{page}",
   "items": "div.post-item article",
   "fields": {
    "url": "h3 a@href",
    "title": "h3 a",
    "cover": "img@src"
   },
   "has_next": {
    "exists": ".next.page-numbers"
   }
  },
  "search": {
   "request": "{base}/page/{page}?s={query}",
   "items": "div.post-item article",
   "fields": {
    "url": "h3 a@href",
    "title": "h3 a",
    "cover": "img@src"
   },
   "has_next": {
    "exists": ".next.page-numbers"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1",
    "cover": ".content-container article img:first-child@src",
    "genres": {
     "path": ".tags > a.tag",
     "all": true,
     "join": ", "
    },
    "author": "strong:contains(Autor) + a",
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "const": "Capítulo Único"
    }
   }
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".content-container article img",
   "image": "@src"
  }
 },
 "hinweise": [
  "WordPress-Seite ohne Theme-Baukasten, HTML wie Community: Liste /page/<n>, Suche /page/<n>?s=… (Kategorie-/Genre-/Autor-Filter nicht übernommen). Keine Neueste-Liste (Community: supportsLatest=false).",
  "Ein Kapitel 'Capítulo Único' mit der Eintrags-URL (wie Community, Muster wie andere Einzel-Kapitel-Rezepte). Status immer abgeschlossen.",
  "Seiten: alle img in .content-container article (Community nimmt src)."
 ]
}
