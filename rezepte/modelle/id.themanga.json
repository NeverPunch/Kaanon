{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "TheManga",
  "sprache": "id",
  "base_url": "https://themanga.site",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.id.kaanon.themanga",
  "quellen": [
   {
    "name": "TheManga",
    "sprache": "id",
    "quell_id": 4154955713546598190,
    "home": "https://themanga.site"
   }
  ]
 },
 "quelle": {
  "modul": "src/id/themanga",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.51",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/?q=&sort=popular&page={page}",
   "items": "a.card:has(.card-title), a.manga-card:has(.card-title)",
   "fields": {
    "url": "@href",
    "title": ".card-title",
    "cover": "img@src"
   },
   "has_next": {
    "exists": ".explore-pagination__btn[rel=next], a[rel=next]"
   }
  },
  "latest": {
   "request": "{base}/?q=&sort=latest_update&page={page}",
   "items": "a.card:has(.card-title), a.manga-card:has(.card-title)",
   "fields": {
    "url": "@href",
    "title": ".card-title",
    "cover": "img@src"
   },
   "has_next": {
    "exists": ".explore-pagination__btn[rel=next], a[rel=next]"
   }
  },
  "search": {
   "request": "{base}/explore?q={query}&page={page}",
   "items": "a.card:has(.card-title), a.manga-card:has(.card-title)",
   "fields": {
    "url": "@href",
    "title": ".card-title",
    "cover": "img@src"
   },
   "has_next": {
    "exists": ".explore-pagination__btn[rel=next], a[rel=next]"
   }
  },
  "details": {
   "request": "{abs_url}?all=1",
   "fields": {
    "title": ".hero-title",
    "cover": ".hero-cover img@src",
    "description": ".synopsis-text",
    "author": ".meta-item-label:matchesOwn(^Author$) + .meta-item-value",
    "artist": ".meta-item-label:matchesOwn(^Artist$) + .meta-item-value",
    "genres": ".meta-pill-row .meta-pill, .meta-item-label:matchesOwn(^Type$) + .meta-item-value",
    "status": ".hero-status-badge"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": ".chapter-row",
   "fields": {
    "url": "@data-href",
    "name": ".chapter-title",
    "date": "[data-local-time]@data-local-time"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "img.page-img",
   "image": "@src"
  }
 },
 "hinweise": [
  "Listen wie Community (?sort=popular/latest_update, Suche /explore?q=); Status/Genre/weitere Textfilter nicht nachgebaut.",
  "Details mit ?all=1 (alle Kapitel auf einer Seite), Kapitel aus derselben Seite.",
  "Alte Madara-Kapitel-URLs (ohne /chapter/) rechnet die Community auf das neue Schema um – nur für Migration relevant, nicht nachgebaut."
 ]
}
