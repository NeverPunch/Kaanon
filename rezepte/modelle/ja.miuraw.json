{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "MiuRaw",
  "sprache": "ja",
  "base_url": "https://miuraw.net",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.ja.kaanon.miuraw",
  "quellen": [
   {
    "name": "MiuRaw",
    "sprache": "ja",
    "quell_id": 7950551186567193810,
    "home": "https://miuraw.net"
   }
  ]
 },
 "quelle": {
  "modul": "src/ja/miuraw",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.4",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/manga/page/{page}/?orderby=views",
   "items": ".manga-card",
   "fields": {
    "url": "a.manga-card-thumb@href",
    "title": {
     "path": ".manga-card-title",
     "replace": [
      [
       " \\(Raw – Free\\)$",
       ""
      ]
     ]
    },
    "cover": ".manga-card-thumb img@src"
   },
   "has_next": {
    "exists": ".pagination a:has(i.fa-chevron-right)"
   }
  },
  "latest": {
   "request": "{base}/manga/page/{page}/?orderby=date",
   "items": ".manga-card",
   "fields": {
    "url": "a.manga-card-thumb@href",
    "title": {
     "path": ".manga-card-title",
     "replace": [
      [
       " \\(Raw – Free\\)$",
       ""
      ]
     ]
    },
    "cover": ".manga-card-thumb img@src"
   },
   "has_next": {
    "exists": ".pagination a:has(i.fa-chevron-right)"
   }
  },
  "search": {
   "request": "{base}/page/{page}/?s={query}&post_type=manga",
   "items": ".manga-card",
   "fields": {
    "url": "a.manga-card-thumb@href",
    "title": {
     "path": ".manga-card-title",
     "replace": [
      [
       " \\(Raw – Free\\)$",
       ""
      ]
     ]
    },
    "cover": ".manga-card-thumb img@src"
   },
   "has_next": {
    "exists": ".pagination a:has(i.fa-chevron-right)"
   },
   "request_by_page": {
    "1": "{base}/?s={query}&post_type=manga"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": {
     "path": ".md-title",
     "replace": [
      [
       " \\(Raw – Free\\)$",
       ""
      ]
     ]
    },
    "author": {
     "path": ".md-meta-row:has(.fa-user) .md-meta-val",
     "replace": [
      [
       "^更新中$",
       ""
      ]
     ]
    },
    "status": {
     "path": ".md-meta-row:has(.fa-rss) .md-meta-val",
     "regex": "(連載中|完結)",
     "group": 1
    },
    "genres": ".md-tag",
    "description": ".md-desc-content",
    "cover": ".md-cover img@src"
   },
   "status_map": {
    "連載中": 1,
    "完結": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": ".md-chapter-row",
   "fields": {
    "url": ".md-chapter-name a@href",
    "name": ".md-chapter-name a@ownText",
    "date": {
     "path": ".md-chapter-time",
     "replace": [
      [
       "^.*昨日.*$",
       "1 day ago"
      ],
      [
       "^\\D*(\\d+)\\D*秒.*$",
       "$1 seconds ago"
      ],
      [
       "^\\D*(\\d+)\\D*分.*$",
       "$1 minutes ago"
      ],
      [
       "^\\D*(\\d+)\\D*時.*$",
       "$1 hours ago"
      ],
      [
       "^\\D*(\\d+)\\D*日.*$",
       "$1 days ago"
      ],
      [
       "^\\D*(\\d+)\\D*週.*$",
       "$1 weeks ago"
      ],
      [
       "^\\D*(\\d+)\\D*月.*$",
       "$1 months ago"
      ],
      [
       "^\\D*(\\d+)\\D*年.*$",
       "$1 years ago"
      ]
     ]
    }
   },
   "date_format": "relative",
   "date_locale": "en"
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".reader-page img",
   "image": {
    "path": "@src",
    "template": "{base}/wp-content/themes/manga-theme-MangaVerse/img-proxy.php?url={value}"
   }
  }
 },
 "hinweise": [
  "Listen /manga/page/N/?orderby=views|date, Suche /[page/N/]?s=…&post_type=manga; nächste Seite über den Pfeil-Link (Community verlangt zusätzlich ≥40 Einträge).",
  "Titel ohne Zusatz ' (Raw – Free)' wie Community. Autor-Platzhalter 更新中 wird geleert.",
  "Datum relativ auf Japanisch (…秒前/分前/時間前/日前/週間前/ヶ月前/年前); per replace in englische Angaben umgeschrieben und mit 'relative' gelesen – prüfen.",
  "Bilder über den Bild-Proxy der Website (img-proxy.php?url=<Bild-URL>) wie Community; die Bild-URL wird hier nicht URL-kodiert eingesetzt und bereits geproxte URLs werden nicht erkannt – prüfen.",
  "Basis-URL ist in der Community frei einstellbar (custom); hier https://miuraw.net."
 ]
}
