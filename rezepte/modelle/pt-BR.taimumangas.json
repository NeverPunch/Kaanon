{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "TaimuMangas",
  "sprache": "pt-BR",
  "base_url": "https://beta.taimumangas.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.pt-BR.kaanon.taimumangas",
  "quellen": [
   {
    "name": "Taimu Mangas",
    "sprache": "pt-BR",
    "quell_id": 8914871231496469978,
    "home": "https://beta.taimumangas.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/pt/taimumangas",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Accept": "application/json"
  },
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "https://api.taimumangas.com/api/v1/reader/library?page={page}&per_page=24&adult=true&sort=rating&order=desc",
   "format": "json",
   "items": "items",
   "fields": {
    "url": {
     "path": "identifier",
     "template": "/series/{value}"
    },
    "title": "title",
    "cover": "cover"
   },
   "page_size": 24,
   "has_next": {
    "total": "total"
   }
  },
  "latest": {
   "request": "https://api.taimumangas.com/api/v1/reader/updates?page={page}&per_page=24&adult_mode=true",
   "format": "json",
   "items": "items",
   "fields": {
    "url": {
     "path": "series_identifier",
     "template": "/series/{value}"
    },
    "title": "series_title",
    "cover": "series_cover"
   },
   "has_next": {
    "exists": "has_more"
   }
  },
  "search": {
   "request": "https://api.taimumangas.com/api/v1/reader/library?page={page}&per_page=24&adult=true&q={query}",
   "format": "json",
   "items": "items",
   "fields": {
    "url": {
     "path": "identifier",
     "template": "/series/{value}"
    },
    "title": "title",
    "cover": "cover"
   },
   "page_size": 24,
   "has_next": {
    "total": "total"
   }
  },
  "details": {
   "request": "https://api.taimumangas.com/api/v1/reader/series/{u.id}",
   "format": "json",
   "url_vars": {
    "id": "/series/([^/?#]+)"
   },
   "let": {
    "syn": "synopsis",
    "typ": "type",
    "grp": "group.name",
    "adult": {
     "path": "adult",
     "replace": [
      [
       "^true$",
       "Conteudo adulto"
      ],
      [
       "^false$",
       ""
      ]
     ]
    }
   },
   "fields": {
    "title": "title",
    "cover": "cover",
    "author": {
     "path": "authors.*.name",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "artists.*.name",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": "genres.*.name",
     "all": true,
     "join": ", "
    },
    "status": "status",
    "description": {
     "const": "[[{l.syn}]][[\n\nTipo: {l.typ}]][[\n\nScanlator: {l.grp}]][[\n\n{l.adult}]]",
     "replace": [
      [
       "^\\s+|\\s+$",
       ""
      ]
     ]
    }
   },
   "status_map": {
    "ongoing": 1,
    "finished": 2,
    "hiatus": 6,
    "dropped": 5
   }
  },
  "chapters": {
   "request": "https://api.taimumangas.com/api/v1/reader/series/{u.id}/chapters?page={page}&per_page=100&order=desc",
   "format": "json",
   "url_vars": {
    "id": "/series/([^/?#]+)"
   },
   "items": "items",
   "fields": {
    "url": {
     "path": "identifier",
     "template": "/reader/{value}"
    },
    "name": {
     "path": "number",
     "template": "Capitulo {value}"
    },
    "number": "number",
    "date": "published_at"
   },
   "date_format": "iso",
   "paging": {
    "has_next": {
     "exists": "has_more"
    },
    "max_pages": 50
   }
  },
  "pages": {
   "request": "https://api.taimumangas.com/api/v1/reader/chapters/{u.cid}?adult=true",
   "format": "json",
   "url_vars": {
    "cid": "/reader/([^/?#]+)"
   },
   "items": "pages",
   "image": "url",
   "sort": "number"
  }
 },
 "hinweise": [
  "JSON-API api.taimumangas.com/api/v1/reader wie Community: Beliebt /library?sort=rating&order=desc, Neueste /updates (adult_mode=true, has_more), Suche /library?q=. Status-/Typ-/Sortier-/Genre-Filter nicht übernommen.",
  "Eintrags-URL /series/<identifier>, Kapitel-URL /reader/<identifier> (Web-URLs wie Community getMangaUrl/getChapterUrl; Community speichert nur den identifier).",
  "Kapitel: /series/<id>/chapters, 100 je Seite, Blättern solange has_more (max. 50 Seiten).",
  "Seiten: /chapters/<id>?adult=true, nach number aufsteigend sortiert (sort wie en.atsumaru)."
 ]
}
