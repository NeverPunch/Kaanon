{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "MirrorKomik",
  "sprache": "id",
  "base_url": "https://mirrorkomik.info",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.id.kaanon.mirrorkomik",
  "quellen": [
   {
    "name": "MirrorKomik",
    "sprache": "id",
    "quell_id": 6916717115805451393,
    "home": "https://mirrorkomik.info"
   }
  ]
 },
 "quelle": {
  "modul": "src/id/mirrorkomik",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/",
   "items": ".serieslist.pop li",
   "fields": {
    "url": ".leftseries h2 a@href",
    "title": ".leftseries h2 a",
    "cover": "img@img"
   },
   "has_next": {
    "const": false
   }
  },
  "latest": {
   "request": {
    "url": "{base}/loadmore-type?type=Komik",
    "headers": {
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json_html",
   "html_path": "html",
   "items": "a.komik-card, .bsx > a",
   "fields": {
    "url": "@href",
    "title": "h3, .tt",
    "cover": "img@img"
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": {
    "url": "{base}/loadmore-search?keyword={query}",
    "headers": {
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json_html",
   "html_path": "html",
   "items": "a.komik-card, .bsx > a",
   "fields": {
    "url": "@href",
    "title": "h3, .tt",
    "cover": "img@img"
   },
   "has_next": {
    "const": false
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": {
     "path": "h1.entry-title",
     "replace": [
      [
       " Bahasa Indonesia$",
       ""
      ]
     ]
    },
    "cover": ".thumb img@img",
    "description": ".entry-content[itemprop=description]",
    "author": ".fmed:has(b:contains(Author)) span",
    "genres": ".mgen a, .tsinfo .imptdt:contains(Type) a",
    "status": ".tsinfo .imptdt:contains(Status) i"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "hiatus": 6
   }
  },
  "chapters": {
   "request": "details",
   "items": "#chapterlist li",
   "fields": {
    "url": "a@href",
    "name": ".chapternum"
   }
  },
  "pages": {
   "request": "{abs_url}",
   "let": {
    "tok": "#thisch@data-token"
   },
   "then": [
    {
     "request": {
      "url": "{base}/chapter/listchap,{l.tok}",
      "headers": {
       "X-Requested-With": "XMLHttpRequest",
       "Referer": "{abs_url}"
      }
     },
     "format": "json"
    }
   ],
   "items": "$",
   "image": {
    "path": "",
    "replace": [
     [
      "^https?://(.*/media/.*)$",
      "https://i0.wp.com/$1"
     ]
    ]
   },
   "exclude": "/public/img/(?!Users/)"
  }
 },
 "hinweise": [
  "Beliebt = Startseite (.serieslist.pop), nur eine Seite wie in der Community.",
  "Neueste/Suche über /loadmore-type bzw. /loadmore-search (JSON mit html). Weitere Seiten brauchen den Cursor last_id/last_score aus der vorigen Antwort – nicht ausdrückbar, daher nur die erste Seite (has_next const false).",
  "Genre-/Typfilter nicht nachgebaut.",
  "Kapitelliste hat keine Daten (Community setzt nur beim neuesten Kapitel das Aktualisierungsdatum) – Datum weggelassen.",
  "Seiten: Token aus #thisch@data-token, dann /chapter/listchap,<token> (XHR, JSON-Liste). Werbebilder (/public/img/ außer /public/img/Users/) ausgefiltert, /media/-Bilder über i0.wp.com wie der Leser der Website.",
  "Kapitel, die auf /login umleiten, brauchen Anmeldung (Community verweist auf WebView) – nicht abgebildet, diese Kapitel schlagen fehl."
 ]
}
