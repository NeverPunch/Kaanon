   "request": "https://api.verdinha.wtf/capitulos/{u.cid}",
   "format": "json",
   "url_vars": {
    "cid": "/capitulo/(\\d+)"
   },
   "let": {
    "oid": "obra.obr_id",
    "sid": "obra.scan_id",
    "num": {
     "path": "cap_numero",
     "replace": [
      [
       "\\.0$",
       ""
      ]
     ]
    }
   },
