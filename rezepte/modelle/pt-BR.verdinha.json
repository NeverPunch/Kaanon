  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "greenshit"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "scan-id": "1"
  },
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "https://api.verdinha.wtf/obras/ranking?tipo=visualizacoes_geral&limite=26&pagina={page}&gen_id=1",
   "format": "json",
   "items": "obras",
   "page_size": 26,
   "has_next": {
    "full": true
   },
   "fields": {
    "url": {
     "path": "obr_id",
     "template": "/obra/{value}"
    },
    "title": "obr_nome",
    "cover": [
     {
      "path": "obr_imagem",
      "regex": "^((?:https?://|manga_|WP-manga|uploads/|wp-content/).*)$",
      "replace": [
       [
        "^manga_",
        "https://api.verdinha.wtf/cdn/wp-content/uploads/WP-manga/data/manga_"
       ],
       [
        "^WP-manga",
        "https://api.verdinha.wtf/cdn/wp-content/uploads/WP-manga"
       ],
       [
        "^uploads/",
        "https://api.verdinha.wtf/cdn/wp-content/uploads/"
       ],
       [
        "^wp-content/",
        "https://api.verdinha.wtf/cdn/wp-content/"
       ],
       [
        "(?<!:)/{2,}",
        "/"
       ]
      ]
     },
     {
      "path": "obr_imagem",
      "replace": [
       [
        "^/+",
        ""
       ]
      ],
      "template": "[[https://api.verdinha.wtf/cdn/scans/{f.scan_id}/obras/{f.obr_id}/{value}?width=300]]"
     }
    ]
   }
  },
  "latest": {
