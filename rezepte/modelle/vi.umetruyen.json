{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "UmeTruyen",
  "sprache": "vi",
  "base_url": "https://umetruyenz.org",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.vi.kaanon.umetruyen",
  "quellen": [
   {
    "name": "UmeTruyen",
    "sprache": "vi",
    "quell_id": 2473081822885310816,
    "home": "https://umetruyenz.org"
   }
  ]
 },
 "quelle": {
  "modul": "src/vi/umetruyen",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.10",
  "theme": "manhwaz"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/",
   "items": "#slide-top > .item",
   "has_next": {
    "const": false
   },
   "fields": {
    "url": ".info-item a@href",
    "title": ".info-item a",
    "cover": ".img-item img@img"
   }
  },
  "latest": {
   "request": "{base}/?page={page}",
   "items": ".page-item-detail",
   "has_next": {
    "exists": "ul.pager a[rel=next]"
   },
   "fields": {
    "url": ".item-summary a@href",
    "title": ".item-summary a",
    "cover": ".item-thumb img@img"
   }
  },
  "search": {
   "request": "{base}/search?s={query}&page={page}",
   "items": ".page-item-detail",
   "has_next": {
    "exists": "ul.pager a[rel=next]"
   },
   "fields": {
    "url": ".item-summary a@href",
    "title": ".item-summary a",
    "cover": ".item-thumb img@img"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "div.post-title h1",
    "author": "div.summary-heading:contains(Tác giả) + div.summary-content",
    "description": "div.summary__content",
    "genres": "div.genres-content a[rel=tag]",
    "status": {
     "path": "div.summary-heading:contains(Trạng thái) + div.summary-content",
     "regex": "(?iu)(ongoing|đang ra|completed|hoàn thành|truyện full)"
    },
    "cover": "div.summary_image img@img"
   },
   "status_map": {
    "ongoing": 1,
    "đang ra": 1,
    "completed": 2,
    "hoàn thành": 2,
    "truyện full": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "li.wp-manga-chapter",
   "fields": {
    "url": "a@href",
    "name": "a",
    "date": "span.chapter-release-date"
   },
   "date_format": "relative",
   "date_locale": "vi"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div.page-break img",
   "image": "@img"
  }
 },
 "hinweise": [
  "Theme ManhwaZ (Madara-ähnliches HTML). Beliebt = Slider der Startseite (eine Seite), Neueste = /?page=N, Suche = /search?s=…&page=N.",
  "Überschriften für Autor/Status: 'Tác giả' / 'Trạng thái' (:contains, Groß/Klein egal).",
  "Status per contains in der Community; Rezept kürzt per regex auf das Schlüsselwort und mappt es.",
  "Datum relativ ('N giây/phút/giờ/ngày/tuần/tháng/năm trước' bzw. englisch) – 'relative' mit date_locale vi, prüfen.",
  "Bilder: Community bevorzugt data-src, data-lazy-src, srcset, data-cfsrc, src – Rezept @img.",
  "Genre-/Sortierfilter nicht abgebildet."
 ]
}
