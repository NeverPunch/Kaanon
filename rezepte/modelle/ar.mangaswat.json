{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "MangaSwat",
  "sprache": "ar",
  "base_url": "https://meshmanga.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.ar.kaanon.mangaswat",
  "quellen": [
   {
    "name": "MangaSwat",
    "sprache": "ar",
    "quell_id": 7657007209499352344,
    "home": "https://meshmanga.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/ar/mangaswat",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.62",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "X-Requested-With": "XMLHttpRequest"
  },
  "rate_limit": {
   "permits": 1,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/v2/api/v2/series/?order_by=-followers_count&page={page}",
   "format": "json",
   "items": "results",
   "has_next": {
    "exists": "next"
   },
   "fields": {
    "url": [
     {
      "path": "id",
      "template": "/series/{value}"
     },
     {
      "path": "serie_id",
      "template": "/series/{value}"
     }
    ],
    "title": "title",
    "cover": "poster.medium"
   }
  },
  "latest": {
   "request": "{base}/v2/api/v2/series/releases/?page={page}",
   "format": "json",
   "items": "results",
   "has_next": {
    "exists": "next"
   },
   "fields": {
    "url": [
     {
      "path": "id",
      "template": "/series/{value}"
     },
     {
      "path": "serie_id",
      "template": "/series/{value}"
     }
    ],
    "title": "title",
    "cover": "poster.medium"
   }
  },
  "search": {
   "request": "{base}/v2/api/v2/series/?search={query}&page={page}",
   "format": "json",
   "items": "results",
   "has_next": {
    "exists": "next"
   },
   "fields": {
    "url": [
     {
      "path": "id",
      "template": "/series/{value}"
     },
     {
      "path": "serie_id",
      "template": "/series/{value}"
     }
    ],
    "title": "title",
    "cover": "poster.medium"
   }
  },
  "details": {
   "request": "{base}/v2/api/v2/series/{u.id}/",
   "format": "json",
   "url_vars": {
    "id": "/series/(\\d+)"
   },
   "fields": {
    "title": "title",
    "cover": "poster.medium",
    "description": "story",
    "genres": {
     "path": "genres.*.name",
     "all": true,
     "join": ", "
    },
    "author": "author.name",
    "artist": "artist.name",
    "status": "status.name"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "{base}/v2/api/v2/chapters/?serie={u.id}&order_by=-order&page_size=200&page={page}",
   "format": "json",
   "url_vars": {
    "id": "/series/(\\d+)"
   },
   "items": "results",
   "paging": {
    "has_next": {
     "exists": "next"
    },
    "max_pages": 30
   },
   "fields": {
    "url": {
     "path": "id",
     "template": "/chapters/{value}/{f.slug}/"
    },
    "name": "chapter",
    "date": "created_at"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{base}/v2/api/v2/chapters/{u.cid}/",
   "format": "json",
   "url_vars": {
    "cid": "/chapters/(\\d+)"
   },
   "items": "images",
   "image": "image"
  }
 },
 "hinweise": [
  "REST-API {base}/v2/api/v2 (Django-Paginierung, next = URL oder null). Community folgt bei Kapiteln der next-URL; hier page={page} mit page_size=200 (Annahme: API akzeptiert page wie bei den Listen).",
  "Rate-Limit 1/s wie im Code. base_url meshmanga.com (Community-Standard, in den Einstellungen änderbar)."
 ]
}
