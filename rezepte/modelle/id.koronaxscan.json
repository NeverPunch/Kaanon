{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "KoronaxScan",
  "sprache": "id",
  "base_url": "https://project.koronaxscan.my.id",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.id.kaanon.koronaxscan",
  "quellen": [
   {
    "name": "KoronaxScan",
    "sprache": "id",
    "quell_id": 6708509143976405352,
    "home": "https://project.koronaxscan.my.id"
   }
  ]
 },
 "quelle": {
  "modul": "src/id/koronaxscan",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": {
    "url": "https://asw.koronaxscan.my.id/api/mangas",
    "headers": {
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "items": "data",
   "skip": {
    "any": [
     {
      "path": "project",
      "equals": "false"
     },
     {
      "path": "available",
      "regex": "^(?!all$)."
     }
    ]
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/detail/{value}"
    },
    "title": "title",
    "cover": [
     {
      "path": "cover_image_url",
      "regex": "^(https?://.+)$",
      "group": 1
     },
     {
      "path": "cover_image_url",
      "template": "https://asw.koronaxscan.my.id{value}"
     }
    ]
   },
   "has_next": {
    "const": false
   }
  },
  "latest": {
   "request": {
    "url": "https://asw.koronaxscan.my.id/api/mangas",
    "headers": {
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "items": "data",
   "skip": {
    "any": [
     {
      "path": "project",
      "equals": "false"
     },
     {
      "path": "available",
      "regex": "^(?!all$)."
     }
    ]
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/detail/{value}"
    },
    "title": "title",
    "cover": [
     {
      "path": "cover_image_url",
      "regex": "^(https?://.+)$",
      "group": 1
     },
     {
      "path": "cover_image_url",
      "template": "https://asw.koronaxscan.my.id{value}"
     }
    ]
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": {
    "url": "https://asw.koronaxscan.my.id/api/mangas",
    "headers": {
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "items": "data",
   "skip": {
    "any": [
     {
      "path": "project",
      "equals": "false"
     },
     {
      "path": "available",
      "regex": "^(?!all$)."
     }
    ]
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/detail/{value}"
    },
    "title": "title",
    "cover": [
     {
      "path": "cover_image_url",
      "regex": "^(https?://.+)$",
      "group": 1
     },
     {
      "path": "cover_image_url",
      "template": "https://asw.koronaxscan.my.id{value}"
     }
    ]
   },
   "has_next": {
    "const": false
   },
   "client_filter": true
  },
  "details": {
   "request": {
    "url": "https://asw.koronaxscan.my.id/api/mangas/{u.slug}",
    "headers": {
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "url_vars": {
    "slug": "/detail/([^/?#]+)"
   },
   "fields": {
    "title": "data.title",
    "cover": [
     {
      "path": "data.cover_image_url",
      "regex": "^(https?://.+)$",
      "group": 1
     },
     {
      "path": "data.cover_image_url",
      "template": "https://asw.koronaxscan.my.id{value}"
     }
    ],
    "description": "data.description",
    "author": "data.author",
    "artist": "data.artist",
    "genres": {
     "path": "data.genres.*.name",
     "all": true,
     "join": ", "
    },
    "status": "data.status"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "hiatus": 6
   }
  },
  "chapters": {
   "request": "details",
   "format": "json",
   "url_vars": {
    "slug": "/detail/([^/?#]+)"
   },
   "items": "data.chapters",
   "skip": {
    "path": "isPremium",
    "equals": "true"
   },
   "fields": {
    "url": {
     "path": "chapter_number",
     "replace": [
      [
       "\\.0$",
       ""
      ]
     ],
     "template": "/reader/{u.slug}/{value}"
    },
    "name": {
     "path": "chapter_number",
     "replace": [
      [
       "\\.0$",
       ""
      ]
     ],
     "template": "Chapter {value}"
    },
    "number": "chapter_number",
    "date": "createdAt"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": {
    "url": "https://asw.koronaxscan.my.id/api/mangas/{u.slug}/chapter/{u.num}",
    "headers": {
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "url_vars": {
    "slug": "/reader/([^/?#]+)/",
    "num": "/reader/[^/]+/([^/?#]+)"
   },
   "items": "pages",
   "image": [
    {
     "path": "image_url",
     "regex": "^(https?://.+)$",
     "group": 1
    },
    {
     "path": "image_url",
     "template": "https://asw.koronaxscan.my.id{value}"
    }
   ]
  }
 },
 "hinweise": [
  "API asw.koronaxscan.my.id: /api/mangas liefert alle Titel auf einmal; nur gelistete (project=true, available leer oder 'all') wie Community.",
  "Beliebt/Neueste: Community sortiert lokal nach Rating bzw. neuestem Kapitel – nicht ausdrückbar, hier Reihenfolge der API. Suche per client_filter (nur Titel; Community auch alternativer Titel).",
  "Eintrags-URL /detail/<slug>, Kapitel-URL /reader/<slug>/<nummer> (Community: Slug bzw. '<slug>/<nummer>'). Relative Bildpfade (/public/uploads/…) an die API-Domain gehängt.",
  "Premium-Kapitel (isPremium) übersprungen (Community zeigt sie mit Schloss). Genres ohne den vorangestellten Typ (Community: Typ + Genres)."
 ]
}
