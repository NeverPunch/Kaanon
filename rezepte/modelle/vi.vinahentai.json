 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Referer": "{base}/"
  },
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/danh-sach/?page={page}&sort=views",
   "items": ".grid a[href*=\"/truyen-hentai/\"]",
   "page_size": 24,
   "has_next": {
    "full": true
   },
   "fields": {
    "url": "@href",
    "title": "div[title~=\\S]@title",
    "cover": "img@src"
   }
  },
  "latest": {
   "request": "{base}/danh-sach/?page={page}&sort=updatedAt",
   "items": ".grid a[href*=\"/truyen-hentai/\"]",
   "page_size": 24,
   "has_next": {
    "full": true
   },
   "fields": {
    "url": "@href",
    "title": "div[title~=\\S]@title",
    "cover": "img@src"
   }
  },
  "search": {
   "request": "{base}/search?page={page}&q={query}",
   "items": "a.group[href^=\"/truyen-hentai/\"]",
   "has_next": {
    "min": 1
   },
   "fields": {
    "url": "@href",
    "title": "h2",
    "cover": "img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1",
    "author": {
     "path": "a[href^=/authors/]:not(:matchesOwn(^\\+))",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": "a[href^=/genres/]:not(:matchesOwn(^\\+))",
     "all": true,
     "join": ", "
    },
    "cover": [
     "img[alt*=Bìa]@src",
     "img[src*=story-images]@src"
    ],
    "description": "#manga-description-section .text-txt-secondary",
    "status": {
     "path": "body",
     "regex": "(Đang tiến hành|Đã hoàn thành)",
     "group": 1
    }
   },
   "status_map": {
    "đang tiến hành": 1,
    "đã hoàn thành": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "a.block[href^=/truyen-hentai/]",
   "skip": {
    "path": "@href",
    "regex": "^/truyen-hentai/[^/]*$"
   },
   "fields": {
    "url": "@href",
    "name": [
     "span",
     ""
    ],
    "date": "time"
   },
   "date_format": "relative",
   "date_locale": "vi"
  },
  "pages": {
   "request": "{abs_url}",
   "format": "text",
   "items": "(https://[^\"'\\s\\\\]+/manga-images/[^\"'\\s\\\\]+)",
   "image": ""
  }
 },
 "hinweise": [
  "Listen /danh-sach/?sort=views|updatedAt; has_next wie Community: volle Seite (24). Suche /search?q=…; has_next 'min: 1' (Community vergleicht Seitenzahl mit input[max] bzw. Link auf Seite+1).",
  "Autor/Genres: Einträge, die mit '+' beginnen ('+N mehr'), per :not(:matchesOwn(^\\+)) ausgelassen (Näherung).",
  "Status aus dem Seitentext (Đang tiến hành/Đã hoàn thành).",
  "Kapitel: alle a.block-Links unter /truyen-hentai/ mit Unterpfad; Community entfernt Dubletten (distinctBy) – hier nicht möglich.",
  "Seiten: Bild-URLs per Regex '/manga-images/' aus dem Rohtext der Kapitelseite (Subdomain wechselt, Pfad stabil). Community entfernt doppelte URLs (distinct) – nicht ausdrückbar, ggf. doppelte Seiten; auf dem PC prüfen."
 ]
