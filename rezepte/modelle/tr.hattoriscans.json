{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Hattori Scans",
  "sprache": "tr",
  "base_url": "https://hattoriscans.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.tr.kaanon.hattoriscans",
  "quellen": [
   {
    "name": "Hattori Scans",
    "sprache": "tr",
    "quell_id": 6626267008161352237,
    "home": "https://hattoriscans.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/tr/hattoriscans",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.3",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/api/manga?limit=1000",
   "format": "json",
   "items": "$",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/manga/{value}"
    },
    "title": "title",
    "cover": {
     "path": "coverImage",
     "template": "{base}{value}"
    }
   },
   "has_next": {
    "const": false
   }
  },
  "latest": {
   "request": "{base}/latest",
   "items": ".latest-poster:has(h3)",
   "fields": {
    "url": "a[style]@href",
    "title": "h3",
    "cover": {
     "path": "a[style]@style",
     "regex": "url\\([\"']?([^\"')]+)",
     "group": 1,
     "template": "{base}{value}"
    }
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": "{base}/api/manga?limit=1000",
   "format": "json",
   "items": "$",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/manga/{value}"
    },
    "title": "title",
    "cover": {
     "path": "coverImage",
     "template": "{base}{value}"
    }
   },
   "has_next": {
    "const": false
   },
   "client_filter": true
  },
  "details": {
   "request": "{base}/api/manga/{u.slug}",
   "format": "json",
   "url_vars": {
    "slug": "/manga/([^/?#]+)"
   },
   "let": {
    "desc": "description",
    "alt": {
     "path": "alternativeTitles",
     "all": true,
     "join": ", "
    }
   },
   "fields": {
    "title": "title",
    "cover": {
     "path": "coverImage",
     "template": "{base}{value}"
    },
    "author": [
     {
      "path": "authors.*.name",
      "all": true,
      "join": ", "
     },
     "author"
    ],
    "artist": [
     {
      "path": "artists.*.name",
      "all": true,
      "join": ", "
     },
     "artist"
    ],
    "genres": {
     "path": [
      "type",
      "genres.*.name"
     ],
     "union": true
    },
    "status": "status",
    "description": {
     "const": "[[{l.desc}]][[\n\nAlternatif isimler: {l.alt}]]",
     "replace": [
      [
       "^\\s+|\\s+$",
       ""
      ]
     ]
    }
   },
   "status_map": {
    "ongoing": 1,
    "current": 1,
    "completed": 2,
    "hiatus": 6,
    "cancelled": 5
   }
  },
  "chapters": {
   "request": "{base}/api/manga/{u.slug}/chapters",
   "format": "json",
   "url_vars": {
    "slug": "/manga/([^/?#]+)"
   },
   "items": "chapters",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/manga/{u.slug}/{value}"
    },
    "name": {
     "const": "{f.title}[[ - {f.subtitle}]]"
    },
    "number": "chapterNumber",
    "date": "releaseDate"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": {
    "url": "{abs_url}",
    "headers": {
     "rsc": "1"
    }
   },
   "format": "text",
   "block_regex": "\"pages\":(\\[[^\\]]*\\])",
   "items": "\"([^\"]+)\"",
   "image": {
    "path": "",
    "replace": [
     [
      "\\\\/",
      "/"
     ]
    ],
    "template": "{base}{value}"
   }
  }
 },
 "hinweise": [
  "JSON-API /api/manga?limit=1000 (ganze Liste, keine Seiten – wie Community). Beliebt = API-Reihenfolge (Community sortiert nach createdAt absteigend). Suche clientseitig über die ganze Liste (Community: Treffer-IDs aus /api/manga/search?q= mit der Liste abgeglichen – Abgleich zweier Antworten nicht ausdrückbar). Typ-/Status-/Genre-Filter und Sortierungen nicht übernommen.",
  "Neueste: HTML /latest, Karten .latest-poster:has(h3), Cover aus style url(...), eine Seite.",
  "Kapitel /api/manga/<slug>/chapters; Kapitel-URL /manga/<slug>/<kapitel-slug> (Community speichert nur den Kapitel-Slug + Memo).",
  "Seiten: Community liest Next.js-Flight-Daten (extractNextJs, Objekt mit 'pages'). Hier wie en.drakescans mit Kopfzeile rsc: 1 und Regex \"pages\":[…] über den Rohtext; Pfade relativ → {base}+Pfad. Auf dem PC prüfen."
 ]
}
