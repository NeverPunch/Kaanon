{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Mangas-Origines.fr",
  "sprache": "fr",
  "base_url": "https://mangas-origines.fr",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.fr.kaanon.mangasoriginesfr",
  "quellen": [
   {
    "name": "Mangas-Origines.fr",
    "sprache": "fr",
    "quell_id": 4803238581797687746,
    "home": "https://mangas-origines.fr"
   }
  ]
 },
 "quelle": {
  "modul": "src/fr/mangasoriginesfr",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.62",
  "theme": "origines"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": {
    "url": "{base}/wp-admin/admin-ajax.php",
    "method": "POST",
    "form": {
     "action": "madara_child_catalogue",
     "s": "",
     "genres": "",
     "statut": "tous",
     "note": "0",
     "origine": "",
     "tri": "populaire",
     "chmin": "0",
     "chmax": "0",
     "page": "{page}",
     "auteur": "",
     "artiste": "",
     "annee": ""
    }
   },
   "format": "json_html",
   "html_path": "data.html",
   "items": "a.ori-card:has(span.ori-card-title)",
   "has_next": {
    "exists": "^data.more"
   },
   "fields": {
    "url": "@href",
    "title": "span.ori-card-title",
    "cover": "img@src"
   }
  },
  "latest": {
   "request": {
    "url": "{base}/wp-admin/admin-ajax.php",
    "method": "POST",
    "form": {
     "action": "madara_child_catalogue",
     "s": "",
     "genres": "",
     "statut": "tous",
     "note": "0",
     "origine": "",
     "tri": "recents",
     "chmin": "0",
     "chmax": "0",
     "page": "{page}",
     "auteur": "",
     "artiste": "",
     "annee": ""
    }
   },
   "format": "json_html",
   "html_path": "data.html",
   "items": "a.ori-card:has(span.ori-card-title)",
   "has_next": {
    "exists": "^data.more"
   },
   "fields": {
    "url": "@href",
    "title": "span.ori-card-title",
    "cover": "img@src"
   }
  },
  "search": {
   "request": {
    "url": "{base}/wp-admin/admin-ajax.php",
    "method": "POST",
    "form": {
     "action": "madara_child_catalogue",
     "s": "{query_raw}",
     "genres": "",
     "statut": "tous",
     "note": "0",
     "origine": "",
     "tri": "recents",
     "chmin": "0",
     "chmax": "0",
     "page": "{page}",
     "auteur": "",
     "artiste": "",
     "annee": ""
    }
   },
   "format": "json_html",
   "html_path": "data.html",
   "items": "a.ori-card:has(span.ori-card-title)",
   "has_next": {
    "exists": "^data.more"
   },
   "fields": {
    "url": "@href",
    "title": "span.ori-card-title",
    "cover": "img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "let": {
    "desc": {
     "path": "div.ori-sr-syn-texte p",
     "all": true,
     "join": "\n"
    },
    "alt": "div.ori-sr-infos dt:matchesOwn((?i)^\\s*(nom alternatif)\\s*$) + *",
    "type": "div.ori-sr-infos dt:matchesOwn((?i)^\\s*(type)\\s*$) + *",
    "genre_names": {
     "path": "div.ori-sr-genres a.ori-sr-genre",
     "all": true,
     "join": ", "
    }
   },
   "fields": {
    "title": "h1.ori-sr-title",
    "cover": "div.ori-sr-cover img@src",
    "description": {
     "const": "{l.desc}\n\n[[Nom alternatif: {l.alt}]]"
    },
    "author": [
     "div.ori-sr-infos dt:matchesOwn((?i)^\\s*(auteur)\\s*$) + *",
     "div.ori-sr-infos dt:matchesOwn((?i)^\\s*(scénario)\\s*$) + *"
    ],
    "artist": [
     "div.ori-sr-infos dt:matchesOwn((?i)^\\s*(artiste)\\s*$) + *",
     "div.ori-sr-infos dt:matchesOwn((?i)^\\s*(dessin)\\s*$) + *"
    ],
    "genres": {
     "const": "{l.genre_names}[[, {l.type}]]"
    },
    "status": "div.ori-sr-infos dt:matchesOwn((?i)^\\s*(statut)\\s*$) + *"
   },
   "status_map": {
    "en cours": 1,
    "terminé": 2,
    "termine": 2,
    "en pause": 6,
    "abandonné": 5,
    "annulé": 5
   }
  },
  "chapters": {
   "request": {
    "url": "{base}/oeuvre/{u.slug}/ajax/chapters/",
    "method": "POST",
    "form": {}
   },
   "url_vars": {
    "slug": "/(?:oeuvre|catalogues)/([^/?#]+)"
   },
   "items": "div.ori-chl-row",
   "fields": {
    "url": "a.ori-chl-corps@href",
    "name": [
     "span.ori-chl-nom",
     "a.ori-chl-corps"
    ],
    "date": {
     "path": "span.ori-chl-date@title",
     "replace": [
      [
       "\\.",
       ""
      ]
     ]
    }
   },
   "date_format": [
    "d MMMM yyyy",
    "d MMM yyyy"
   ],
   "date_locale": "fr"
  },
  "pages": {
   "request": "{abs_url}?style=list",
   "items": "div.reading-content img.wp-manga-chapter-img",
   "image": "@img"
  }
 },
 "hinweise": [
  "Theme Origines: Listen/Suche über admin-ajax (action madara_child_catalogue), JSON mit HTML in data.html; nächste Seite laut data.more (has_next '^data.more', JSON-Wurzel aus json_html – so in keiner Vorlage, prüfen).",
  "Filter (Genres, Statut, Note, Origine, Tri, Kapitelzahl) nicht übernommen; Suche immer tri=recents.",
  "Kapiteldaten ohne Jahr ('8 Août') ergänzt die Community mit dem letzten passenden Jahr; das Rezept parst nur Daten mit Jahr."
 ]
}
