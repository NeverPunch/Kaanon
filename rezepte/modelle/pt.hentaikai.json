 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/mangas-hentai/page/{page}/",
   "request_by_page": {
    "1": "{base}/mangas-hentai/"
   },
   "items": "a:has(div.box-info-serie)",
   "fields": {
    "url": "@href",
    "title": [
     "@title",
     "img@alt"
    ],
    "cover": [
     "img@data-lazy-src",
     {
      "path": "img@src",
      "regex": "^(?!data:)(.+)$",
      "group": 1
     }
    ]
   },
   "has_next": {
    "exists": "a.next, a[rel=next], link[rel=next]"
   }
  },
  "latest": {
   "request": "{base}/hentais/page/{page}/",
   "request_by_page": {
    "1": "{base}/hentais/"
   },
   "items": "a:has(div.box-info-serie)",
   "fields": {
    "url": "@href",
    "title": [
     "@title",
     "img@alt"
    ],
    "cover": [
     "img@data-lazy-src",
     {
      "path": "img@src",
      "regex": "^(?!data:)(.+)$",
      "group": 1
     }
    ]
   },
   "has_next": {
    "exists": "a.next, a[rel=next], link[rel=next]"
   }
  },
  "search": {
   "request": "{base}/?s={query}",
   "items": "a:has(div.box-info-serie)",
   "fields": {
    "url": "@href",
    "title": [
     "@title",
     "img@alt"
    ],
    "cover": [
     "img@data-lazy-src",
     {
      "path": "img@src",
      "regex": "^(?!data:)(.+)$",
      "group": 1
     }
    ]
   },
   "has_next": {
    "const": false
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1",
    "cover": "li img[data-src]@data-src"
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "const": "Oneshot"
    }
   }
  },
  "pages": {
   "request": "{abs_url}",
   "items": "li img[data-src]",
   "image": [
    {
     "path": "@data-src",
     "regex": "^(?!data:)(.+)$",
     "group": 1
    },
    {
     "path": "@src",
     "regex": "^(?!data:)(.+)$",
     "group": 1
    }
   ]
  }
 },
