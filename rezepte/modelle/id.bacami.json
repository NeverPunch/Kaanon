{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Bacami",
  "sprache": "id",
  "base_url": "https://v1.bacami.site",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.id.kaanon.bacami",
  "quellen": [
   {
    "name": "Bacami",
    "sprache": "id",
    "quell_id": 2677079941490683989,
    "home": "https://v1.bacami.site"
   }
  ]
 },
 "quelle": {
  "modul": "src/id/bacami",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/custom-search/orderby/score/page/{page}/",
   "request_by_page": {
    "1": "{base}/custom-search/orderby/score/"
   },
   "items": "article.genre-card",
   "fields": {
    "url": "div.genre-cover > a@href",
    "title": "div.genre-info > a",
    "cover": [
     "div.genre-cover > a > img@data-src",
     "div.genre-cover > a > img@src"
    ]
   },
   "has_next": {
    "exists": "div.paginate a.next.page-numbers"
   }
  },
  "latest": {
   "request": "{base}/custom-search/orderby/latest/page/{page}/",
   "request_by_page": {
    "1": "{base}/custom-search/orderby/latest/"
   },
   "items": "article.genre-card",
   "fields": {
    "url": "div.genre-cover > a@href",
    "title": "div.genre-info > a",
    "cover": [
     "div.genre-cover > a > img@data-src",
     "div.genre-cover > a > img@src"
    ]
   },
   "has_next": {
    "exists": "div.paginate a.next.page-numbers"
   }
  },
  "search": {
   "request": "{base}/search/{query}/page/{page}/",
   "request_by_page": {
    "1": "{base}/search/{query}/"
   },
   "items": "article.genre-card",
   "fields": {
    "url": "div.genre-cover > a@href",
    "title": "div.genre-info > a",
    "cover": [
     "div.genre-cover > a > img@data-src",
     "div.genre-cover > a > img@src"
    ]
   },
   "has_next": {
    "exists": "div.paginate a.next.page-numbers"
   }
  },
  "details": {
   "request": "{abs_url}",
   "let": {
    "d": "#komik > section.manga-content p.manga-description",
    "alt": {
     "path": "#komik > section.manga-content p.manga-altname",
     "all": true,
     "join": " "
    }
   },
   "fields": {
    "title": {
     "path": "#komik > section.manga-content header > h1",
     "replace": [
      [
       "\\s*Bahasa Indonesia\\s*$",
       ""
      ]
     ]
    },
    "cover": [
     "#komik > section.manga-content figure .image-wrap img@data-src",
     "#komik > section.manga-content figure .image-wrap img@src"
    ],
    "author": [
     "#komik > section.manga-content .info-item:contains(Author) .info-value",
     "#komik > section.manga-content div > div > div:nth-child(3) > span.info-value"
    ],
    "genres": {
     "path": "#komik > section.manga-content nav > span > a",
     "all": true,
     "join": ", "
    },
    "status": [
     {
      "path": ".hot-tag@class",
      "template": "ongoing"
     },
     {
      "path": ".project-tag@class",
      "template": "ongoing"
     },
     {
      "path": ".tamat-tag@class",
      "template": "completed"
     }
    ],
    "description": {
     "const": "[[{l.d}]][[\n\nAlternative Title: {l.alt}]]",
     "replace": [
      [
       "^\\n+",
       ""
      ]
     ]
    }
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "ol.chapter-list > li",
   "fields": {
    "url": "a.ch-link@href",
    "name": [
     {
      "path": "a.ch-link",
      "replace": [
       [
        "^[^–]*–",
        ""
       ],
       [
        "^[^-]*-",
        ""
       ],
       [
        "^\\s+|\\s+$",
        ""
       ]
      ]
     },
     "a.ch-link"
    ],
    "number": {
     "path": "a.ch-link",
     "regex": "(?i)(?:Chapter|Ch\\.)\\s+([0-9]+(?:\\.[0-9]+)?)",
     "group": 1
    },
    "date": "span.ch-date"
   },
   "date_format": "d MMMM, yyyy",
   "date_locale": "en"
  },
  "pages": {
   "request": "{abs_url}",
   "format": "script_json",
   "script_regex": "(?s)imageUrls:\\s*(\\[.*?\\])",
   "items": "$"
  }
 },
 "hinweise": [
  "HTML wie Community: /custom-search/orderby/score (Beliebt) bzw. /latest (Neueste), Suche /search/<q>/; Seite 1 ohne /page/1. Filter (Genre/Status/Typ/Komik Baru) nicht übernommen.",
  "Status: .hot-tag/.project-tag → laufend, .tamat-tag → abgeschlossen (per template-Konstante).",
  "Kapitelname: Teil nach '–' bzw. '-' wie Community (substringAfter); Nummer aus 'Chapter/Ch. <n>' im Linktext (Community: im gekürzten Namen). Datum 'd MMMM, yyyy' (en), Zeitzone Asia/Jakarta nicht angegeben.",
  "Seiten: JSON-Liste imageUrls aus dem Leser-Skript."
 ]
}
