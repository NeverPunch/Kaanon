{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Manhwalike",
  "sprache": "en",
  "base_url": "https://manhwalike.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.manhwalike",
  "quellen": [
   {
    "name": "Manhwalike",
    "sprache": "en",
    "quell_id": 3472935303493224823,
    "home": "https://manhwalike.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/manhwalike",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/",
   "items": "ul.list-hot div.visual",
   "fields": {
    "url": "a@href",
    "title": "h3.title a",
    "cover": "img@img"
   },
   "has_next": {
    "const": false
   }
  },
  "latest": {
   "request": "{base}/",
   "items": "ul.slick_item div.visual",
   "fields": {
    "url": "a@href",
    "title": "h3.title a",
    "cover": "img@img"
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": {
    "url": "{base}/search/html/1",
    "method": "POST",
    "headers": {
     "Accept": "text/html",
     "X-Requested-With": "XMLHttpRequest"
    },
    "form": {
     "keyword": "{query_raw}"
    }
   },
   "items": [
    "ul.normal li",
    "ul li"
   ],
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "a@href",
    "title": "img@alt",
    "cover": "img@img"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1",
    "author": "div.author a",
    "status": {
     "path": "small:contains(Status) + strong",
     "regex": "(?i)(ongoing|finish)",
     "group": 1
    },
    "genres": {
     "path": "div.categories a",
     "all": true,
     "join": ", "
    },
    "description": "div.summary-block p.about",
    "cover": "div.fixed-img img@src"
   },
   "status_map": {
    "ongoing": 1,
    "finish": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "ul.chapter-list li",
   "fields": {
    "url": "a@href",
    "name": "a",
    "date": ".time"
   },
   "date_format": "MMMM d, yyyy",
   "date_locale": "en"
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".chapter-content .page-chapter img",
   "image": "@src"
  }
 },
 "hinweise": [
  "Beliebt/Neueste: Abschnitte der Startseite (ul.list-hot bzw. ul.slick_item), je eine Seite wie Community.",
  "Suche: POST /search/html/1 mit keyword (HTML-Fragment), eine Seite (Community fragt ebenfalls immer Seite 1 ab). Genre-Filter nicht übernommen.",
  "Details-Titel: Community setzt ihn nicht neu; hier h1 angenommen. Datum in Zeitzone America/New_York (Community) – hier ohne Zeitzone."
 ]
}
