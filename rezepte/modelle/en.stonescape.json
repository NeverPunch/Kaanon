{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "StoneScape",
  "sprache": "en",
  "base_url": "https://stonescape.xyz",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.stonescape",
  "quellen": [
   {
    "name": "StoneScape",
    "sprache": "en",
    "quell_id": 5914422711950728870,
    "home": "https://stonescape.xyz"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/stonescape",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Referer": "{base}/",
   "Accept": "application/json, text/plain, */*"
  },
  "popular": {
   "request": "{base}/api/series/popular?page={page}&period=week&contentType=manhwa&limit=24",
   "format": "json",
   "items": "data",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/series/{value}"
    },
    "title": "title",
    "cover": {
     "path": "coverUrl",
     "template": "{base}{value}"
    }
   },
   "has_next": {
    "lt": [
     "pagination.page",
     "pagination.totalPages"
    ]
   }
  },
  "latest": {
   "request": "{base}/api/series?page={page}&limit=24&contentType=manhwa",
   "format": "json",
   "items": "data",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/series/{value}"
    },
    "title": "title",
    "cover": {
     "path": "coverUrl",
     "template": "{base}{value}"
    }
   },
   "has_next": {
    "lt": [
     "pagination.page",
     "pagination.totalPages"
    ]
   }
  },
  "search": {
   "request": "{base}/api/series?page={page}&limit=24&contentType=manhwa&search={query}",
   "format": "json",
   "items": "data",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/series/{value}"
    },
    "title": "title",
    "cover": {
     "path": "coverUrl",
     "template": "{base}{value}"
    }
   },
   "has_next": {
    "lt": [
     "pagination.page",
     "pagination.totalPages"
    ]
   }
  },
  "details": {
   "request": "{base}/api/series/by-slug/{u.slug}",
   "format": "json",
   "url_vars": {
    "slug": "/series/([^/#?]+)"
   },
   "fields": {
    "title": "title",
    "cover": {
     "path": "coverUrl",
     "template": "{base}{value}"
    },
    "description": "description",
    "author": "author",
    "artist": "artist",
    "genres": {
     "path": "genres.*",
     "all": true,
     "join": ", "
    },
    "status": "publicationStatus"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "hiatus": 6,
    "dropped": 5,
    "cancelled": 5
   }
  },
  "chapters": {
   "request": "{base}/api/series/by-slug/{u.slug}/chapters",
   "format": "json",
   "url_vars": {
    "slug": "/series/([^/#?]+)"
   },
   "items": "chapters",
   "fields": {
    "url": {
     "path": "chapterNumber",
     "template": "/series/{u.slug}/ch-{value}#{f.chapterId}"
    },
    "name": {
     "path": "chapterNumber",
     "template": "Chapter {value}[[ - {f.title}]]"
    },
    "number": "chapterNumber",
    "date": "createdAt"
   },
   "date_format": "iso",
   "reverse": true
  },
  "pages": {
   "request": "{base}/api/chapters/{u.id}/pages",
   "format": "json",
   "url_vars": {
    "id": "#(.+)$"
   },
   "items": [
    "pages",
    "images"
   ],
   "sort": "pageNumber",
   "image": {
    "path": "url",
    "template": "{base}{value}"
   }
  }
 },
 "hinweise": [
  "JSON-API (/api/series…, /api/series/by-slug/{slug}/chapters, /api/chapters/{id}/pages) wie Community; nur contentType=manhwa wie dort.",
  "Kapitel-URL trägt die Kapitel-ID hinter '#' (wie Community). Community formatiert die Nummer als Zahl (1.0 → 1); hier roh übernommen.",
  "Genres: Community wandelt Slugs über eine feste Liste in Namen um; hier Rohwerte (Slugs).",
  "Suche: Community setzt bei Suchtext, der einem Genre entspricht, stattdessen den Genre-Filter; hier immer search=. Filter nicht übernommen.",
  "Seiten: 'pages', sonst 'images' (Ausweichkette als items – auf dem PC prüfen)."
 ]
}
