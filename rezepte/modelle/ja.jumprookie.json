{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Jump Rookie!",
  "sprache": "ja",
  "base_url": "https://rookie.shonenjump.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.ja.kaanon.jumprookie",
  "quellen": [
   {
    "name": "Jump Rookie!",
    "sprache": "ja",
    "quell_id": 4194563020378281165,
    "home": "https://rookie.shonenjump.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/ja/jumprookie",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/api/media/series_list?type=popular",
   "items": "section.series-contents",
   "fields": {
    "url": "a@href",
    "title": ".series-title",
    "cover": ".cover-image@src"
   },
   "has_next": {
    "const": false
   }
  },
  "latest": {
   "request": {
    "url": "{base}/categories/general/recent?page={page}",
    "headers": {
     "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36"
    }
   },
   "items": "section.series-contents",
   "fields": {
    "url": "a@href",
    "title": ".series-title",
    "cover": ".cover-image@src"
   },
   "has_next": {
    "exists": ".button-next"
   }
  },
  "search": {
   "request": "{base}/search?query={query}",
   "items": "#search-series section.series-contents",
   "fields": {
    "url": "a@href",
    "title": ".series-title",
    "cover": ".cover-image@src"
   },
   "has_next": {
    "const": false
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": ".series-title",
    "author": ".user-name",
    "description": ".series-description",
    "genres": ".series-category",
    "cover": ".cover-image@src"
   }
  },
  "chapters": {
   "request": "details",
   "items": "#episode-list > li",
   "fields": {
    "url": "a.episode-content@href",
    "name": ".episode-title"
   },
   "reverse": true
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".js-page-image",
   "image": "@src"
  }
 },
 "hinweise": [
  "Beliebt: /api/media/series_list?type=popular. Weitere Seiten über den Schlüssel aus dem Antwort-Header Tky-Link-Rel-Next – nicht ausdrückbar, daher nur die erste Seite.",
  "Neueste mit Desktop-User-Agent wie Community (/categories/general/recent?page=N, .button-next). Suche nur eine Seite (wie Community); Genrefilter nicht nachgebaut.",
  "Kapitelliste umgekehrt wie Community (reverse). Kein Datum/Status in der Community."
 ]
}
