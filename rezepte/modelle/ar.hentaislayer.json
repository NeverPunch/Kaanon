{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Hentai Slayer",
  "sprache": "ar",
  "base_url": "https://hentaislayer.net",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.ar.kaanon.hentaislayer",
  "quellen": [
   {
    "name": "هنتاي سلاير",
    "sprache": "ar",
    "quell_id": 1383489648660567366,
    "home": "https://hentaislayer.net"
   }
  ]
 },
 "quelle": {
  "modul": "src/ar/hentaislayer",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "fuzzydoodle"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/manga?page={page}",
   "items": "div#card-real",
   "has_next": {
    "exists": "ul.pagination > li:last-child:not(.pagination-disabled)"
   },
   "fields": {
    "url": "a@href",
    "title": "h2.text-sm",
    "cover": "img@img"
   }
  },
  "latest": {
   "request": "{base}/latest-manga?page={page}",
   "items": "div#card-real",
   "has_next": {
    "exists": "ul.pagination > li:last-child:not(.pagination-disabled)"
   },
   "fields": {
    "url": "a@href",
    "title": "h2.text-sm",
    "cover": "img@img"
   }
  },
  "search": {
   "request": "{base}/manga?title={query}&page={page}",
   "items": "div#card-real",
   "has_next": {
    "exists": "ul.pagination > li:last-child:not(.pagination-disabled)"
   },
   "fields": {
    "url": "a@href",
    "title": "h2.text-sm",
    "cover": "img@img"
   }
  },
  "details": {
   "request": "{abs_url}",
   "let": {
    "genres": {
     "path": "main > section > div div.flex > a.inline-block",
     "all": true,
     "join": ", "
    },
    "type": [
     "div#buttons + div.hidden p:has(span:containsOwn(Type)) span.capitalize@ownText",
     "div:has(> div#buttons) + div.flex p:has(span:containsOwn(Type)) span.capitalize@ownText",
     "div#buttons + div.hidden p:has(span:containsOwn(النوع)) span.capitalize@ownText",
     "div:has(> div#buttons) + div.flex p:has(span:containsOwn(النوع)) span.capitalize@ownText"
    ]
   },
   "fields": {
    "title": [
     "main > section > div div.flex > h1@ownText",
     "main > section > div div.flex > h2@ownText"
    ],
    "cover": "main > section > div div.relative img@img",
    "description": "main > section > div p#description",
    "genres": {
     "const": "[[{l.type}, ]]{l.genres}"
    },
    "status": [
     "div#buttons + div.hidden p:has(span:containsOwn(Status)) span.capitalize@ownText",
     "div:has(> div#buttons) + div.flex p:has(span:containsOwn(Status)) span.capitalize@ownText"
    ],
    "author": [
     "div#buttons + div.hidden p:has(span:containsOwn(الرسام)) span.capitalize@ownText",
     "div:has(> div#buttons) + div.flex p:has(span:containsOwn(الرسام)) span.capitalize@ownText",
     "div#buttons + div.hidden p:has(span:containsOwn(Author)) span.capitalize@ownText",
     "div:has(> div#buttons) + div.flex p:has(span:containsOwn(Author)) span.capitalize@ownText"
    ],
    "artist": [
     "div#buttons + div.hidden p:has(span:containsOwn(المؤلف)) span.capitalize@ownText",
     "div:has(> div#buttons) + div.flex p:has(span:containsOwn(المؤلف)) span.capitalize@ownText",
     "div#buttons + div.hidden p:has(span:containsOwn(Artist)) span.capitalize@ownText",
     "div:has(> div#buttons) + div.flex p:has(span:containsOwn(Artist)) span.capitalize@ownText"
    ]
   },
   "status_map": {
    "ongoing": 1,
    "مستمر": 1,
    "completed": 2,
    "مكتمل": 2,
    "dropped": 5,
    "cancelled": 5,
    "متوقف": 5,
    "hiatus": 6
   }
  },
  "chapters": {
   "request": "{abs_url}?page={page}",
   "request_by_page": {
    "1": "details"
   },
   "items": "div#chapters-list > a[href]",
   "fields": {
    "url": "@href",
    "name": [
     "#item-title@ownText",
     "span@ownText"
    ],
    "date": "span.text-gray-500"
   },
   "date_format": "relative",
   "date_locale": "ar",
   "paging": {
    "has_next": {
     "exists": "ul.pagination > li:last-child:not(.pagination-disabled)"
    },
    "max_pages": 30
   }
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div#chapter-container > img",
   "image": "@img"
  }
 },
 "hinweise": [
  "FuzzyDoodle-Theme (HTML). Beliebt /manga?page=N, Neu /latest-manga?page=N (Community-Einstellung 'LatestType', Standard manga; Alternativen latest-manhwa, latest-comics), Suche /manga?title=…&page=N.",
  "Details und erste Kapitelseite kommen von derselben Seite; weitere Kapitelseiten über <manga-url>?page=N, solange die Pagination ein aktives letztes Element hat.",
  "Infozeilen wie im Theme: Status-Label 'Status'; Community ordnet 'الرسام' dem Autor und 'المؤلف' dem Zeichner zu (so übernommen). Typ wird den Genres vorangestellt.",
  "Datum ist relativ und arabisch ('منذ 3 أيام', 'ساعة', 'دقائق') – prüfen, ob 'relative' mit date_locale 'ar' das versteht.",
  "Alternativtitel (h1 + div > span.text-sm) hängt die Community an die Beschreibung an; hier weggelassen."
 ]
}