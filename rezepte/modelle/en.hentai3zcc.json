 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/list-manga/{page}?order_by=views",
   "items": "div.story_item",
   "has_next": {
    "exists": ".pagination > li:last-child:not(.active)"
   },
   "fields": {
    "url": "a@href",
    "title": "div.mg_info > div.mg_name a",
    "cover": {
     "path": "img@src",
     "replace": [
      [
       "cover_thumb_2\\.webp",
       "cover_250x350.jpg"
      ],
      [
       "admin\\.manga18\\.us",
       "bk.18porncomic.com"
      ]
     ]
    }
   }
  },
  "latest": {
   "request": "{base}/list-manga/{page}",
   "items": "div.story_item",
   "has_next": {
    "exists": ".pagination > li:last-child:not(.active)"
   },
   "fields": {
    "url": "a@href",
    "title": "div.mg_info > div.mg_name a",
    "cover": {
     "path": "img@src",
     "replace": [
      [
       "cover_thumb_2\\.webp",
       "cover_250x350.jpg"
      ],
      [
       "admin\\.manga18\\.us",
       "bk.18porncomic.com"
      ]
     ]
    }
   }
  },
  "search": {
   "request": "{base}/list-manga/{page}?search={query}",
   "items": "div.story_item",
   "has_next": {
    "exists": ".pagination > li:last-child:not(.active)"
   },
   "fields": {
    "url": "a@href",
    "title": "div.mg_info > div.mg_name a",
    "cover": {
     "path": "img@src",
     "replace": [
      [
       "cover_thumb_2\\.webp",
       "cover_250x350.jpg"
      ],
      [
       "admin\\.manga18\\.us",
       "bk.18porncomic.com"
      ]
     ]
    }
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "div.detail_name > h1",
    "cover": "div.detail_avatar > img@src",
    "description": {
     "path": "div.detail_reviewContent",
     "all": true,
     "join": "\n\n"
    },
    "author": {
     "path": "div.detail_listInfo div.info_label:contains(author) + div.info_value, div.detail_listInfo div.info_label:contains(autor) + div.info_value",
     "regex": "^(?!Updating$)(.+)$",
     "group": 1
    },
    "artist": {
     "path": "div.detail_listInfo div.info_label:contains(artist) + div.info_value",
     "regex": "^(?!Updating$)(.+)$",
     "group": 1
    },
    "genres": {
     "path": "div.detail_listInfo div.info_value > a[href*=/manga-list/]",
     "all": true,
     "join": ", "
    },
    "status": "div.detail_listInfo div.item:contains(Status) div.info_value"
   },
   "status_map": {
    "on going": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "div.chapter_box .item",
   "fields": {
    "url": "a@href",
    "name": "a",
    "date": "p"
   },
   "date_format": "dd-MM-yyyy",
   "date_locale": "en"
  },
  "pages": {
   "request": "{abs_url}",
   "format": "scripts",
   "block_regex": "(?s)slides_p_path[^\\[]*\\[(.*?),?\\s*\\]",
   "items": "\"([^\"]+)\"",
   "image": {
    "path": "",
    "decode": "base64"
   }
  }
 },
