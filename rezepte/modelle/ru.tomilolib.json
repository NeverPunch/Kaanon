{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Tomilo-lib",
  "sprache": "ru",
  "base_url": "https://tomilo-lib.ru",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.ru.kaanon.tomilolib",
  "quellen": [
   {
    "name": "Tomilo-lib",
    "sprache": "ru",
    "quell_id": 7420534233267322527,
    "home": "https://tomilo-lib.ru"
   }
  ]
 },
 "quelle": {
  "modul": "src/ru/tomilolib",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "popular": {
   "request": {
    "url": "{base}/api/titles?sortBy=views&order=desc&page={page}&limit=30",
    "headers": {
     "Accept": "application/json"
    }
   },
   "format": "json",
   "items": "data.titles",
   "skip": {
    "path": "isAdult",
    "equals": "true"
   },
   "has_next": {
    "lt": [
     "data.pagination.page",
     "data.pagination.pages"
    ]
   },
   "fields": {
    "url": {
     "path": "_id",
     "template": "/titles/{f.slug}#{value}"
    },
    "title": "name",
    "cover": {
     "path": "coverImage",
     "replace": [
      [
       "^https://tomilo-lib\\.ru/uploads",
       "https://tomilolib.s3.regru.cloud"
      ],
      [
       "^(?!https?://)/?",
       "https://tomilolib.s3.regru.cloud/"
      ],
      [
       "^https://tomilolib\\.s3\\.regru\\.cloud/uploads",
       "https://tomilolib.s3.regru.cloud"
      ]
     ]
    }
   }
  },
  "latest": {
   "request": {
    "url": "{base}/api/titles?sortBy=updatedAt&order=desc&page={page}&limit=30",
    "headers": {
     "Accept": "application/json"
    }
   },
   "format": "json",
   "items": "data.titles",
   "skip": {
    "path": "isAdult",
    "equals": "true"
   },
   "has_next": {
    "lt": [
     "data.pagination.page",
     "data.pagination.pages"
    ]
   },
   "fields": {
    "url": {
     "path": "_id",
     "template": "/titles/{f.slug}#{value}"
    },
    "title": "name",
    "cover": {
     "path": "coverImage",
     "replace": [
      [
       "^https://tomilo-lib\\.ru/uploads",
       "https://tomilolib.s3.regru.cloud"
      ],
      [
       "^(?!https?://)/?",
       "https://tomilolib.s3.regru.cloud/"
      ],
      [
       "^https://tomilolib\\.s3\\.regru\\.cloud/uploads",
       "https://tomilolib.s3.regru.cloud"
      ]
     ]
    }
   }
  },
  "search": {
   "request": {
    "url": "{base}/api/titles?page={page}&limit=30&search={query}&sortBy=views&order=desc",
    "headers": {
     "Accept": "application/json"
    }
   },
   "format": "json",
   "items": "data.titles",
   "skip": {
    "path": "isAdult",
    "equals": "true"
   },
   "has_next": {
    "lt": [
     "data.pagination.page",
     "data.pagination.pages"
    ]
   },
   "fields": {
    "url": {
     "path": "_id",
     "template": "/titles/{f.slug}#{value}"
    },
    "title": "name",
    "cover": {
     "path": "coverImage",
     "replace": [
      [
       "^https://tomilo-lib\\.ru/uploads",
       "https://tomilolib.s3.regru.cloud"
      ],
      [
       "^(?!https?://)/?",
       "https://tomilolib.s3.regru.cloud/"
      ],
      [
       "^https://tomilolib\\.s3\\.regru\\.cloud/uploads",
       "https://tomilolib.s3.regru.cloud"
      ]
     ]
    }
   }
  },
  "details": {
   "request": {
    "url": "{base}/api/titles/{u.id}",
    "headers": {
     "Accept": "application/json"
    }
   },
   "format": "json",
   "url_vars": {
    "id": "#([^#/]+)$"
   },
   "fields": {
    "title": "data.name",
    "cover": {
     "path": "data.coverImage",
     "replace": [
      [
       "^https://tomilo-lib\\.ru/uploads",
       "https://tomilolib.s3.regru.cloud"
      ],
      [
       "^(?!https?://)/?",
       "https://tomilolib.s3.regru.cloud/"
      ],
      [
       "^https://tomilolib\\.s3\\.regru\\.cloud/uploads",
       "https://tomilolib.s3.regru.cloud"
      ]
     ]
    },
    "description": "data.description",
    "author": "data.author",
    "artist": "data.artist",
    "genres": {
     "path": "data.genres.*",
     "all": true,
     "join": ", "
    },
    "status": "data.status"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "pause": 6,
    "frozen": 6
   }
  },
  "chapters": {
   "request": {
    "url": "{base}/api/chapters?titleId={u.id}&page={page}&limit=200",
    "headers": {
     "Accept": "application/json"
    }
   },
   "format": "json",
   "url_vars": {
    "id": "#([^#/]+)$"
   },
   "items": "data.chapters",
   "skip": {
    "path": "isPublished",
    "equals": "false"
   },
   "locked": {
    "path": "isPaid",
    "equals": "true"
   },
   "fields": {
    "url": {
     "path": "_id",
     "template": "/chapters/{value}"
    },
    "name": [
     "name",
     {
      "path": "chapterNumber",
      "replace": [
       [
        "\\.0$",
        ""
       ]
      ],
      "template": "Глава {value}"
     }
    ],
    "number": "chapterNumber",
    "date": "releaseDate"
   },
   "date_format": "iso",
   "paging": {
    "has_next": {
     "lt": [
      "data.pagination.page",
      "data.pagination.pages"
     ]
    },
    "max_pages": 50
   }
  },
  "pages": {
   "request": {
    "url": "{base}/api/chapters/{u.cid}",
    "headers": {
     "Accept": "application/json"
    }
   },
   "format": "json",
   "url_vars": {
    "cid": "/chapters/([^/?#]+)"
   },
   "items": "data.pages",
   "image": {
    "path": "",
    "replace": [
     [
      "^https://tomilo-lib\\.ru/uploads",
      "https://tomilolib.s3.regru.cloud"
     ],
     [
      "^(?!https?://)/?",
      "https://tomilolib.s3.regru.cloud/"
     ],
     [
      "^https://tomilolib\\.s3\\.regru\\.cloud/uploads",
      "https://tomilolib.s3.regru.cloud"
     ]
    ]
   }
  }
 },
 "hinweise": [
  "JSON-API {base}/api wie Community (titles limit 30, chapters limit 200; weiter bei page < pages). Accept: application/json nur an den API-Anfragen – das CDN antwortet sonst bei Bildern mit 403 (Community-Kommentar).",
  "18+-Titel werden wie in der Community-Standardeinstellung ausgeblendet (skip isAdult). Filter nicht übernommen.",
  "Manga-URL /titles/<slug>#<_id> (Fragment trägt die API-ID), Kapitel-URL /chapters/<_id> (nur intern, Website-Leserpfad unbekannt).",
  "Bezahlte Kapitel (isPaid) werden als gesperrt ausgelassen – auch solche, die nach freeAt schon frei sind (Community prüft isPaid && unlockPrice>0 && freeAt in Zukunft; Bedingungs-Kombination nicht ausdrückbar). Unveröffentlichte (isPublished=false) übersprungen.",
  "Bild-URLs: relative Pfade und /uploads/… werden wie in der Community auf https://tomilolib.s3.regru.cloud umgeschrieben (Ersetzungskette in Reihenfolge)."
 ]
}
