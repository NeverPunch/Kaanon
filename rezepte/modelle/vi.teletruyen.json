{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "TeleTruyen",
  "sprache": "vi",
  "base_url": "https://teletruyen.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.vi.kaanon.teletruyen",
  "quellen": [
   {
    "name": "TeleTruyen",
    "sprache": "vi",
    "quell_id": 7833855011739264901,
    "home": "https://teletruyen.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/vi/teletruyen",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/danh-sach/xem-nhieu?page={page}",
   "items": ".comic-item:has(a[href] h3.comic-title)",
   "fields": {
    "url": "a[href]:has(h3.comic-title)@href",
    "title": "a[href]:has(h3.comic-title)",
    "cover": [
     "img@data-src",
     "img@src"
    ]
   },
   "has_next": {
    "min": 1
   }
  },
  "latest": {
   "request": "{base}/danh-sach/truyen-moi-cap-nhat?page={page}",
   "items": ".comic-item:has(a[href] h3.comic-title)",
   "fields": {
    "url": "a[href]:has(h3.comic-title)@href",
    "title": "a[href]:has(h3.comic-title)",
    "cover": [
     "img@data-src",
     "img@src"
    ]
   },
   "has_next": {
    "min": 1
   }
  },
  "search": {
   "request": "{base}/tim-kiem-nang-cao?keyword={query}&page={page}",
   "items": ".comic-item:has(a[href] h3.comic-title)",
   "fields": {
    "url": "a[href]:has(h3.comic-title)@href",
    "title": "a[href]:has(h3.comic-title)",
    "cover": [
     "img@data-src",
     "img@src"
    ]
   },
   "has_next": {
    "min": 1
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h2.info-title",
    "author": "a[href*='/tac-gia/']",
    "status": {
     "path": ".comic-intro-text strong:matchesOwn(^Tình trạng:) + span",
     "replace": [
      [
       "(?s)^.*Đang tiến hành.*$",
       "ongoing"
      ],
      [
       "(?s)^.*Đã hoàn thành.*$",
       "completed"
      ]
     ]
    },
    "genres": {
     "path": ".comic-info a[href*='/the-loai/']",
     "all": true,
     "join": ", "
    },
    "cover": [
     ":has(> .comic-info) > .col-sm-4 > img@data-src",
     ":has(> .comic-info) > .col-sm-4 > img@src"
    ],
    "description": "div.hide-long-text"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "table tr:has(a[href*='/chuong-'])",
   "skip": {
    "path": "a[href*='/chuong-']",
    "regex": "(?i)^(?!.*Chap\\s+\\d)"
   },
   "fields": {
    "url": "a[href*='/chuong-']@href",
    "name": {
     "path": "a[href*='/chuong-']",
     "regex": "(?i)(Chap\\s+\\d+(?:\\.\\d+)?)",
     "group": 1
    },
    "number": {
     "path": "a[href*='/chuong-']",
     "regex": "(?i)Chap\\s+(\\d+(?:\\.\\d+)?)",
     "group": 1
    },
    "date": "td.hidden-xs.hidden-sm"
   },
   "date_format": "dd/MM/yyyy"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "#view-chapter img[data-src]",
   "image": "@data-src"
  }
 },
 "hinweise": [
  "HTML wie Community: Beliebt /danh-sach/xem-nhieu, Neueste /danh-sach/truyen-moi-cap-nhat, Suche /tim-kiem-nang-cao?keyword= (je ?page=n). Weiter, solange Einträge kommen (Community prüft Link auf page=n+1). Genre-Filter nicht übernommen.",
  "Details: Cover = .col-sm-4 > img im Elternelement von .comic-info (data-src vor src). Beschreibung = Text von div.hide-long-text (Community entfernt vorher .hide-long-text-shadow – dessen Text, falls vorhanden, bleibt hier drin). Genre-Dubletten nicht entfernt.",
  "Kapitel: Tabellenzeilen mit Link /chuong-…, Name = 'Chap N' aus dem Linktext (andere Zeilen übersprungen), Datum dd/MM/yyyy."
 ]
}
