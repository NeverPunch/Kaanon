{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "DGManga",
  "sprache": "uk",
  "base_url": "https://dgmanga.app",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.uk.kaanon.dgmanga",
  "quellen": [
   {
    "name": "DGManga",
    "sprache": "uk",
    "quell_id": 8158890639660553015,
    "home": "https://dgmanga.app"
   }
  ]
 },
 "quelle": {
  "modul": "src/uk/dgmanga",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.4",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Referer": "{base}/"
  },
  "popular": {
   "request": "{base}/api/titles?page={page}&limit=28&sort=popular",
   "format": "json",
   "items": "titles",
   "has_next": {
    "lt": [
     "page",
     "totalPages"
    ]
   },
   "skip": {
    "path": "type",
    "equals": "novel"
   },
   "fields": {
    "url": {
     "path": "_id",
     "template": "/title/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "latest": {
   "request": "{base}/api/titles?page={page}&limit=28&sort=updated",
   "format": "json",
   "items": "titles",
   "has_next": {
    "lt": [
     "page",
     "totalPages"
    ]
   },
   "skip": {
    "path": "type",
    "equals": "novel"
   },
   "fields": {
    "url": {
     "path": "_id",
     "template": "/title/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "search": {
   "request": "{base}/api/titles?page={page}&limit=28&q={query}",
   "format": "json",
   "items": "titles",
   "has_next": {
    "lt": [
     "page",
     "totalPages"
    ]
   },
   "skip": {
    "path": "type",
    "equals": "novel"
   },
   "fields": {
    "url": {
     "path": "_id",
     "template": "/title/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "details": {
   "request": "{base}/api/titles/{u.id}",
   "format": "json",
   "url_vars": {
    "id": "/title/([^/#?]+)"
   },
   "let": {
    "desc": "description",
    "alt": {
     "path": "alternativeTitles.*",
     "all": true,
     "join": ","
    }
   },
   "fields": {
    "title": "title",
    "cover": "cover",
    "description": {
     "const": "{l.desc}[[§§Альтернативні назви: {l.alt}]]",
     "replace": [
      [
       "^§§",
       ""
      ],
      [
       "§§",
       "\n\n"
      ]
     ]
    },
    "author": {
     "path": "authorRef.*.name",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "illustratorRef.*.name",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": [
      "ageRating",
      "type",
      "genres.*",
      "tags.*"
     ],
     "union": true
    },
    "status": "translation_status"
   },
   "status_map": {
    "перекладається": 1,
    "завершено": 2,
    "покинуто": 5
   }
  },
  "chapters": {
   "request": "{base}/api/chapters/title/{u.id}",
   "format": "json",
   "items": "$",
   "fields": {
    "url": {
     "path": "_id",
     "template": "/read/{f.title}/{f.chapterNumber}?chapterId={value}"
    },
    "name": {
     "path": "chapterNumber",
     "template": "Том {f.volumeNumber} Розділ {value}[[ {f.chapterName}]]"
    },
    "number": "chapterNumber",
    "date": [
     "createdAt",
     "updatedAt"
    ],
    "scanlator": {
     "path": "teams.*.name",
     "all": true,
     "join": ", "
    }
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{base}/api/chapters/{u.cid}",
   "format": "json",
   "url_vars": {
    "cid": "chapterId=([^&#]+)"
   },
   "items": "pages",
   "image": ""
  }
 },
 "hinweise": [
  "JSON-API (KeiSource): /api/titles (Listen, limit 28), /api/titles/<_id>, /api/chapters/title/<_id>, /api/chapters/<chapterId>.",
  "Novellen (type=novel) werden wie im Community-Code ausgelassen. Einstellung ‚Kategorien verstecken‘/‚Lizenzierte verstecken‘ nicht abgebildet.",
  "Kapitel-URL wie Community-WebView-URL /read/<title>/<nr>?chapterId=<id>; Seiten nutzen nur chapterId.",
  "Genres: Altersfreigabe, Typ (Rohwert, Community übersetzt ins Ukrainische), genres+tags. Kapitelliste als Wurzel-Array (items \"$\") – prüfen."
 ]
}
