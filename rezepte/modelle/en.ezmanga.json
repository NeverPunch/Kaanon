{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "EZmanga",
  "sprache": "en",
  "base_url": "https://ezmanga.org",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.ezmanga",
  "quellen": [
   {
    "name": "EZmanga",
    "sprache": "en",
    "quell_id": 3317136566565343717,
    "home": "https://ezmanga.org"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/ezmanga",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "ezmanhwa"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Accept": "application/json, text/plain, */*"
  },
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "https://vapi.ezmanga.org/api/v1/series?page={page}&perPage=20&sort=popular",
   "format": "json",
   "items": "data",
   "skip": {
    "path": "type",
    "regex": "(?i)^novel$"
   },
   "has_next": {
    "lt": [
     "current",
     "totalPages"
    ]
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/series/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "latest": {
   "request": "https://vapi.ezmanga.org/api/v1/series?page={page}&perPage=20&sort=latest",
   "format": "json",
   "items": "data",
   "skip": {
    "path": "type",
    "regex": "(?i)^novel$"
   },
   "has_next": {
    "lt": [
     "current",
     "totalPages"
    ]
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/series/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "search": {
   "request": "https://vapi.ezmanga.org/api/v1/series/search?page={page}&perPage=20&q={query}",
   "format": "json",
   "items": "data",
   "skip": {
    "path": "type",
    "regex": "(?i)^novel$"
   },
   "has_next": {
    "lt": [
     "current",
     "totalPages"
    ]
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/series/{value}"
    },
    "title": "title",
    "cover": "cover"
   }
  },
  "details": {
   "request": "https://vapi.ezmanga.org/api/v1/series/{u.slug}",
   "format": "json",
   "url_vars": {
    "slug": "/series/([^/#?]+)"
   },
   "fields": {
    "title": "title",
    "cover": "cover",
    "description": {
     "path": "description",
     "decode": "html_text"
    },
    "genres": "genres.*.name",
    "author": "author",
    "artist": "artist",
    "status": "status"
   },
   "status_map": {
    "ongoing": 1,
    "mass_released": 1,
    "completed": 2,
    "dropped": 5,
    "hiatus": 6
   }
  },
  "chapters": {
   "request": "https://vapi.ezmanga.org/api/v1/series/{u.slug}/chapters?page={page}&perPage=100&sort=desc",
   "format": "json",
   "url_vars": {
    "slug": "/series/([^/#?]+)"
   },
   "items": "data",
   "skip": "requiresPurchase",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/series/{u.slug}/{value}"
    },
    "name": [
     {
      "path": "title",
      "regex": "(?iu)^((?:chapter|ch\\.?|episode|ep\\.?)\\s*\\d.*)$",
      "group": 1
     },
     {
      "path": "number",
      "replace": [
       [
        "\\.0+$",
        ""
       ]
      ],
      "template": "Chapter {value}[[ - {f.title}]]"
     }
    ],
    "number": "number",
    "date": "createdAt"
   },
   "date_format": "iso",
   "paging": {
    "has_next": {
     "lt": [
      "^current",
      "^totalPages"
     ]
    },
    "max_pages": 60
   }
  },
  "pages": {
   "request": "https://vapi.ezmanga.org/api/v1/series/{u.slug}/chapters/{u.chapter}",
   "format": "json",
   "url_vars": {
    "slug": "/series/([^/]+)/[^/]+/?$",
    "chapter": "/series/[^/]+/([^/?#]+)/?$"
   },
   "items": "images",
   "image": "url"
  }
 },
 "hinweise": [
  "Theme EZManhwa (KeiSource, JSON-API https://vapi.ezmanga.org/api/v1). Listen/Suche wie im Code: page/perPage=20, sort=popular bzw. latest, Suche /series/search?q=…; NOVEL-Einträge werden ausgelassen.",
  "has_next über 'current' < 'totalPages' (DTO-Felder). Kapitel seitenweise (perPage=100, sort=desc) bis current = totalPages; ob 'lt' mit '^' auf die Wurzel zeigt, ist aus den Vorlagen übernommen (es.olympusscanlation).",
  "Kapitel-URL wie die Website (/series/{serie}/{kapitel}); die Seiten-API braucht /series/{serie}/chapters/{kapitel}. Kaufkapitel (requiresPurchase) werden übersprungen (Community blendet sie standardmäßig auch aus).",
  "Kapitelname vereinfacht: Titel, wenn er schon mit Chapter/Ep beginnt, sonst 'Chapter N - Titel'. Ist der Titel nur die Nummer, entsteht 'Chapter N - N' (Community fängt das ab).",
  "Fetch.XHR der Community setzt evtl. zusätzlich X-Requested-With; hier nur Accept-Header wie im Theme.",
  "Alternative Titel hängt die Community an die Beschreibung an; hier weggelassen."
 ]
}