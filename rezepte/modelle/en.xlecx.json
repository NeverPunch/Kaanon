{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "XlecX",
  "sprache": "en",
  "base_url": "https://xlecx.one",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.xlecx",
  "quellen": [
   {
    "name": "XlecX",
    "sprache": "en",
    "quell_id": 3691755476092994375,
    "home": "https://xlecx.one"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/xlecx",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.3",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/f/sort=news_read/order=desc/page/{page}/",
   "request_by_page": {
    "1": "{base}/f/sort=news_read/order=desc/"
   },
   "items": "#dle-content > a.thumb",
   "fields": {
    "url": "@href",
    "title": "img@alt",
    "cover": "img@src"
   },
   "has_next": {
    "exists": "#pagination > .pagination__pages > a:contains(Next)"
   }
  },
  "latest": {
   "request": "{base}/f/sort=date/order=desc/page/{page}/",
   "request_by_page": {
    "1": "{base}/f/sort=date/order=desc/"
   },
   "items": "#dle-content > a.thumb",
   "fields": {
    "url": "@href",
    "title": "img@alt",
    "cover": "img@src"
   },
   "has_next": {
    "exists": "#pagination > .pagination__pages > a:contains(Next)"
   }
  },
  "search": {
   "request": "{base}/index.php?do=search&subaction=search&search_start={page}&full_search=0&story={query}",
   "items": "#dle-content > a.thumb",
   "fields": {
    "url": "@href",
    "title": "img@alt",
    "cover": "img@src"
   },
   "has_next": {
    "exists": "#pagination > .pagination__pages > a:contains(Next)"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1",
    "artist": {
     "path": ".page__subinfo-item > div:not([class]):contains(Artist:) ~ a",
     "all": true,
     "join": ", "
    },
    "author": {
     "path": ".page__subinfo-item > div:not([class]):contains(Group:) ~ a",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": ".page__subinfo-item > div:not([class]):contains(Tags:) ~ a",
     "all": true,
     "join": ", "
    },
    "cover": "meta[property=og:image]@content"
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "const": "Chapter"
    },
    "number": {
     "const": "1"
    },
    "date": {
     "path": "script[type=application/ld+json]@html",
     "all": true,
     "join": "\n",
     "regex": "\"date(?:Modified|Published)\"\\s*:\\s*\"([^\"]+)\""
    }
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": [
    "#content-2 > .imagegall23 > img",
    ".page__text a:has(img)",
    "#content-1 > .imagegall23 > img"
   ],
   "image": [
    "@data-src",
    "@src",
    "@href"
   ]
  }
 },
 "hinweise": [
  "Einzelgalerie: ein Kapitel 'Chapter' (Nummer 1) mit der URL des Eintrags.",
  "Datum: erstes dateModified/datePublished im JSON-LD (Community bevorzugt dateModified; Reihenfolge im JSON-LD ungeprüft).",
  "Seiten in der Reihenfolge der Community: Tab 'Full size' (#content-2), sonst Links in .page__text, sonst Tab 'Thumb' (#content-1); letzter Ausweg der Community (JSON-LD image-Liste) nicht nachgebaut.",
  "Suche nur Text (DLE-Suche, search_start = Seite); keine Filter (Community auch keine)."
 ]
}
