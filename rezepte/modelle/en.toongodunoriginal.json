{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "ToonGod (Unoriginal)",
  "sprache": "en",
  "base_url": "https://toongod.cc",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.toongodunoriginal",
  "quellen": [
   {
    "name": "ToonGod (Unoriginal)",
    "sprache": "en",
    "quell_id": 339438238793535753,
    "home": "https://toongod.cc"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/toongodcc",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "yiimanga"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/webtoons/page/{page}/?order=views",
   "items": ".latest-list .latest-item, .list .list-item",
   "has_next": {
    "exists": "#pagination li.next a"
   },
   "fields": {
    "url": [
     ".latest-right a:has(h3, h4)@href",
     ".item-title a@href"
    ],
    "title": [
     ".latest-right a:has(h3, h4)",
     ".item-title a"
    ],
    "cover": [
     ".latest-left img@src",
     ".item-img img@src"
    ]
   }
  },
  "latest": {
   "request": "{base}/page/{page}/",
   "items": ".latest-list .latest-item, .list .list-item",
   "has_next": {
    "exists": "#pagination li.next a"
   },
   "fields": {
    "url": [
     ".latest-right a:has(h3, h4)@href",
     ".item-title a@href"
    ],
    "title": [
     ".latest-right a:has(h3, h4)",
     ".item-title a"
    ],
    "cover": [
     ".latest-left img@src",
     ".item-img img@src"
    ]
   }
  },
  "search": {
   "request": "{base}/search/?s={query}&page={page}",
   "items": ".latest-list .latest-item, .list .list-item",
   "has_next": {
    "exists": "#pagination li.next a"
   },
   "fields": {
    "url": [
     ".latest-right a:has(h3, h4)@href",
     ".item-title a@href"
    ],
    "title": [
     ".latest-right a:has(h3, h4)",
     ".item-title a"
    ],
    "cover": [
     ".latest-left img@src",
     ".item-img img@src"
    ]
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": [
     "h1.main-info-title",
     ".post-title h1",
     ".manga-detail .info h1"
    ],
    "cover": [
     "img.img-cover@src",
     ".summary_image img@src",
     ".manga-detail .poster img@src"
    ],
    "author": {
     "path": [
      ".main-info-list li:has(> h5:contains(Author)) > :not(h5) a@ownText",
      ".post-content_item:has(.summary-heading > h5:contains(Author)) > :not(.summary-heading) a@ownText",
      ".info-item:has(> span.sh:contains(Author)) > :not(.sh) a@ownText",
      ".main-info-list li:has(> h5:contains(Author)) > :not(h5)",
      ".post-content_item:has(.summary-heading > h5:contains(Author)) > :not(.summary-heading)",
      ".info-item:has(> span.sh:contains(Author)) > :not(.sh)"
     ],
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": [
      ".main-info-list li:has(> h5:contains(Artist)) > :not(h5) a@ownText",
      ".post-content_item:has(.summary-heading > h5:contains(Artist)) > :not(.summary-heading) a@ownText",
      ".info-item:has(> span.sh:contains(Artist)) > :not(.sh) a@ownText",
      ".main-info-list li:has(> h5:contains(Artist)) > :not(h5)",
      ".post-content_item:has(.summary-heading > h5:contains(Artist)) > :not(.summary-heading)",
      ".info-item:has(> span.sh:contains(Artist)) > :not(.sh)"
     ],
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": [
      ".main-info-list li:has(> h5:contains(Genre)) > :not(h5) a@ownText",
      ".post-content_item:has(.summary-heading > h5:contains(Genre)) > :not(.summary-heading) a@ownText",
      ".info-item:has(> span.sh:contains(Genre)) > :not(.sh) a@ownText",
      ".main-info-list li:has(> h5:contains(Genre)) > :not(h5)",
      ".post-content_item:has(.summary-heading > h5:contains(Genre)) > :not(.summary-heading)",
      ".info-item:has(> span.sh:contains(Genre)) > :not(.sh)"
     ],
     "all": true,
     "join": ", "
    },
    "status": [
     ".main-info-list li:has(> h5:contains(Status)) > :not(h5)",
     ".post-content_item:has(.summary-heading > h5:contains(Status)) > :not(.summary-heading)",
     ".info-item:has(> span.sh:contains(Status)) > :not(.sh)",
     ".manga-detail .info p.type"
    ],
    "description": {
     "path": [
      ".short-desc-content p, .short-desc-content li",
      ".dsct p, .dsct li",
      ".description-summary p, .description-summary li",
      ".short-desc-content",
      ".dsct",
      ".description-summary"
     ],
     "all": true,
     "join": "\n\n"
    }
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "ul.chapter-list li, ul.row-content-chapter li, .list-items li.item",
   "fields": {
    "url": "a[href]@href",
    "name": [
     ".chapter-name",
     "a > span:first-child"
    ],
    "date": [
     ".ct-update",
     ".chapter-time",
     "a > span:nth-child(2)"
    ]
   },
   "date_format": [
    "dd MMM yyyy",
    "dd MMM yy",
    "MMM yy"
   ],
   "date_locale": "en"
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".reading-content img, .read-content img",
   "image": "@src"
  }
 },
 "hinweise": [
  "Aufgebaut wie en.hentai20unoriginal (gleiches Theme).",
  "Theme Yiimanga (Einträge unter /webtoon/…). Beliebt /webtoons/page/N/?order=views, Neueste /page/N/, Suche /search/?s=…&page=N; Genre-Filter nicht nachgebaut.",
  "Info-Zeilen (Author/Artist/Genres/Status) über :has()/:contains() auf die Überschrift (h5 bzw. span.sh) nachgebildet; Code vergleicht exakt (ohne ':'), :contains ist großzügiger.",
  "Namen: Links je ownText (Code: verschachtelter Komma-Span), sonst Text des Feldes.",
  "Datum '06 Oct 2026', '12 Oct 26' oder 'Oct 26' (dann Tag 1) – Formatliste dd MMM yyyy / dd MMM yy / MMM yy.",
  "Alternativnamen nicht an die Beschreibung angehängt."
 ]
}