{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Luvaholic",
  "sprache": "vi",
  "base_url": "https://luvaholic.website",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.vi.kaanon.luvaholic",
  "quellen": [
   {
    "name": "Luvaholic",
    "sprache": "vi",
    "quell_id": 1369379704953903278,
    "home": "https://luvaholic.website"
   }
  ]
 },
 "quelle": {
  "modul": "src/vi/luvaholic",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}",
   "items": ".td-hot-slider .comic-card",
   "fields": {
    "url": [
     {
      "path": "@onclick",
      "regex": "location\\.href='([^']+)'",
      "group": 1
     },
     {
      "path": "[onclick]@onclick",
      "regex": "location\\.href='([^']+)'",
      "group": 1
     },
     "a[href]@href"
    ],
    "title": "h3",
    "cover": "img@img"
   },
   "has_next": {
    "const": false
   }
  },
  "latest": {
   "request": "{base}/kho-truyen/page/{page}/?sort=new",
   "request_by_page": {
    "1": "{base}/kho-truyen/?sort=new"
   },
   "items": ".row-cols-2 .col:has(h3), .row .col:has(h3)",
   "fields": {
    "url": [
     {
      "path": "@onclick",
      "regex": "location\\.href='([^']+)'",
      "group": 1
     },
     {
      "path": "[onclick]@onclick",
      "regex": "location\\.href='([^']+)'",
      "group": 1
     },
     "a[href]@href"
    ],
    "title": "h3",
    "cover": "img@img"
   },
   "has_next": {
    "exists": "ul.page-numbers a.next"
   }
  },
  "search": {
   "request": "{base}/?s={query}&paged={page}",
   "items": ".row-cols-2 .col:has(h3), .row .col:has(h3)",
   "fields": {
    "url": [
     {
      "path": "@onclick",
      "regex": "location\\.href='([^']+)'",
      "group": 1
     },
     {
      "path": "[onclick]@onclick",
      "regex": "location\\.href='([^']+)'",
      "group": 1
     },
     "a[href]@href"
    ],
    "title": "h3",
    "cover": "img@img"
   },
   "has_next": {
    "exists": "ul.page-numbers a.next"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "main h1",
    "cover": [
     "main .ratio img.wp-post-image@img",
     "main img.wp-post-image@img"
    ],
    "author": "main .row.g-3 > [class*=col-]:has(.small:contains(Tác giả)) a, main .row.g-3 > [class*=col-]:has(.small:contains(Tác giả)) strong",
    "artist": "main .row.g-3 > [class*=col-]:has(.small:contains(Họa sĩ)) a, main .row.g-3 > [class*=col-]:has(.small:contains(Họa sĩ)) strong, main .row.g-3 > [class*=col-]:has(.small:contains(Artist)) a, main .row.g-3 > [class*=col-]:has(.small:contains(Artist)) strong",
    "genres": {
     "path": "main a.badge[href*=\"/category/\"]",
     "all": true,
     "join": ", "
    },
    "description": [
     {
      "path": "main h3:contains(Tóm tắt nội dung) + div p",
      "all": true,
      "join": "\n\n"
     },
     "main h3:contains(Tóm tắt nội dung) + div"
    ],
    "status": {
     "path": "main .row.g-3 > [class*=col-]:has(.small:contains(Tình trạng)) a, main .row.g-3 > [class*=col-]:has(.small:contains(Tình trạng)) strong",
     "replace": [
      [
       "(?s)^.*(?:Hoàn thành|hoàn thành).*$",
       "completed"
      ],
      [
       "(?s)^.*(?:Đang cập nhật|đang cập nhật).*$",
       "ongoing"
      ],
      [
       "(?s)^.*(?:Tạm|tạm).*$",
       "hiatus"
      ],
      [
       "(?s)^.*(?:Drop|drop|Hủy|hủy).*$",
       "cancelled"
      ]
     ]
    }
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "hiatus": 6,
    "cancelled": 5
   }
  },
  "chapters": {
   "request": "details",
   "items": "#chapter-list-container a.chap-item",
   "fields": {
    "url": "@href",
    "name": [
     "span",
     ""
    ]
   },
   "reverse": true
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".td-chap-images img, #chapter-content-text img",
   "image": [
    "@src",
    "@data-src"
   ]
  }
 },
 "hinweise": [
  "HTML wie Community: Beliebt = Slider der Startseite (eine Seite), Neueste /kho-truyen[/page/n]/?sort=new, Suche /?s=…&paged=n. Genre-/Status-/Sortierfilter nicht übernommen.",
  "Karten: URL aus onclick (location.href='…', am Element selbst oder einem Kind), sonst a[href]; Titel h3; Cover img (src, sonst srcset über @img).",
  "Details: Autor/Künstler/Status aus den Blöcken main .row.g-3 mit Beschriftung (.small) 'Tác giả' / 'Họa sĩ'/'Artist' / 'Tình trạng' (erstes a bzw. strong).",
  "Kapitel: #chapter-list-container a.chap-item, Reihenfolge umgekehrt (wie Community). Seiten: .td-chap-images img bzw. #chapter-content-text img."
 ]
}
