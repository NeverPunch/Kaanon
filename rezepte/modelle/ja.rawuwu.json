{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Raw UwU",
  "sprache": "ja",
  "base_url": "https://rawuwu.net",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.ja.kaanon.rawuwu",
  "quellen": [
   {
    "name": "Raw UwU",
    "sprache": "ja",
    "quell_id": 2270841189174019045,
    "home": "https://rawuwu.net"
   }
  ]
 },
 "quelle": {
  "modul": "src/ja/rawuwu",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/spa/genre/all?status=&sort=most_viewed&page={page}",
   "format": "json",
   "items": "manga_list",
   "fields": {
    "url": {
     "path": "manga_id",
     "template": "/raw/{value}"
    },
    "title": "manga_name",
    "cover": "manga_cover_img"
   },
   "has_next": {
    "exists": "pagi.button.next"
   }
  },
  "latest": {
   "request": "{base}/spa/genre/all?status=&sort=&page={page}",
   "format": "json",
   "items": "manga_list",
   "fields": {
    "url": {
     "path": "manga_id",
     "template": "/raw/{value}"
    },
    "title": "manga_name",
    "cover": "manga_cover_img"
   },
   "has_next": {
    "exists": "pagi.button.next"
   }
  },
  "search": {
   "request": "{base}/spa/search?query={query}&page={page}",
   "format": "json",
   "items": "manga_list",
   "fields": {
    "url": {
     "path": "manga_id",
     "template": "/raw/{value}"
    },
    "title": "manga_name",
    "cover": "manga_cover_img"
   },
   "has_next": {
    "exists": "pagi.button.next"
   }
  },
  "details": {
   "request": "{base}/spa/manga/{u.id}",
   "format": "json",
   "url_vars": {
    "id": "/raw/(\\d+)"
   },
   "fields": {
    "title": "detail.manga_name",
    "cover": "detail.manga_cover_img",
    "description": "detail.manga_description",
    "author": {
     "path": "authors.*.author_name",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": "tags.*.tag_name",
     "all": true,
     "join": ", "
    },
    "status": "detail.manga_status"
   },
   "status_map": {
    "true": 2,
    "false": 1
   }
  },
  "chapters": {
   "request": "details",
   "items": "chapters",
   "fields": {
    "url": {
     "path": "chapter_number",
     "replace": [
      [
       "\\.0$",
       ""
      ]
     ],
     "template": "/read/{u.id}/chapter-{value}"
    },
    "name": {
     "path": "chapter_number",
     "replace": [
      [
       "\\.0$",
       ""
      ]
     ],
     "template": "Chapter {value}[[ - {f.chapter_title}]]"
    },
    "number": "chapter_number",
    "date": "chapter_date_published"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{base}/spa/manga/{u.mid}/{u.ch}",
   "url_vars": {
    "mid": "/read/(\\d+)/",
    "ch": "/chapter-([^/?#]+)"
   },
   "format": "json_html",
   "html_path": "chapter_detail.chapter_content",
   "items": "img[data-src]",
   "image": "@data-src"
  }
 },
 "hinweise": [
  "Gleiche /spa/-API wie ja.rawdevartart (Rezept als Ausgangspunkt). Beliebt = /spa/genre/all?status=&sort=most_viewed, Neueste = sort leer (Recently updated), Suche /spa/search?query=. Status-/Sortier-/Genrefilter nicht nachgebaut.",
  "Nächste Seite: Community prüft pagi.button.next > 0; hier exists auf pagi.button.next – prüfen, ob die Engine 0 als nicht vorhanden wertet.",
  "URLs wie die Website: Manga /raw/<id> (Community speichert nur die id), Kapitel /read/<id>/chapter-<nummer> (Nummer ohne '.0').",
  "Kapitelname: Community 'Ch. N - Titel' bzw. 'Chapter N'; hier 'Chapter N[ - Titel]'.",
  "Bilder aus chapter_detail.chapter_content (HTML) img@data-src; Community löst relative Pfade gegen chapter_detail.server auf – hier nicht, prüfen.",
  "Beschreibung ohne angehängte Alternativtitel; Genres ohne Umwandlung in Titelschreibweise. Status: manga_status true = abgeschlossen, sonst laufend."
 ]
}
