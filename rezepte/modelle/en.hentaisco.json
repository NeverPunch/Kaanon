{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "HentaiSco",
  "sprache": "en",
  "base_url": "https://hentaisco.cc",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.hentaisco",
  "quellen": [
   {
    "name": "HentaiSco",
    "sprache": "en",
    "quell_id": 6741034623728813910,
    "home": "https://hentaisco.cc"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/hentaisco",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.57",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/hentai-list/page/{page}/?m_orderby=views",
   "request_by_page": {
    "1": "{base}/hentai-list/?m_orderby=views"
   },
   "items": "article.cover-card",
   "has_next": {
    "exists": "nav.pager a[rel=next]"
   },
   "fields": {
    "url": "a@href",
    "title": "h3",
    "cover": "img@src"
   }
  },
  "latest": {
   "request": "{base}/hentai-list/page/{page}/",
   "request_by_page": {
    "1": "{base}/hentai-list/"
   },
   "items": "article.cover-card",
   "has_next": {
    "exists": "nav.pager a[rel=next]"
   },
   "fields": {
    "url": "a@href",
    "title": "h3",
    "cover": "img@src"
   }
  },
  "search": {
   "request": "{base}/search/?q={query}&page={page}",
   "request_by_page": {
    "1": "{base}/search/?q={query}"
   },
   "items": "article.cover-card",
   "has_next": {
    "exists": "nav.pager a[rel=next]"
   },
   "fields": {
    "url": "a@href",
    "title": "h3",
    "cover": "img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "article[data-manga-id] h1",
    "cover": "article[data-manga-id] .cover-frame img@src",
    "author": {
     "path": "article[data-manga-id] dt:containsOwn(Author) + dd a",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "article[data-manga-id] dt:containsOwn(Artist) + dd a",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": "article[data-manga-id] a[href^=/genre/], article[data-manga-id] a[href^=/tag/]",
     "all": true,
     "join": ", ",
     "replace": [
      [
       "^#",
       ""
      ],
      [
       ", #",
       ", "
      ]
     ]
    },
    "description": {
     "path": "article[data-manga-id] [data-read-more-body] p, article[data-manga-id] h1 + p",
     "all": true,
     "join": "\n\n"
    },
    "status": {
     "path": "article[data-manga-id] p:has(+ h1)",
     "regex": "(?i)(ongoing|completed)",
     "group": 1
    }
   },
   "status_map": {
    "ongoing": 1,
    "Ongoing": 1,
    "ONGOING": 1,
    "completed": 2,
    "Completed": 2,
    "COMPLETED": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "article[data-manga-id] ol[data-chapter-list] > li > a",
   "fields": {
    "url": "@href",
    "name": "span",
    "date": "time@datetime"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "[data-reader-pages] img.reader-page",
   "image": "@src"
  }
 },
 "hinweise": [
  "Listen /hentai-list/ (Beliebt mit m_orderby=views), ab Seite 2 /hentai-list/page/N/ (request_by_page für Seite 1).",
  "Suche /search/?q=… mit ?page=N ab Seite 2 (die /search/page/N/-Links der Website sind laut Community 404). Filter (Sortierung, Status, Typ, Genre) nicht übernommen.",
  "Status aus dem Absatz vor h1 (enthält ongoing/completed), Genres = /genre/- und /tag/-Links ohne führendes '#'. Beschreibung: CSS-Vereinigung, Reihenfolge = Dokumentreihenfolge (Community: Read-more-Text zuerst).",
  "Alte Madara-URLs (memo path) der Community nicht nötig: Rezept nutzt die absoluten Links der Website."
 ]
}
