{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Shinigami",
  "sprache": "id",
  "base_url": "https://11.shinigami.asia",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.id.kaanon.shinigami",
  "quellen": [
   {
    "name": "Shinigami",
    "sprache": "id",
    "quell_id": 3411809758861089969,
    "home": "https://11.shinigami.asia"
   }
  ]
 },
 "quelle": {
  "modul": "src/id/shinigami",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.85",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "image_headers": {
   "DNT": "1",
   "Sec-GPC": "1"
  },
  "popular": {
   "request": {
    "url": "https://api.shngm.io/v1/manga/list?page={page}&page_size=30&sort=popularity",
    "headers": {
     "Accept": "application/json",
     "DNT": "1",
     "Sec-GPC": "1",
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "items": "data",
   "fields": {
    "url": {
     "path": "manga_id",
     "template": "/series/{value}"
    },
    "title": "title",
    "cover": [
     "cover_portrait_url",
     "cover_image_url"
    ]
   },
   "has_next": {
    "lt": [
     "meta.page",
     "meta.total_page"
    ]
   }
  },
  "latest": {
   "request": {
    "url": "https://api.shngm.io/v1/manga/list?page={page}&page_size=30&sort=latest",
    "headers": {
     "Accept": "application/json",
     "DNT": "1",
     "Sec-GPC": "1",
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "items": "data",
   "fields": {
    "url": {
     "path": "manga_id",
     "template": "/series/{value}"
    },
    "title": "title",
    "cover": [
     "cover_portrait_url",
     "cover_image_url"
    ]
   },
   "has_next": {
    "lt": [
     "meta.page",
     "meta.total_page"
    ]
   }
  },
  "search": {
   "request": {
    "url": "https://api.shngm.io/v1/manga/list?page={page}&page_size=30&q={query}",
    "headers": {
     "Accept": "application/json",
     "DNT": "1",
     "Sec-GPC": "1",
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "items": "data",
   "fields": {
    "url": {
     "path": "manga_id",
     "template": "/series/{value}"
    },
    "title": "title",
    "cover": [
     "cover_portrait_url",
     "cover_image_url"
    ]
   },
   "has_next": {
    "lt": [
     "meta.page",
     "meta.total_page"
    ]
   }
  },
  "details": {
   "request": {
    "url": "https://api.shngm.io/v1/manga/detail/{u.id}",
    "headers": {
     "Accept": "application/json",
     "DNT": "1",
     "Sec-GPC": "1",
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "url_vars": {
    "id": "/series/([^/?#]+)"
   },
   "fields": {
    "title": "data.title",
    "cover": [
     "data.cover_portrait_url",
     "data.cover_image_url"
    ],
    "description": "data.description",
    "author": {
     "path": "data.taxonomy.Author.*.name",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "data.taxonomy.Artist.*.name",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": "data.taxonomy.Genre.*.name",
     "all": true,
     "join": ", "
    },
    "status": "data.status"
   },
   "status_map": {
    "1": 1,
    "2": 2,
    "3": 6
   }
  },
  "chapters": {
   "request": {
    "url": "https://api.shngm.io/v1/chapter/{u.id}/list?page_size=3000",
    "headers": {
     "Accept": "application/json",
     "DNT": "1",
     "Sec-GPC": "1",
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "url_vars": {
    "id": "/series/([^/?#]+)"
   },
   "items": "data",
   "fields": {
    "url": {
     "path": "chapter_id",
     "template": "/chapter/{value}"
    },
    "name": {
     "path": "chapter_number",
     "replace": [
      [
       "\\.0$",
       ""
      ]
     ],
     "template": "Chapter {value}[[ {f.chapter_title}]]"
    },
    "number": "chapter_number",
    "date": "release_date"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": {
    "url": "https://api.shngm.io/v1/chapter/detail/{u.cid}",
    "headers": {
     "Accept": "application/json",
     "DNT": "1",
     "Sec-GPC": "1",
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "url_vars": {
    "cid": "/chapter/([^/?#]+)"
   },
   "let": {
    "bu": "data.base_url",
    "pa": "data.chapter.path"
   },
   "items": "data.chapter.data",
   "image": {
    "path": "",
    "template": "{l.bu}{l.pa}{value}"
   }
  }
 },
 "hinweise": [
  "API api.shngm.io (/v1/manga/list mit sort=popularity|latest bzw. q=…, page_size=30; /v1/manga/detail/<id>; /v1/chapter/<id>/list?page_size=3000; /v1/chapter/detail/<cid>) mit Accept/DNT/Sec-GPC wie Community.",
  "Eintrags-URL /series/<manga_id>, Kapitel-URL /chapter/<chapter_id> (Community speichert nur die IDs; Web-URLs identisch).",
  "Genres ohne Format-Taxonomie; Beschreibung ohne alternativen Titel. Status 1/2/3 = laufend/abgeschlossen/pausiert.",
  "Bilder: base_url + chapter.path + Dateiname; Bildanfragen mit DNT/Sec-GPC (Community lässt dabei den Referer weg – nicht abbildbar)."
 ]
}
