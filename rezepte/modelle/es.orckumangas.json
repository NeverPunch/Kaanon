{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "OrckuMangas",
  "sprache": "es",
  "base_url": "https://orckumangas.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.es.kaanon.orckumangas",
  "quellen": [
   {
    "name": "Orcku Mangas",
    "sprache": "es",
    "quell_id": 1548462712480376358,
    "home": "https://orckumangas.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/es/orckumangas",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.4",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "cookies": {
   "orcku_mayor_edad": "1"
  },
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/ranking?page={page}",
   "items": "ol li.border-t a[href*=ficha?id=]",
   "fields": {
    "url": "@href",
    "title": [
     "span.truncate",
     "span.font-bold"
    ],
    "cover": "img@src"
   },
   "has_next": {
    "exists": "nav[aria-label=Páginas del ranking] a:containsOwn(Siguiente)"
   }
  },
  "latest": {
   "request": "{base}/",
   "items": "#latestGrid div.reveal a[href*=ficha?id=]:has(span.line-clamp-2)",
   "fields": {
    "url": "@href",
    "title": "span.line-clamp-2",
    "cover": "img@src"
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": "{base}/biblioteca?page={page}&search={query}",
   "items": "ul.grid li a[href*=ficha?id=]",
   "fields": {
    "url": "@href",
    "title": [
     "span.truncate",
     "span.font-bold"
    ],
    "cover": "img@src"
   },
   "has_next": {
    "exists": "nav[aria-label*=Página] a:containsOwn(Siguiente)"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "main#contenido h1",
    "cover": "section[data-ficha] img@src",
    "author": "#panel-info dl div:has(dt:containsOwn(Autor)) dd",
    "artist": "#panel-info dl div:has(dt:containsOwn(Artista)) dd",
    "status": "#panel-info dl div:has(dt:containsOwn(Estado)) dd",
    "genres": {
     "path": "a[href*=biblioteca?genre=]",
     "all": true,
     "join": ", "
    }
   },
   "status_map": {
    "en emisión": 1,
    "En emisión": 1,
    "ongoing": 1,
    "finalizado": 2,
    "Finalizado": 2,
    "completed": 2,
    "en pausa": 6,
    "En pausa": 6,
    "hiatus": 6,
    "cancelado": 5,
    "Cancelado": 5,
    "cancelled": 5
   }
  },
  "chapters": {
   "request": "{abs_url}&order=desc&page={page}",
   "items": "ul#chList li[id^=ch-] a[href*=capitulo?id=]:has(span.font-semibold)",
   "fields": {
    "url": "@href",
    "name": "span.font-semibold",
    "date": "span.text-ink-dim"
   },
   "date_format": [
    "dd/MM/yyyy",
    "relative"
   ],
   "date_locale": "es",
   "paging": {
    "has_next": {
     "exists": "nav[aria-label=Páginas de capítulos] a:containsOwn(Siguiente)"
    },
    "max_pages": 50
   }
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div.chapter-images img, main img[src*=uploads]",
   "image": "@src"
  }
 },
 "hinweise": [
  "HTML-Website (Tailwind). Cookie orcku_mayor_edad=1 wie Community.",
  "Kapitel: Community liest die höchste Seitenzahl aus nav[aria-label='Páginas de capítulos'] und lädt alle Seiten (order=desc). Hier Weiterblättern, solange dort ein Link 'Siguiente' steht – Annahme analog zu den Listen-Navigationen; auf dem PC prüfen.",
  "Relative Daten auf Spanisch ('hace 2 días') – ob 'relative' das versteht, auf dem PC prüfen.",
  "Neueste: nur die Startseite (eine Seite). Doppelte Einträge entfernt die Community (distinctBy) – hier nicht. Filter nicht übernommen."
 ]
}
