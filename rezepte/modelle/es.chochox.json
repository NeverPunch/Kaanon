{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "ChoChoX",
  "sprache": "es",
  "base_url": "https://chochox.com",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.es.kaanon.chochox",
  "quellen": [
   {
    "name": "ChoChoX",
    "sprache": "es",
    "quell_id": 1434289653753200808,
    "home": "https://chochox.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/es/chochox",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.7",
  "theme": "vercomics"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/porno/page/{page}",
   "items": "header:has(h1) ~ * .entry",
   "has_next": {
    "exists": "div.wp-pagenavi > span.current + a"
   },
   "fields": {
    "url": "a.popimg@href",
    "title": "a.popimg img@alt",
    "cover": "a.popimg img:not(noscript img)@img"
   }
  },
  "search": {
   "request": "{base}/page/{page}?s={query}",
   "items": "header:has(h1) ~ * .entry",
   "has_next": {
    "exists": "div.wp-pagenavi > span.current + a"
   },
   "fields": {
    "url": "a.popimg@href",
    "title": "a.popimg img@alt",
    "cover": "a.popimg img:not(noscript img)@img"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": [
     "h1",
     "meta[property=og:title]@content"
    ],
    "cover": "meta[property=og:image]@content",
    "genres": {
     "path": "div.tax_box:has(div.title:contains(Etiquetas)) a[rel=tag]",
     "all": true,
     "join": ", ",
     "replace": [
      [
       "(^|, )#",
       "$1"
      ]
     ]
    },
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": [
     "h1",
     "meta[property=og:title]@content"
    ]
   }
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div.wp-content p > img:not(noscript img), div.wp-content div#lector > img:not(noscript img), div.wp-content > figure img:not(noscript img), div.wp-content > img, div.wp-content > p img, div.post-imgs > img",
   "image": "@img"
  }
 },
 "hinweise": [
  "VerComics-Theme (ChoChoX: urlSuffix 'porno', Suche ohne Suffix: /page/N?s=…). Kein 'Neueste' (supportsLatest=false).",
  "Ein Comic = ein Kapitel (Name im Code = Manga-Titel; hier h1 bzw. og:title, Annahme). Status immer abgeschlossen. Genres aus 'Etiquetas' (#-Präfix entfernt; Großschreibung des ersten Buchstabens nicht nachgebildet).",
  "Titel und Cover setzt die Community nur in der Liste; für Details ersatzweise h1/og:title und og:image (Annahme).",
  "Bilder: imgAttr (data-src, data-lazy-src, srcset, data-cfsrc, src) über @img."
 ]
}