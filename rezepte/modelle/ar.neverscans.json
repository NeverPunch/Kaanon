{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "NeverScans",
  "sprache": "ar",
  "base_url": "https://neverscans.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.ar.kaanon.neverscans",
  "quellen": [
   {
    "name": "NeverScans",
    "sprache": "ar",
    "quell_id": 8433210273073845288,
    "home": "https://neverscans.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/ar/neverscans",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.2",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/manga?sort=popular",
   "items": "a[href^=/manga/]:has(h3)",
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "@href",
    "title": "h3",
    "cover": "img@src"
   }
  },
  "latest": {
   "request": "{base}/manga",
   "items": "a[href^=/manga/]:has(h3)",
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "@href",
    "title": "h3",
    "cover": "img@src"
   }
  },
  "search": {
   "request": "{base}/manga?search={query}",
   "items": "a[href^=/manga/]:has(h3)",
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "@href",
    "title": "h3",
    "cover": "img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1",
    "cover": "aside img@src",
    "genres": "aside a[href*=?genres=]",
    "status": {
     "path": "aside div:contains(الحالة) span",
     "all": true,
     "join": " ",
     "regex": "(مستمرة|مكتملة)"
    }
   },
   "status_map": {
    "مستمرة": 1,
    "مكتملة": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "ol li a[href*=/manga/]",
   "fields": {
    "url": "@href",
    "name": "div[dir=rtl] span",
    "date": "div[dir=rtl] span.tabular"
   },
   "date_format": "d/M/yyyy"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "img[src*=/api/public/page/]",
   "image": "@src"
  }
 },
 "hinweise": [
  "Listen einseitig wie in der Community (keine Paginierung); Einträge = a[href^=/manga/] mit h3 (Community verlangt h3 implizit).",
  "Kapiteldatum 'd/M/yyyy' aus span.tabular – Community parst es mit LocalDateTime und erhält dadurch stets 0; hier als Datum übernommen.",
  "Kapitelname = erstes span in div[dir=rtl] (Annahme: Engine nimmt den ersten Treffer wie selectFirst)."
 ]
}
