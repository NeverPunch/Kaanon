 "quelle": {
  "modul": "src/pt/universohentai",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "gattsu"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Accept-Language": "pt-BR,pt;q=0.9,en-US;q=0.8,en;q=0.7,es;q=0.6,gl;q=0.5"
  },
  "rate_limit": {
   "permits": 1,
   "period_ms": 2000
  },
  "popular": {
   "request": "{base}/page/{page}",
   "request_by_page": {
    "1": "{base}/"
   },
   "items": "div.meio div.videos div.video a[href^='https://universohentai.com']:not(:has(span.selo-hd))",
   "has_next": {
    "exists": "ul.paginacao li.next > a"
   },
   "fields": {
    "url": "@href",
    "title": "span.video-titulo",
    "cover": "img.wp-post-image@src"
   }
  },
  "search": {
   "request": "{base}/page/{page}/?s={query}&post_type=post",
   "items": "div.meio div.videos div.video a[href^='https://universohentai.com']:not(:has(span.selo-hd))",
   "has_next": {
    "exists": "ul.paginacao li.next > a"
   },
   "fields": {
    "url": "@href",
    "title": "span.video-titulo",
    "cover": "img.wp-post-image@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "div.meio div.post[itemscope]:has(a[title=Abrir galeria]) h1.post-titulo",
    "cover": {
     "path": "div.meio div.post[itemscope]:has(a[title=Abrir galeria]) div.paginaPostThumb > img.wp-post-image@src",
     "replace": [
      [
       "-\\d+x\\d+\\.",
       "."
      ]
     ]
    },
    "author": "div.meio div.post[itemscope]:has(a[title=Abrir galeria]) ul.paginaPostItens li:contains(Artista) a",
    "genres": {
     "path": "div.meio div.post[itemscope]:has(a[title=Abrir galeria]) ul.paginaPostItens li:contains(Categorias) a",
     "all": true,
     "join": ", "
    },
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "let": {
    "date": "meta[property=article:published_time]@content"
   },
   "items": "div.meio div.post[itemscope]:has(a[title=Abrir galeria])",
   "fields": {
    "url": "a[title=Abrir galeria]@href",
    "name": {
     "const": "Capítulo único"
    },
    "scanlator": "ul.paginaPostItens li:contains(Tradutor) a",
    "date": {
     "const": "{l.date}"
    }
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div.meio div.galeria div.galeria-foto a img",
   "image": {
    "path": [
     "@data-src",
     "@src"
    ],
    "replace": [
     [
      "-\\d+x\\d+\\.",
      "."
     ]
    ]
   },
   "referer": "chapter"
  }
 },
 "hinweise": [
