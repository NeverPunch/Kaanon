 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Referer": "{base}/"
  },
  "rate_limit": {
   "permits": 14,
   "period_ms": 60000
  },
  "popular": {
   "request": "{base}/danh-sach?sort=-views&page={page}",
   "items": "a.group:has(h1)",
   "has_next": {
    "min": 1
   },
   "fields": {
    "url": "@href",
    "title": "h1",
    "cover": "img@img"
   }
  },
  "latest": {
   "request": "{base}/danh-sach?page={page}",
   "items": "a.group:has(h1)",
   "has_next": {
    "min": 1
   },
   "fields": {
    "url": "@href",
    "title": "h1",
    "cover": "img@img"
   }
  },
  "search": {
   "request": "{base}/tim-kiem?keyword={query}&page={page}",
   "items": "a.group:has(h1)",
   "has_next": {
    "min": 1
   },
   "fields": {
    "url": "@href",
    "title": "h1",
    "cover": "img@img"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "div.title p",
    "cover": "img.rounded.shadow-md.w-full@img",
    "author": "a[href*='/tac-gia/']",
    "genres": {
     "path": "a[href*='/the-loai/']",
     "all": true,
     "join": ", "
    },
    "status": {
     "path": "body",
     "regex": "(Đã hoàn thành|Đang tiến hành)",
     "group": 1
    },
    "description": "div.mt-4@ownText"
   },
   "status_map": {
    "đã hoàn thành": 2,
    "đang tiến hành": 1
   }
  },
  "chapters": {
   "request": "details",
   "items": [
    "div.chapter-list :has(> a)",
    "div.chapter-list a"
   ],
   "fields": {
    "url": [
     "a@href",
     "@href"
    ],
    "name": [
     "a h1",
     "a@title",
     "h1",
     "@title",
     "a",
     ""
    ],
    "date": "span.timeago"
   },
   "date_format": "relative",
   "date_locale": "vi"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "img.lazy",
   "image": "@img"
  }
 },
 "hinweise": [
