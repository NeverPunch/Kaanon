{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Maid - Manga",
  "sprache": "id",
  "base_url": "https://www.maid.my.id",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.id.kaanon.maidmanga",
  "quellen": [
   {
    "name": "Maid - Manga",
    "sprache": "id",
    "quell_id": 5716614438725518956,
    "home": "https://www.maid.my.id"
   }
  ]
 },
 "quelle": {
  "modul": "src/id/maidmanga",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.16",
  "theme": "zmanga"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/advanced-search/page/{page}/?order=popular",
   "request_by_page": {
    "1": "{base}/advanced-search/?order=popular"
   },
   "items": "div.flexbox2-item",
   "has_next": {
    "exists": "div.pagination .next"
   },
   "fields": {
    "url": "div.flexbox2-content a@href",
    "title": "div.flexbox2-title > span",
    "cover": "img@src"
   }
  },
  "latest": {
   "request": "{base}/advanced-search/page/{page}/?order=update",
   "request_by_page": {
    "1": "{base}/advanced-search/?order=update"
   },
   "items": "div.flexbox2-item",
   "has_next": {
    "exists": "div.pagination .next"
   },
   "fields": {
    "url": "div.flexbox2-content a@href",
    "title": "div.flexbox2-title > span",
    "cover": "img@src"
   }
  },
  "search": {
   "request": "{base}/advanced-search/page/{page}/?title={query}",
   "request_by_page": {
    "1": "{base}/advanced-search/?title={query}"
   },
   "items": "div.flexbox2-item",
   "has_next": {
    "exists": "div.pagination .next"
   },
   "fields": {
    "url": "div.flexbox2-content a@href",
    "title": "div.flexbox2-title > span",
    "cover": "img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "let": {
    "desc": "div.series-synops",
    "alt": ".series-title span@ownText"
   },
   "fields": {
    "cover": [
     "div.series-thumb img@data-lazy-src",
     "div.series-thumb img@src"
    ],
    "author": {
     "path": ".series-infolist li:contains(Author) span",
     "all": true,
     "join": " "
    },
    "artist": {
     "path": ".series-infolist li:contains(Artist) span",
     "all": true,
     "join": " "
    },
    "status": {
     "path": ".series-infoz .status@ownText",
     "regex": "(?i)(ongoing|completed)"
    },
    "description": {
     "const": "{l.desc}\n\n[[Alternative Name: {l.alt}]]"
    },
    "genres": {
     "path": [
      "div.series-genres a",
      "div.block span.type@ownText"
     ],
     "union": true,
     "replace": [
      [
       "^-$",
       ""
      ]
     ]
    }
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "ul.series-chapterlist div.flexch-infoz a",
   "fields": {
    "url": "@href",
    "name": "span@ownText",
    "date": "span.date"
   },
   "date_format": "MMM d, yyyy",
   "date_locale": "id"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div.reader-area img:not(noscript img)",
   "image": [
    {
     "path": "@data-lazy-src",
     "replace": [
      [
       "\\\\",
       ""
      ]
     ]
    },
    {
     "path": "@src",
     "replace": [
      [
       "\\\\",
       ""
      ]
     ]
    }
   ]
  }
 },
 "hinweise": [
  "Theme ZManga: Listen über /advanced-search/ (Seite 1 ohne /page/1/ wie in der Community).",
  "Titel kommt aus der Liste (Community setzt in den Details keinen Titel).",
  "Filter (Autor, Jahr, Status, Typ, Genres, Projektliste) nicht übernommen."
 ]
}
