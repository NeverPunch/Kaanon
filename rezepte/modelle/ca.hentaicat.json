{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Hentai.cat",
  "sprache": "ca",
  "base_url": "https://manga.hentai.cat",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.ca.kaanon.hentaicat",
  "quellen": [
   {
    "name": "Hentai.cat",
    "sprache": "ca",
    "quell_id": 7575385310756416449,
    "home": "https://manga.hentai.cat"
   }
  ]
 },
 "quelle": {
  "modul": "src/ca/fansubscathentai",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": "fansubscat"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "User-Agent": "Tachiyomi/1.6"
  },
  "popular": {
   "request": "https://api.hentai.cat/manga/popular/{page}",
   "format": "json",
   "items": "result",
   "page_size": 20,
   "has_next": {
    "full": true
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/{value}"
    },
    "title": "name",
    "cover": "thumbnail_url"
   }
  },
  "latest": {
   "request": "https://api.hentai.cat/manga/recent/{page}",
   "format": "json",
   "items": "result",
   "page_size": 20,
   "has_next": {
    "full": true
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/{value}"
    },
    "title": "name",
    "cover": "thumbnail_url"
   }
  },
  "search": {
   "request": "https://api.hentai.cat/manga/search/{page}?type=all&query={query}",
   "format": "json",
   "items": "result",
   "page_size": 20,
   "has_next": {
    "full": true
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/{value}"
    },
    "title": "name",
    "cover": "thumbnail_url"
   }
  },
  "details": {
   "request": "https://api.hentai.cat/manga/details/{u.slug}",
   "format": "json",
   "url_vars": {
    "slug": "/([^/?#]+)/?$"
   },
   "fields": {
    "title": "result.name",
    "cover": "result.thumbnail_url",
    "description": "result.synopsis",
    "author": "result.author",
    "genres": "result.genres",
    "status": "result.status"
   },
   "status_map": {
    "ongoing": 1,
    "finished": 2
   }
  },
  "chapters": {
   "request": "https://api.hentai.cat/manga/chapters/{u.slug}",
   "format": "json",
   "url_vars": {
    "slug": "/([^/?#]+)/?$"
   },
   "items": "result",
   "fields": {
    "url": {
     "path": "id",
     "template": "/{value}"
    },
    "name": "title",
    "number": "number",
    "scanlator": "fansub",
    "date": "created"
   },
   "date_format": "epoch_ms"
  },
  "pages": {
   "request": "https://api.hentai.cat/manga/pages/{u.cid}",
   "format": "json",
   "url_vars": {
    "cid": "/([^/?#]+)/?$"
   },
   "items": "result",
   "image": "url"
  }
 },
 "hinweise": [
  "Theme FansubsCat: reine JSON-API unter api.hentai.cat (baseUrl mit manga. → api.). Antworten immer {result: …}.",
  "Community setzt User-Agent 'Tachiyomi/<App-Version>'; Rezept nutzt festen Wert 'Tachiyomi/1.6' – auf dem PC prüfen, ob die API ihn verlangt.",
  "Manga-URL = /<slug>, Kapitel-URL = /<id>; Community nimmt für Seiten den Teil nach dem letzten '/' der Kapitel-ID (Kapitel-ID kann selbst '/' enthalten) – das Rezept tut dasselbe per url_vars.",
  "Status in der Community per contains('ongoing'/'finished'); status_map vergleicht vermutlich exakt – falls die API längere Texte liefert, nachschärfen.",
  "created als Long direkt in date_upload übernommen → epoch_ms angenommen.",
  "Suche ohne Filter: type=all wie in der Community; Filter (Status, Genres, Themen) nicht abgebildet."
 ]
}
