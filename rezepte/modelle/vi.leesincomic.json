{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "LeesinComic",
  "sprache": "vi",
  "base_url": "https://leesincomic.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.vi.kaanon.leesincomic",
  "quellen": [
   {
    "name": "LeesinComic",
    "sprache": "vi",
    "quell_id": 6354355596871688542,
    "home": "https://leesincomic.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/vi/leesincomic",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.3",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "X-API-KEY": "Leesin_Secret_MySQL_Key_2026"
  },
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "popular": {
   "request": {
    "url": "{base}/api.php?action=get_comics",
    "headers": {
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "items": "comics",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/truyen/{value}"
    },
    "title": "title",
    "cover": {
     "path": "cover_image",
     "replace": [
      [
       "://tachserver\\.online/",
       "://tachserver.site/"
      ]
     ]
    }
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": {
    "url": "{base}/api.php?action=get_comics",
    "headers": {
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "items": "comics",
   "fields": {
    "url": {
     "path": "slug",
     "template": "/truyen/{value}"
    },
    "title": "title",
    "cover": {
     "path": "cover_image",
     "replace": [
      [
       "://tachserver\\.online/",
       "://tachserver.site/"
      ]
     ]
    }
   },
   "has_next": {
    "const": false
   },
   "client_filter": true
  },
  "details": {
   "request": "{base}/api.php?action=get_comic&id={u.slug}",
   "format": "json",
   "url_vars": {
    "slug": "/truyen/([^/?#]+)"
   },
   "let": {
    "alt": {
     "path": "comic.other_names",
     "regex": "^\\[(.+)\\]$",
     "group": 1,
     "replace": [
      [
       "\"\\s*,\\s*\"",
       " / "
      ],
      [
       "\"",
       ""
      ]
     ]
    },
    "sum": "comic.summary"
   },
   "fields": {
    "title": "comic.title",
    "cover": {
     "path": "comic.cover_image",
     "replace": [
      [
       "://tachserver\\.online/",
       "://tachserver.site/"
      ]
     ]
    },
    "author": {
     "path": "comic.authors.*",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": "comic.genres.*",
     "all": true,
     "join": ", "
    },
    "description": {
     "const": "[[Tên khác: {l.alt}\n\n]][[{l.sum}]]"
    },
    "status": "comic.status"
   },
   "status_map": {
    "đang tiến hành": 1,
    "hoàn thành": 2,
    "đã hoàn thành": 2
   }
  },
  "chapters": {
   "request": "details",
   "format": "json",
   "items": "comic.chapters",
   "fields": {
    "url": {
     "path": [
      "chapter_number",
      "chapterNumber"
     ],
     "replace": [
      [
       "\\.0+$",
       ""
      ]
     ],
     "template": "/truyen/{u.slug}/chap-{value}"
    },
    "name": [
     "title",
     {
      "path": [
       "chapter_number",
       "chapterNumber"
      ],
      "replace": [
       [
        "\\.0+$",
        ""
       ]
      ],
      "template": "Chương {value}"
     }
    ],
    "number": [
     "chapter_number",
     "chapterNumber"
    ],
    "date": [
     "created_at",
     "createdAt",
     "updated_at",
     "updatedAt"
    ]
   },
   "date_format": [
    "iso",
    "yyyy-MM-dd HH:mm:ss",
    "dd/MM/yyyy"
   ]
  },
  "pages": {
   "request": "{base}/api.php?action=get_chapter&comicSlug={u.slug}&chapterNumber={u.num}",
   "format": "json",
   "url_vars": {
    "slug": "/truyen/([^/?#]+)/",
    "num": "/chap-([^/?#]+)"
   },
   "items": "chapter.images",
   "image": {
    "path": "",
    "replace": [
     [
      "://tachserver\\.online/",
      "://tachserver.site/"
     ]
    ]
   }
  }
 },
 "hinweise": [
  "API api.php mit festem Header X-API-KEY (Wert steht wörtlich im Community-Code, liefert die Website-Frontend selbst mit).",
  "Listen: Die API liefert nur den ganzen Katalog auf einmal (get_comics, ca. 6 MB, Server teils >1 min – Community setzt Lese-Timeout 2 min). Community sortiert selbst (Beliebt nach views, Neueste nach updated_at); Sortieren ist in der Rezeptsprache nicht möglich → Beliebt = Katalogreihenfolge der API, keine Neueste-Liste. Suche = derselbe Katalog mit client_filter (Community sucht auch in slug/other_names).",
  "Kapitel-URL /truyen/<slug>/chap-<Nr> wie Community; Nr. ohne '.0'. Reihenfolge: Community sortiert nach Nummer absteigend, hier API-Reihenfolge – prüfen.",
  "Bild-Host tachserver.online wird wie in der Community durch tachserver.site ersetzt.",
  "Datum created_at/updated_at: ISO, 'yyyy-MM-dd HH:mm:ss' oder dd/MM/yyyy (Community-Zeitzone Asia/Ho_Chi_Minh)."
 ]
}
