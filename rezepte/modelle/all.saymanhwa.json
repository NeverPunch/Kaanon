{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "SayManhwa",
  "sprache": "en",
  "base_url": "https://saymanhwa.net",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.all.kaanon.saymanhwa",
  "quellen": [
   {
    "name": "SayManhwa",
    "sprache": "en",
    "quell_id": 160957764321519511,
    "home": "https://saymanhwa.net"
   }
  ]
 },
 "quelle": {
  "modul": "src/all/saymanhwa",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.4",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 3,
   "period_ms": 1000
  },
  "popular": {
   "request": "{base}/en/popular?page={page}",
   "request_by_page": {
    "1": "{base}/en/popular"
   },
   "items": "article.series-card",
   "has_next": {
    "exists": "nav.pagination span + a"
   },
   "fields": {
    "url": ".series-card-body h2 a@href",
    "title": ".series-card-body h2 a",
    "cover": [
     ".series-card-cover img@src",
     "a img@src"
    ]
   }
  },
  "latest": {
   "request": "{base}/en/latest?page={page}",
   "request_by_page": {
    "1": "{base}/en/latest"
   },
   "items": "article.series-card",
   "has_next": {
    "exists": "nav.pagination span + a"
   },
   "fields": {
    "url": ".series-card-body h2 a@href",
    "title": ".series-card-body h2 a",
    "cover": [
     ".series-card-cover img@src",
     "a img@src"
    ]
   }
  },
  "search": {
   "request": "{base}/en/series?q={query}&page={page}",
   "request_by_page": {
    "1": "{base}/en/series?q={query}"
   },
   "items": "article.series-card",
   "has_next": {
    "exists": "nav.pagination span + a"
   },
   "fields": {
    "url": ".series-card-body h2 a@href",
    "title": ".series-card-body h2 a",
    "cover": [
     ".series-card-cover img@src",
     "a img@src"
    ]
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1@ownText",
    "cover": ".series-v72-cover img@src",
    "author": {
     "path": ".series-v72-meta-row strong.series-creator-links:eq(0) a",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": ".series-v72-meta-row strong.series-creator-links:eq(1) a",
     "all": true,
     "join": ", "
    },
    "status": {
     "path": ".series-v72-meta-pair > div:first-child strong@ownText",
     "regex": "(?i)(ongoing|completed)"
    },
    "genres": {
     "path": [
      ".series-v72-meta-pair > div:nth-child(2) strong@ownText",
      "a[href*='/genres/']"
     ],
     "union": true
    },
    "description": ".series-seo-context p"
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": ".series-v72-chapter-list > a.series-v72-chapter-row",
   "skip": ".chapter-mini-lock@class",
   "fields": {
    "url": "@href",
    "name": ".series-chapter-number-text@ownText",
    "date": "time@datetime"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".reader-pages img",
   "image": "@src"
  }
 },
 "hinweise": [
  "Community bedient 13 Sprachen über das Pfadpräfix /<sprache>/ (gleiche Website); Modell auf die englische Quelle (/en/) gekürzt.",
  "VIP-Kapitel (.chapter-mini-lock) werden übersprungen (Community zeigt sie mit Schloss an).",
  "Autor/Zeichner = 1./2. strong.series-creator-links (:eq – Jsoup-Selektor; auf dem PC prüfen).",
  "Status nur mit den englischen Wörtern ongoing/completed (wie Community für en).",
  "Genre-Filter und ähnliche Titel nicht übernommen."
 ]
}
