{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Eris Scans",
  "sprache": "en",
  "base_url": "https://erisscans.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.erisscans",
  "quellen": [
   {
    "name": "Eris Scans",
    "sprache": "en",
    "quell_id": 8358420357808595754,
    "home": "https://erisscans.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/erisscans",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.24",
  "theme": "keyoapp"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "rate_limit": {
   "permits": 3,
   "period_ms": 2000
  },
  "popular": {
   "request": "{base}/",
   "items": [
    ".series-splide .splide__slide:not(.splide__slide--clone)",
    "section.splide.series-splide a.splide__slide",
    "div:contains(Popular) + div .group.overflow-hidden.grid",
    "div:contains(Trending) + div .group.overflow-hidden.grid",
    "div:contains(Trending) + div .group"
   ],
   "skip": {
    "any": [
     {
      "path": "[data-type~=(?i)^novel$]@data-type"
     },
     {
      "path": "span:matchesOwn((?i)^novel$)"
     },
     {
      "path": [
       "a[href]@title"
      ],
      "regex": "(?i)(\\[novel\\])"
     }
    ]
   },
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "a[href]@href",
    "title": [
     "a[href]@title",
     "@title",
     "a[href]@alt",
     "@alt"
    ],
    "cover": {
     "path": "[style*=background-image]@style",
     "regex": "url\\(['\"]?([^('\")]+)",
     "replace": [
      [
       "([?&])w=\\d+(?=&|$)",
       "$1w=480"
      ]
     ]
    }
   }
  },
  "latest": {
   "request": "{base}/latest/",
   "items": "div.grid > div.group",
   "skip": {
    "any": [
     {
      "path": "[data-type~=(?i)^novel$]@data-type"
     },
     {
      "path": "span:matchesOwn((?i)^novel$)"
     },
     {
      "path": [
       "a[href]@title"
      ],
      "regex": "(?i)(\\[novel\\])"
     }
    ]
   },
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "a[href]@href",
    "title": [
     "a[href]@title",
     "@title",
     "a[href]@alt",
     "@alt"
    ],
    "cover": {
     "path": "[style*=background-image]@style",
     "regex": "url\\(['\"]?([^('\")]+)",
     "replace": [
      [
       "([?&])w=\\d+(?=&|$)",
       "$1w=480"
      ]
     ]
    }
   }
  },
  "search": {
   "request": "{base}/series?q={query}",
   "items": "#searched_series_page > button",
   "skip": {
    "any": [
     {
      "path": "[data-type~=(?i)^novel$]@data-type"
     },
     {
      "path": "span:matchesOwn((?i)^novel$)"
     },
     {
      "path": [
       "a[href]@title"
      ],
      "regex": "(?i)(\\[novel\\])"
     }
    ]
   },
   "client_filter": true,
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "a[href]@href",
    "title": [
     "a[href]@title",
     "@title",
     "a[href]@alt",
     "@alt"
    ],
    "cover": {
     "path": "[style*=background-image]@style",
     "regex": "url\\(['\"]?([^('\")]+)",
     "replace": [
      [
       "([?&])w=\\d+(?=&|$)",
       "$1w=480"
      ]
     ]
    }
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "div.grid > h1",
    "cover": {
     "path": [
      "div[class*=photoURL]@style",
      "div[style*=photoURL]@style"
     ],
     "regex": "url\\(['\"]?([^('\")]+)",
     "replace": [
      [
       "([?&])w=\\d+(?=&|$)",
       "$1w=480"
      ]
     ]
    },
    "description": "#expand_content p",
    "genres": {
     "path": [
      "div[alt='Series Type']",
      "div:has(>h1) a[href*='genre=']"
     ],
     "union": true,
     "all": true,
     "join": ", ",
     "replace": [
      [
       ",\\s*,",
       ","
      ],
      [
       ",\\s*$",
       ""
      ]
     ]
    },
    "author": [
     "div[alt=Author]"
    ],
    "artist": [
     "div[alt=Artist]"
    ],
    "status": [
     "div[alt=Status]"
    ]
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "dropped": 5,
    "paused": 6,
    "hiatus": 6
   }
  },
  "chapters": {
   "request": "details",
   "items": "#chapters > :is(a, div)",
   "skip": {
    "any": [
     "img[alt~=Coin]@alt",
     ".text-sm span:matches(Upcoming)"
    ]
   },
   "fields": {
    "url": "a[href]@href",
    "name": ".text-sm",
    "date": [
     "a[href]@d",
     ".text-xs"
    ]
   },
   "date_format": [
    "MMM d, yyyy",
    "relative"
   ],
   "date_locale": "en"
  },
  "pages": {
   "request": "{abs_url}",
   "let": {
    "cdn": {
     "path": "script@html",
     "all": true,
     "join": "",
     "regex": "realUrl\\s*=\\s*`[^`]+//([^/]+)",
     "replace": [
      [
       "\\$\\{[^}]*\\}",
       ""
      ]
     ]
    }
   },
   "items": "#pages > img",
   "image": [
    {
     "path": "@uid",
     "template": "https://{l.cdn}/uploads/{value}"
    },
    "@img"
   ]
  }
 },
 "hinweise": [
  "Keyoapp-Theme; Modell aus der Keyoapp-Vorlage en.grimscans übernommen und an die Selektoren dieses Moduls angepasst.",
  "Stufe 3 geprüft: QuickJS dient im Code nur dem Genre-Filter (initializeDropdownMenu), nicht Listen/Kapiteln/Seiten. Filter nicht nachgebaut, Suche nur Text (client_filter wie Vorlage).",
  "Kostenpflichtige (img[alt~=Coin]) und angekündigte (Upcoming) Kapitel werden ausgelassen (Community-Standard). Genres = Typ + Genre-Links (union).",
  "Alternative Titel (Community hängt sie an die Beschreibung) nicht übernommen.",
  "Rate-Limit 3/2 s aus der Vorlage (Community-Keyoapp setzt keins)."
 ]
}
