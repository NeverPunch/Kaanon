{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "LeerMangaEsp",
  "sprache": "es",
  "base_url": "https://mangalect.org",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.es.kaanon.leermangaesp",
  "quellen": [
   {
    "name": "LeerMangaEsp",
    "sprache": "es",
    "quell_id": 8196066207928937350,
    "home": "https://mangalect.org"
   }
  ]
 },
 "quelle": {
  "modul": "src/es/leermangaesp",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/",
   "format": "script_json",
   "script_regex": "(?s)<script[^>]*id=[\"']ssr-trends-data[\"'][^>]*>(.*?)</script>",
   "items": "$",
   "skip": {
    "path": "titulo",
    "regex": "^\\s*$"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/info/{value}/"
    },
    "title": "titulo",
    "cover": {
     "path": "portada",
     "replace": [
      [
       "^/",
       ""
      ]
     ],
     "template": "https://images.mangalect.org/file/leermangaesp/{value}"
    }
   },
   "has_next": {
    "const": false
   }
  },
  "latest": {
   "request": "{base}/api/latest_chapters_with_dates",
   "format": "json",
   "items": "$",
   "skip": {
    "path": "titulo",
    "regex": "^\\s*$"
   },
   "sort": {
    "path": "fecha_publicacion",
    "order": "desc"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/info/{value}/"
    },
    "title": "titulo",
    "cover": {
     "path": "portada",
     "replace": [
      [
       "^/",
       ""
      ]
     ],
     "template": "https://images.mangalect.org/file/leermangaesp/{value}"
    }
   },
   "has_next": {
    "const": false
   }
  },
  "search": {
   "request": "{base}/api/buscar_mangas?page={page}&page_size=20&query={query}",
   "format": "json",
   "items": "resultados",
   "skip": {
    "path": "titulo",
    "regex": "^\\s*$"
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/info/{value}/"
    },
    "title": "titulo",
    "cover": {
     "path": "portada",
     "replace": [
      [
       "^/",
       ""
      ]
     ],
     "template": "https://images.mangalect.org/file/leermangaesp/{value}"
    }
   },
   "has_next": {
    "lt": [
     "page",
     "total_pages"
    ]
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": [
     ".manga-title",
     "h1"
    ],
    "cover": "img.manga-cover@src",
    "description": "#synopsis-text",
    "genres": {
     "path": ".info-generos .genero-item",
     "all": true,
     "join": ", "
    },
    "status": {
     "path": "#info-block .info-value",
     "regex": "(?i)(en curso|finalizado|completo)",
     "group": 1
    }
   },
   "status_map": {
    "en curso": 1,
    "En curso": 1,
    "EN CURSO": 1,
    "finalizado": 2,
    "Finalizado": 2,
    "completo": 2,
    "Completo": 2
   }
  },
  "chapters": {
   "request": "{l.more}",
   "request_by_page": {
    "1": "details"
   },
   "let": {
    "more": "#more-link@href"
   },
   "paging": {
    "has_next": {
     "exists": "#more-link[href]"
    },
    "max_pages": 50
   },
   "items": "#chapter-list a.chapter-link",
   "skip": {
    "any": [
     {
      "path": "@id",
      "equals": "continue-link"
     },
     {
      "path": "@data-chapter",
      "regex": "^\\s*$"
     }
    ]
   },
   "fields": {
    "url": "@href",
    "name": [
     ".chapter-title",
     ""
    ],
    "date": ".chapter-date"
   },
   "date_format": "MMMM d, yyyy",
   "date_locale": "en"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "#cascade-view img.manga-image",
   "image": "@src"
  }
 },
 "hinweise": [
  "Beliebt = JSON aus script#ssr-trends-data der Startseite (eine Seite); Neueste = /api/latest_chapters_with_dates (lokal nach fecha_publicacion absteigend sortiert wie Community); Suche = /api/buscar_mangas.",
  "Manga-URL /info/<slug>/ wie Community. Cover = images.<host>/file/leermangaesp/<portada> (Host fest images.mangalect.org).",
  "Kapitel: Community folgt dem Link #more-link, bis keiner mehr da ist. Nachgebildet wie vi.sayhentai mit request_by_page {'1': 'details'} + let 'more' – Annahme: let wird je Seite neu ausgewertet; auf dem PC prüfen (sonst Wiederholungen).",
  "Status: Community sucht Teilwörter ('en curso', 'finalizado', 'completo'); hier per Regex herausgezogen.",
  "Typ-/Genre-Filter nicht übernommen."
 ]
}
