{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "TruyenQQ",
  "sprache": "vi",
  "base_url": "https://truyenqqko.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.vi.kaanon.truyenqq",
  "quellen": [
   {
    "name": "TruyenQQ",
    "sprache": "vi",
    "quell_id": 2553532324170433933,
    "home": "https://truyenqqko.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/vi/truyenqq",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.26",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "Referer": "{base}/"
  },
  "rate_limit": {
   "permits": 1,
   "period_ms": 2000
  },
  "popular": {
   "request": "{base}/truyen-yeu-thich/trang-{page}",
   "request_by_page": {
    "1": "{base}/truyen-yeu-thich"
   },
   "items": "ul.grid > li",
   "has_next": {
    "exists": ".page_redirect > a:nth-last-child(2) > p:not(.active)"
   },
   "fields": {
    "url": ".book_info .qtip a@href",
    "title": ".book_info .qtip a",
    "cover": ".book_avatar img@src"
   }
  },
  "latest": {
   "request": "{base}/truyen-moi-cap-nhat/trang-{page}",
   "request_by_page": {
    "1": "{base}/truyen-moi-cap-nhat"
   },
   "items": "ul.grid > li",
   "has_next": {
    "exists": ".page_redirect > a:nth-last-child(2) > p:not(.active)"
   },
   "fields": {
    "url": ".book_info .qtip a@href",
    "title": ".book_info .qtip a",
    "cover": ".book_avatar img@src"
   }
  },
  "search": {
   "request": "{base}/tim-kiem/trang-{page}?q={query}",
   "request_by_page": {
    "1": "{base}/tim-kiem?q={query}"
   },
   "items": "ul.grid > li",
   "has_next": {
    "exists": ".page_redirect > a:nth-last-child(2) > p:not(.active)"
   },
   "fields": {
    "url": ".book_info .qtip a@href",
    "title": ".book_info .qtip a",
    "cover": ".book_avatar img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1",
    "author": {
     "path": ".list-info .org",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": ".list01 li",
     "all": true,
     "join": ", "
    },
    "description": {
     "path": ".story-detail-info",
     "all": true,
     "join": "\n\n"
    },
    "cover": "img[itemprop=image]@src",
    "status": ".list-info .status > p:last-child"
   },
   "status_map": {
    "đang tiến hành": 1,
    "đang cập nhật": 1,
    "đang ra": 1,
    "hoàn thành": 2,
    "đã hoàn thành": 2,
    "tạm ngưng": 6,
    "tạm hoãn": 6
   }
  },
  "chapters": {
   "request": "details",
   "items": "div.works-chapter-list div.works-chapter-item",
   "fields": {
    "url": "a@href",
    "name": "a",
    "date": ".time-chap"
   },
   "date_format": "dd/MM/yyyy"
  },
  "pages": {
   "request": "{abs_url}",
   "items": ".page-chapter img:not([src*='stress.gif'])",
   "image": "@src"
  }
 },
 "hinweise": [
  "Beliebt /truyen-yeu-thich, Neueste /truyen-moi-cap-nhat, Suche /tim-kiem?q=… (Seite n als /trang-n, Seite 1 ohne). Erweiterte Filter nicht übernommen.",
  "Rate-Limit 1 Anfrage/2 s wie Community.",
  "Status: Community prüft 'enthält' ohne Groß-/Kleinschreibung; status_map mit den Texten klein geschrieben.",
  "Seiten: Community lädt die Kapitelseite ohne Cache (FORCE_NETWORK); Platzhalter stress.gif ausgeschlossen."
 ]
}
