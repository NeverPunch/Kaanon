 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "X-Requested-With": "XMLHttpRequest"
  },
  "popular": {
   "request": "{base}/api/v1/title/search-advanced?page={page}&limit=24&tag_mode=AND&adult_mode=all&sort_by=views&sort_order=desc",
   "format": "json",
   "items": "data",
   "page_size": 24,
   "has_next": {
    "lt": [
     "pagination.page",
     "pagination.total_pages"
    ]
   },
   "fields": {
    "url": {
     "path": "id",
     "template": "/title-detail/{value}"
    },
    "title": "name",
    "cover": [
     {
      "path": "image.cover.path",
      "regex": "^\\s*(https?://\\S+)"
     },
     {
      "path": "image.cover.path",
      "replace": [
       [
        "\\\\",
        "/"
       ],
       [
        "^\\s+|\\s+$",
        ""
       ]
      ],
      "template": "https://bulbasaur.poke-black-and-white.net/covers/{value}"
     },
     "image.file",
     "image.cdn_mangadex",
     "image.cdn_mangaupdate",
     "image.cdn_mangaupdates"
    ]
   }
  },
  "latest": {
   "request": "{base}/api/v1/title/search-advanced?page={page}&limit=24&tag_mode=AND&adult_mode=all&sort_by=lastupdate&sort_order=desc",
   "format": "json",
   "items": "data",
   "page_size": 24,
   "has_next": {
    "lt": [
