{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Hentai Comics",
  "sprache": "pt",
  "base_url": "https://hentaicomics.biz",
  "nsfw": true,
  "paket": "eu.kanade.tachiyomi.extension.pt.kaanon.hentaicomics",
  "quellen": [
   {
    "name": "Hentai Comics",
    "sprache": "pt",
    "quell_id": 5674532035279095345,
    "home": "https://hentaicomics.biz"
   }
  ]
 },
 "quelle": {
  "modul": "src/pt/hentaicomics",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/top-hentais/",
   "items": "article.w_item_b:has(a[href])",
   "fields": {
    "url": "a[href]@href",
    "title": [
     "a[href]@title",
     "h2"
    ],
    "cover": ".image img@src"
   },
   "has_next": {
    "const": false
   }
  },
  "latest": {
   "request": "{base}/page/{page}/",
   "request_by_page": {
    "1": "{base}/"
   },
   "items": "div.post:has(a[href])",
   "fields": {
    "url": "a[href]@href",
    "title": [
     "a[href]@title",
     "h2.link"
    ],
    "cover": "img@src"
   },
   "has_next": {
    "exists": "a[href*='/page/']"
   }
  },
  "search": {
   "request": "{base}/?s={query}",
   "items": "div.post:has(a[href])",
   "fields": {
    "url": "a[href]@href",
    "title": [
     "a[href]@title",
     "h2.link"
    ],
    "cover": "img@src"
   },
   "has_next": {
    "const": false
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "h1.post-title",
    "cover": "div.single-post img[src*=/wp-content/uploads/]@src"
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "const": "Oneshot"
    }
   }
  },
  "pages": {
   "request": "{abs_url}",
   "items": "div.single-post img[src*=/wp-content/uploads/]",
   "image": "@src"
  }
 },
 "hinweise": [
  "Neueste: Seite 1 = Startseite, danach /page/N/ (request_by_page wie tr.korelimanga).",
  "Nächste Seite: Community prüft einen Link auf /page/<N+1>/; Platzhalter im Selektor nicht belegt → grob 'irgendein /page/-Link' (am Ende evtl. eine leere Zusatzseite).",
  "Ein Kapitel 'Oneshot' = die Eintragsseite selbst; Bilder div.single-post img mit /wp-content/uploads/ in src. Beliebt (Top-Liste) und Suche ohne Blättern wie in der Community."
 ]
}
