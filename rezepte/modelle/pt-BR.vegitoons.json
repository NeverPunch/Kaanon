 "modell": {
  "schema": "kaanon-site-model/2",
  "headers": {
   "scan-id": "1"
  },
  "rate_limit": {
   "permits": 2,
   "period_ms": 1000
  },
  "popular": {
   "request": "https://api.vegitoons.black/obras/ranking?tipo=visualizacoes_geral&limite=26&pagina={page}&gen_id=1",
   "format": "json",
   "items": "obras",
   "page_size": 26,
   "has_next": {
    "full": true
   },
   "fields": {
    "url": {
     "path": "obr_id",
     "template": "/obra/{value}"
    },
    "title": "obr_nome",
    "cover": [
     {
      "path": "obr_imagem",
      "regex": "^(https?://.+)$",
      "group": 1
     },
     {
      "path": "obr_imagem",
      "regex": "^((?:manga_|WP-manga|uploads/|wp-content/).*)$",
      "group": 1,
      "replace": [
       [
        "^manga_",
        "wp-content/uploads/WP-manga/data/manga_"
       ],
       [
        "^WP-manga",
        "wp-content/uploads/WP-manga"
       ],
       [
        "^uploads/",
        "wp-content/uploads/"
       ],
       [
        "^/+",
        ""
       ]
      ],
      "template": "https://api.vegitoons.black/cdn/{value}"
     },
     {
      "path": "obr_imagem",
      "replace": [
       [
        "^/+",
        ""
       ]
      ],
      "template": "https://api.vegitoons.black/cdn/scans/1/obras/{f.obr_id}/{value}?width=300"
     }
    ]
   }
  },
