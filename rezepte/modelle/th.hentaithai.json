    ],
    "cover": ".doujin-cover img@src"
   }
  },
  "latest": {
   "request": "{base}/",
   "items": "a.doujin-item",
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "@href",
    "title": [
     "@title",
     ".doujin-cover img@alt"
    ],
    "cover": ".doujin-cover img@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "title",
    "cover": "section#image-container figure.manga-page img[src*=/thai/]@src",
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "const": "Oneshot"
    }
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "section#image-container figure.manga-page img",
   "image": "@src",
   "include": "/thai/"
  }
 },
