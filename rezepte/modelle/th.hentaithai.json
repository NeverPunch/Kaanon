  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/top-doujin/",
   "items": "a.doujin-item",
   "has_next": {
    "const": false
   },
   "fields": {
    "url": "@href",
    "title": [
     "@title",
