{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Schale Scans",
  "sprache": "en",
  "base_url": "https://www.schalescans.com",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.en.kaanon.schalescans",
  "quellen": [
   {
    "name": "Schale Scans",
    "sprache": "en",
    "quell_id": 135437514280789093,
    "home": "https://www.schalescans.com"
   }
  ]
 },
 "quelle": {
  "modul": "src/en/schalescans",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.1",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": {
    "url": "https://xqjjktixlttbqbsdpaxe.supabase.co/rest/v1/series?select=id,title,slug,cover_url,is_r18,created_at,chapters!inner(published_at,created_at)&chapters.pages_ready=eq.true&chapters.order=published_at.desc.nullslast&chapters.limit=1",
    "headers": {
     "apikey": "sb_publishable__ow-g4H00jio3RK5qQaJuA_87iakWRc",
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "items": "$",
   "has_next": {
    "const": false
   },
   "sort": {
    "path": "chapters.0.published_at",
    "order": "desc",
    "limit": 1000
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/manga/{value}#{f.id}"
    },
    "title": "title",
    "cover": "cover_url"
   }
  },
  "search": {
   "request": {
    "url": "https://xqjjktixlttbqbsdpaxe.supabase.co/rest/v1/series?select=id,title,slug,cover_url,is_r18,created_at,chapters!inner(published_at,created_at)&chapters.pages_ready=eq.true&chapters.order=published_at.desc.nullslast&chapters.limit=1&title=ilike.*{query}*",
    "headers": {
     "apikey": "sb_publishable__ow-g4H00jio3RK5qQaJuA_87iakWRc",
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "items": "$",
   "has_next": {
    "const": false
   },
   "sort": {
    "path": "chapters.0.published_at",
    "order": "desc",
    "limit": 1000
   },
   "fields": {
    "url": {
     "path": "slug",
     "template": "/manga/{value}#{f.id}"
    },
    "title": "title",
    "cover": "cover_url"
   }
  },
  "details": {
   "request": {
    "url": "https://xqjjktixlttbqbsdpaxe.supabase.co/rest/v1/series?select=id,title,slug,cover_url,description,status,is_r18,alt_titles,authors,series_genres(genres(name)),chapters(id,chapter_number,volume_number,title,published_at,created_at)&id=eq.{u.id}&chapters.pages_ready=eq.true&chapters.order=chapter_number.desc",
    "headers": {
     "apikey": "sb_publishable__ow-g4H00jio3RK5qQaJuA_87iakWRc",
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "url_vars": {
    "id": "#([^#]+)$",
    "slug": "/manga/([^/?#]+)"
   },
   "let": {
    "desc": "0.description",
    "alt": {
     "path": "0.alt_titles.*",
     "all": true,
     "join": "\n- "
    }
   },
   "fields": {
    "title": "0.title",
    "cover": "0.cover_url",
    "author": {
     "path": "0.authors.*.?role=author.name",
     "all": true,
     "join": ", "
    },
    "artist": {
     "path": "0.authors.*.?role=artist.name",
     "all": true,
     "join": ", "
    },
    "genres": {
     "path": "0.series_genres.*.genres.name",
     "all": true,
     "join": ", "
    },
    "status": "0.status",
    "description": {
     "const": "[[{l.desc}]][[\n\nAlternative titles:\n- {l.alt}]]",
     "replace": [
      [
       "^\\s+|\\s+$",
       ""
      ]
     ]
    }
   },
   "status_map": {
    "ongoing": 1,
    "completed": 2,
    "oneshot": 2,
    "hiatus": 6,
    "dropped": 5
   }
  },
  "chapters": {
   "request": "details",
   "format": "json",
   "items": "0.chapters",
   "fields": {
    "url": {
     "path": "chapter_number",
     "regex": "^(\\d+(?:\\.\\d*[1-9])?)",
     "group": 1,
     "template": "/read/{u.slug}/{value}#{f.id}"
    },
    "name": {
     "const": "[[Vol. {f.volume_number} ]]Ch. {f.chapter_number}[[: {f.title}]]",
     "replace": [
      [
       "(\\d)\\.0(?=\\D|$)",
       "$1"
      ]
     ]
    },
    "number": "chapter_number",
    "date": [
     "published_at",
     "created_at"
    ]
   },
   "date_format": "iso"
  },
  "pages": {
   "request": {
    "url": "https://xqjjktixlttbqbsdpaxe.supabase.co/rest/v1/chapters?select=series(is_r18),chapter_pages(object_key)&id=eq.{u.cid}&chapter_pages.order=page_number.asc",
    "headers": {
     "apikey": "sb_publishable__ow-g4H00jio3RK5qQaJuA_87iakWRc",
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "format": "json",
   "url_vars": {
    "cid": "#([^#]+)$"
   },
   "let": {
    "r18": {
     "path": "0.series.is_r18",
     "replace": [
      [
       "^true$",
       "-r18"
      ],
      [
       "^false$",
       ""
      ]
     ]
    }
   },
   "items": "0.chapter_pages",
   "image": {
    "path": "object_key",
    "template": "https://img[[{l.r18}]].schalescans.com/{value}"
   }
  }
 },
 "hinweise": [
  "Supabase-REST-API (xqjjktixlttbqbsdpaxe.supabase.co) mit dem öffentlichen 'sb_publishable_'-Schlüssel als apikey, den Website und Community mitliefern (kein Geheimnis, keine Signatur; vgl. ar.despairmanga).",
  "Beliebt = alle Serien (eine Seite), absteigend nach letztem Kapitel (sort auf chapters.0.published_at; Community fällt bei fehlendem published_at auf created_at zurück). Serien ohne lesbare Kapitel werden serverseitig über chapters!inner ausgefiltert (Community filtert lokal). Suche title=ilike.*…*. 18+-Inhalte wie Community-Standard eingeschlossen; Filter nicht übernommen.",
  "Manga-URL /manga/<slug>#<id>, Kapitel-URL /read/<slug>/<nr>#<kapitel-id> (Community speichert IDs + memo). R18-Serien liegen auf r18.schalescans.com – die Web-URL zeigt dann auf die Hauptdomain; die API-Abrufe sind davon unabhängig.",
  "Bild-Host img.schalescans.com bzw. img-r18.schalescans.com je nach series.is_r18 (let + replace). Beschreibung ohne Link-Liste (MangaDex/AniList/MAL/Shops)."
 ]
}
