{
 "rezept": "kaanon-rezept/1",
 "status": "entwurf",
 "extension": {
  "name": "Jmanga",
  "sprache": "ja",
  "base_url": "https://jmanga.cool",
  "nsfw": false,
  "paket": "eu.kanade.tachiyomi.extension.ja.kaanon.jmanga",
  "quellen": [
   {
    "name": "Jmanga",
    "sprache": "ja",
    "quell_id": 6141590427749684419,
    "home": "https://jmanga.cool"
   }
  ]
 },
 "quelle": {
  "modul": "src/ja/jmanga",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.14",
  "theme": "mangareader"
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/filter/?sort=most-viewed&p={page}",
   "items": ".manga_list-sbs .manga-poster",
   "has_next": {
    "exists": "ul.pagination > li.active + li"
   },
   "fields": {
    "url": "@href",
    "title": "img@alt",
    "cover": "img@img"
   }
  },
  "latest": {
   "request": "{base}/filter/?sort=latest-updated&p={page}",
   "items": ".manga_list-sbs .manga-poster",
   "has_next": {
    "exists": "ul.pagination > li.active + li"
   },
   "fields": {
    "url": "@href",
    "title": "img@alt",
    "cover": "img@img"
   }
  },
  "search": {
   "request": "{base}/?q={query}&p={page}",
   "items": ".manga_list-sbs .manga-poster",
   "has_next": {
    "exists": "ul.pagination > li.active + li"
   },
   "fields": {
    "url": "@href",
    "title": "img@alt",
    "cover": "img@img"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": "#ani_detail .manga-name@ownText",
    "cover": "#ani_detail img@img",
    "description": "#ani_detail .description@ownText",
    "genres": {
     "path": "#ani_detail .genres > a@ownText",
     "all": true,
     "join": ", "
    },
    "author": {
     "path": "#ani_detail .anisc-info > .item:has(.item-head:contains(著者:)) a",
     "all": true,
     "join": ", "
    },
    "status": "#ani_detail .anisc-info > .item:has(.item-head:contains(地位:)) .name"
   },
   "status_map": {
    "ongoing": 1,
    "publishing": 1,
    "releasing": 1,
    "completed": 2,
    "finished": 2,
    "on-hold": 6,
    "on_hiatus": 6,
    "canceled": 5,
    "discontinued": 5
   }
  },
  "chapters": {
   "request": "details",
   "items": "#ja-chaps > li.chapter-item",
   "fields": {
    "url": {
     "path": "a@href",
     "template": "{value}#{f.@data-id}"
    },
    "name": [
     "a .name",
     "a"
    ]
   }
  },
  "pages": {
   "request": {
    "url": "{base}/json/chapter?mode=vertical&id={u.cid}",
    "headers": {
     "Accept": "application/json, text/javascript, */*; q=0.01",
     "X-Requested-With": "XMLHttpRequest"
    }
   },
   "url_vars": {
    "cid": "#([^#]+)$"
   },
   "format": "json_html",
   "html_path": "html",
   "items": ".container-reader-chapter > div > img",
   "image": [
    "@data-lazy-src",
    "@data-src",
    "@data-url",
    "@img"
   ]
  }
 },
 "hinweise": [
  "MangaReader-Theme mit Jmanga-Overrides: Seitenparameter 'p', Suche '/?q=…' (ohne Pfadsegment), Kapitelliste '#ja-chaps', Bilder über /json/chapter?mode=vertical&id=<Kapitel-ID>.",
  "Beliebt/Neueste wie im Theme über /filter/?sort=most-viewed bzw. latest-updated.",
  "Kapitel-URL trägt wie in der Community die Kapitel-ID als '#<data-id>' (Platzhalter {f.@data-id} wie Vorlage mit {f.@data-chapter-number}). Fehlt die ID, holt die Community sie aus div[data-reading-id] – nicht nachgebildet.",
  "Ajax-Referer setzt die Community auf die URL-kodierte Kapitel-URL, Bild-Referer auf die Bild-URL selbst – beides nicht ausdrückbar/weggelassen.",
  "Autor: alle Links unter '著者:'; Trennung Autor/Künstler über '(Art)' nach dem Link nicht nachgebildet. Alternative Titel nicht in der Beschreibung."
 ]
}
