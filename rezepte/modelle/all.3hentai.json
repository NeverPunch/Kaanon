 "quelle": {
  "modul": "src/all/hentai3",
  "community_stand": "efa93f5a 2026-11-02",
  "community_version": "1.6.7",
  "theme": null
 },
 "modell": {
  "schema": "kaanon-site-model/2",
  "popular": {
   "request": "{base}/search?q=pages%3A>0&page={page}&sort=popular",
   "items": "a[href*=/d/]",
   "has_next": {
    "exists": "a[rel=next]"
   },
   "fields": {
    "url": "@href",
    "title": {
     "path": "div.title@ownText",
     "replace": [
      [
       "(\\[[^]]*]|[({][^)}]*[)}])",
       ""
      ],
      [
       "^\\s+|\\s+$",
       ""
      ]
     ]
    },
    "cover": "img:not([class])@src"
   }
  },
  "latest": {
   "request": "{base}/search?q=pages%3A>0&page={page}",
   "items": "a[href*=/d/]",
   "has_next": {
    "exists": "a[rel=next]"
   },
   "fields": {
    "url": "@href",
    "title": {
     "path": "div.title@ownText",
     "replace": [
      [
       "(\\[[^]]*]|[({][^)}]*[)}])",
       ""
      ],
      [
       "^\\s+|\\s+$",
       ""
      ]
     ]
    },
    "cover": "img:not([class])@src"
   }
  },
  "search": {
   "request": "{base}/search?q={query}&page={page}",
   "items": "a[href*=/d/]",
   "has_next": {
    "exists": "a[rel=next]"
   },
   "fields": {
    "url": "@href",
    "title": {
     "path": "div.title@ownText",
     "replace": [
      [
       "(\\[[^]]*]|[({][^)}]*[)}])",
       ""
      ],
      [
       "^\\s+|\\s+$",
       ""
      ]
     ]
    },
    "cover": "img:not([class])@src"
   }
  },
  "details": {
   "request": "{abs_url}",
   "fields": {
    "title": {
     "path": "h1",
     "replace": [
      [
       "(\\[[^]]*]|[({][^)}]*[)}])",
       ""
      ],
      [
       "^\\s+|\\s+$",
       ""
      ]
     ]
    },
    "cover": "img@img",
    "author": [
     {
      "path": "a[href*=/groups/]",
      "all": true,
      "join": ", "
     },
     {
      "path": "a[href*=/artists/]",
      "all": true,
      "join": ", "
     }
    ],
    "artist": [
     {
      "path": "a[href*=/artists/]",
      "all": true,
      "join": ", "
     },
     {
      "path": "a[href*=/groups/]",
      "all": true,
      "join": ", "
     }
    ],
    "genres": {
     "path": "a[href*=/tags/]",
     "all": true,
     "join": ", "
    },
    "description": "div.tag-container:contains(pages:)",
    "status": {
     "const": "completed"
    }
   },
   "status_map": {
    "completed": 2
   }
  },
  "chapters": {
   "request": "details",
   "items": "html",
   "fields": {
    "url": {
     "const": "{url}"
    },
    "name": {
     "const": "Chapter"
    },
    "date": "time@datetime"
   },
   "date_format": "iso"
  },
  "pages": {
   "request": "{abs_url}",
   "items": "img:not([class], [src*=thumb], [src*=cover])",
   "image": {
    "path": "@src",
    "replace": [
     [
      "t(?=\\.[a-zA-Z]+$)",
      ""
     ]
    ]
   }
  }
 },
 "hinweise": [
  "27 Community-Sprachquellen unterscheiden sich nur im Sprachpfad/-filter; ein Modell, das der all-Quelle folgt (Suche q=pages:>0).",
  "Titel ohne [..]/(..)/{..}-Teile wie Standard-Einstellung 'Display full title' = aus.",
  "Beschreibung nur Seitenzahl-Zeile (Code hängt Figuren, Serien, Gruppen, Sprachen an); Tags ohne ♀/♂-Umformung. Ein Kapitel 'Chapter' mit Datum aus <time datetime>.",
  "Bild-URL: Vorschau-Suffix 't' vor der Dateiendung entfernt (Code: Regex t(?=\\.) – hier auf die letzte Endung begrenzt)."
 ]
}